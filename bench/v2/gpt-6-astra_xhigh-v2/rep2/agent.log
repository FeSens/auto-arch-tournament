`make formal-deep` — same checks without ALTOPS. SLOW (~hours per\n#      M-ext check) but proves real arithmetic. Run periodically, not in\n#      the per-iteration orchestrator loop.\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\n# A vacuous suite (nothing ever retires) would fail this — no symbolic\n# trace can make rvfi_valid && !rvfi_trap go true.\nal\n…[10189 of 13261 chars elided by tools/bench/transcript.py; sha256:7183e6364b58b020]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
