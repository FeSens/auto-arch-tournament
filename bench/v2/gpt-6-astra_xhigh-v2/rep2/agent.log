{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path(Path('cores/bench/experiments/.r9s0-backup-path').read_text())\nrtl=Path('cores/bench/rtl')\nfor name in ['core_pkg.sv','mem_stage.sv','wb_stage.sv']:\n (rtl/name).write_bytes((p/name).read_bytes())\n(p/'alu.sv').write_bytes((rtl/'alu.sv').read_bytes())\ns=(rtl/'alu.sv').read_text()\na=s.index('  // 64-bit products')\nb=s.index('    case (op)',a)\ns=s[:a]+'''  // A signed 33-bit representation covers both signed and unsigned RV32\n  // operands. Low-product bits are independent of the extension signs.\n  logic signed [32:0] mul_a, mul_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] mul_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    shamt = b[4:0];\n    mul_a = \"'$signed({((op == ALU_MULH || op == ALU_MULHSU) && a[31]), a});\n    mul_b = $signed({((op == ALU_MULH) && b[31]), b});\n    mul_product = mul_a * mul_b;\n\n'\"'''+s[b:]\ns=s.replace('mul_uu[31:0]','mul_product[31:0]').replace('\"'$unsigned(mul_ss[63:32])'\"','\"'$unsigned(mul_product[63:32])'\"').replace('mul_uu[63:32]','\"'$unsigned(mul_product[63:32])'\"').replace('\"'$unsigned(mul_su[63:32])'\"','\"'$unsigned(mul_product[63:32])'\"')\n(rtl/'alu.sv').write_text(s)\nprint('Only shared combinational multiplier prototype active')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
