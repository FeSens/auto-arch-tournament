{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/predictor_probe')\nfor name in ['local','persistent','gray']:\n d=base/name/'rtl'; d.mkdir(parents=True,exist_ok=True)\n for f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,d/f.name)\n p=d/'if_stage.sv';s=p.read_text();a=s.index('  // Nonblocking writes');b=s.index('\\\\n  always_comb begin',a)\n if name=='persistent':\n  s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      for (int i = 0; i < 64; i++) counters[i] <= 2\\\\'b10;\\\\n    end else if (train_valid) begin', '  initial begin\\\\n    for (int i = 0; i < 64; i++) counters[i] = 2\\\\'b10;\\\\n  end\\\\n  always_ff @(posedge clock) begin\\\\n    if (\"'!reset && train_valid) begin'\"')\n elif name=='local':\n  s=s[:a]+'''  for (genvar i = 0; i < 64; i++) begin : bht_entry\n    always_ff @(posedge clock) begin\n      if (reset) counters[i] <= 2'b10;\n      else if (train_valid && train_index == 6'(i)) begin\n        counters[i][1] <= train_taken ? (counters[i][1] | counters[i][0])\n                                      : (counters[i][1] & counters[i][0]);\n        counters[i][0] <= train_taken ? (counters[i][1] | \"'!counters[i][0])\n                                      : (counters[i][1] & !counters[i][0]);\n      end\n    end\n  end\n'\"''' + s[b:]\n else:\n  s=s[:a]+'''  // Gray-coded states: 00 SNT, 01 WNT, 11 WT, 10 ST.\n  for (genvar i = 0; i < 64; i++) begin : bht_entry\n    always_ff @(posedge clock) begin\n      if (reset) counters[i] <= 2'b11;\n      else if (train_valid && train_index == 6'(i)) begin\n        counters[i][1] <= counters[i][0] ? train_taken : counters[i][1];\n        counters[i][0] <= train_taken \"'^ counters[i][1];\n      end\n    end\n  end\n'\"''' + s[b:]\n p.write_text(s)\nprint('Prepared predictor-only probe copies')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
