{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef divmod_radix4(a, d):\n    q = r = 0\n    multiples = (0, d, 2*d, 3*d)\n    for k in range(1, 17):\n        width = 2*k\n        mask = (1 << width) - 1\n        t = (r << 2) | ((a >> (32-width)) & 3)\n        assert t <= mask\n        digit, selected = 0, t\n        for candidate in (3, 2, 1):\n            multiple = multiples[candidate]\n            diff = (t - (multiple & mask)) & ((1 << (width+1))-1)\n            if multiple >> width == 0 and diff >> width == 0:\n                digit, selected = candidate, diff & mask\n                break\n        q = (q << 2) | digit\n        r = selected\n        assert r <= (a >> (32-width))\n        assert d == 0 or r < d\n    return q, r\n\ndef signed(v):\n    return v - (1 << 32) if v & (1 << 31) else v\n\nedges = {0, 1, 2, 3, 4, 7, 0x7fffffff, 0x80000000, 0x80000001, MASK}\nfor bit in range(32):\n    for offset in (-1, 0, 1):\n        edges.add(((1 << bit) + offset) & MASK)\npairs = [(a, b) for a in edges for b in edges]\nrng = random.Random(20261001)\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000))\nfor a, b in pairs:\n    uq, ur = divmod_radix4(a, b)\n    expected_unsigned = divmod(a, b) if b else (MASK, a)\n    assert (uq, ur) == expected_unsigned, (a, b, uq, ur)\n    sa, sb = signed(a), signed(b)\n    q, r = divmod_radix4(abs(sa), abs(sb))\n    if b == 0:\n        q, r = MASK, a\n    else:\n        q = (-q if (sa < 0) \"'!= (sb < 0) else q) & MASK\n        r = (-r if sa < 0 else r) & MASK\n    if not b:\n        eq, er = MASK, a\n    else:\n        eq = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            eq = -eq\n        er = sa - eq * sb\n        eq, er = eq & MASK, er & MASK\n    assert (q, r) == (eq, er), (a, b, q, r, eq, er)\nprint(f'\"'Arithmetic model passed {len(pairs)} operand pairs for all four DIV/REM results, including every prefix-width bound.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
