nch/generated/timing/gowin_p0/impl/pnr/core_bench.tr\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr.html\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.binx\ncores/bench/generated/timing/gowin_p0/impl/pnr/cmd.do\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.power.html\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.rpt.html\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.log\ncores/bench/ge\n…[13643 of 16715 chars elided by tools/bench/transcript.py; sha256:b2dd3a69b532f418]…\n def _run(dut, program, dmem_init=None, max_cycles=200,\n               stall_fn=None, stores=None, abort_after=None,\n               invalid_word_fn=None, observe=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = (dict(program) if isinstance(program, dict) else\n            {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)})\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n", "exit_code": 0, "status": "completed"}}
