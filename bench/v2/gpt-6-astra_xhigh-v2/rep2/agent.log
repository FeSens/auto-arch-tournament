{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess\nroot=Path('cores/bench/rtl')\nfor name in ('if_stage.sv','core_pkg.sv','id_stage.sv','ex_stage.sv','core.sv'):\n s=subprocess.check_output(['git','show',f'HEAD:cores/bench/rtl/{name}'],text=True)\n if name=='if_stage.sv':\n  s=s.replace('  logic [1:0] counters [0:63];','  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:63];')\n  s=s.replace('  input  logic              train_taken,','  input  logic [1:0]        train_counter_new,')\n  a=s.index('  always_ff @(posedge clock) begin'); b=s.index('\\\\n  always_comb begin',a)\n  s=s[:a]+'''  initial begin\n    for (int i = 0; i < 64; i++) counters[i] = 2'b10;\n  end\n  always_ff @(posedge clock) begin\n    if (\"'!reset && train_valid) counters[train_index] <= train_counter_new;\n  end\n'\"''' + s[b:]\n  s=s.replace('    out.pc    = pc;', '''    out.counter_sample = train_valid && train_index == pc[7:2]\n                       ? train_counter_new : counters[pc[7:2]];\n    out.pc    = pc;''')\n elif name=='core_pkg.sv':\n  s=s.replace('    logic [31:0] instr;\\\\n    logic        predicted_taken;', '    logic [1:0]  counter_sample;\\\\n    logic [31:0] instr;\\\\n    logic        predicted_taken;')\n elif name=='id_stage.sv':\n  s=s.replace('      reg_q.pc       <= in.pc;','      reg_q.counter_sample <= in.counter_sample;\\\\n      reg_q.pc       <= in.pc;')\n elif name=='ex_stage.sv':\n  s=s.replace('  output logic               train_taken','  output logic [1:0]         train_counter_new')\n  s=s.replace('  assign train_taken = branch_cond;', '''  always_comb begin\n    if (branch_cond)\n      train_counter_new = in.counter_sample == 2'b11 ? 2'b11 : in.counter_sample + 2'b01;\n    else\n      train_counter_new = in.counter_sample == 2'b00 ? 2'b00 : in.counter_sample - 2'b01;\n  end''')\n elif name=='core.sv':\n  s=s.replace('logic        train_valid, train_taken;','logic        train_valid;\\\\n  logic [1:0]  train_counter_new;')\n  s=s.replace('.train_taken     (train_taken)', '.train_counter_new (train_counter_new)')\n (root/name).write_text(s)\nPY\nmake lint TARGET=bench\npython3 -m tools.eval.gowin bench --all-options > /srv/hwebench/tmp/9e6b10b9/9b62f6a5/r7s2-snapshot-timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
