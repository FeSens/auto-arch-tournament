{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/generated/predictor_probe8nofifo/rtl');dst=Path('cores/bench/generated/predictor_parallel/rtl');dst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'):shutil.copy2(p,dst/p.name)\np=dst/'ex_stage.sv';s=p.read_text()\na=s.index('  logic [3:0] branch_eq_chunk, branch_lt_chunk;');b=s.index('  assign branch_mismatch =',a)\ns=s[:a]+'''  function automatic logic predicate_base(\n    input logic [31:0] a, b,\n    input logic [2:0] op\n  );\n    logic [3:0] eq_leaf, lt_leaf;\n    logic [31:0] aa, bb;\n    logic eq_hi, eq_lo, lt_hi, lt_lo;\n    begin\n      aa = {a[31] \"'^ !op[1], a[30:0]};\n      bb = {b[31] ''^ !op[1], b[30:0]};\n      for (int k = 0; k < 4; k++) begin\n        eq_leaf[k] = a[8*k +: 8] == b[8*k +: 8];\n        lt_leaf[k] = aa[8*k +: 8] < bb[8*k +: 8];\n      end\n      eq_hi = eq_leaf[3] && eq_leaf[2];\n      eq_lo = eq_leaf[1] && eq_leaf[0];\n      lt_hi = lt_leaf[3] || (eq_leaf[3] && lt_leaf[2]);\n      lt_lo = lt_leaf[1] || (eq_leaf[1] && lt_leaf[0]);\n      predicate_base = op[2] ? (lt_hi || (eq_hi && lt_lo)) : (eq_hi && eq_lo);\n    end\n  endfunction\n  logic branch_base, branch_mismatch, branch_eligible;\n  logic [31:0] branch_src_a [0:2], branch_src_b [0:2];\n  logic [8:0] branch_candidate;\n  logic [2:0] branch_row;\n  assign branch_src_a[0] = in.rs1_val;\n  assign branch_src_a[1] = fwd_ex_mem;\n  assign branch_src_a[2] = fwd_mem_wb;\n  assign branch_src_b[0] = in.rs2_val;\n  assign branch_src_b[1] = fwd_ex_mem;\n  assign branch_src_b[2] = fwd_mem_wb;\n  for (genvar x = 0; x < 3; x++) begin : branch_rows\n    for (genvar y = 0; y < 3; y++) begin : branch_columns\n      assign branch_candidate[x*3+y] = predicate_base(branch_src_a[x],branch_src_b[y],in.ctrl.branch_op);\n    end\n    assign branch_row[x] = fwd_rs2_sel == 2'\"'d1 ? branch_candidate[x*3+1]\n                         : fwd_rs2_sel == 2'd2 ? branch_candidate[x*3+2]\n                         : branch_candidate[x*3];\n  end\n  assign branch_base = fwd_rs1_sel == 2'd1 ? branch_row[1]\n                     : fwd_rs1_sel == 2'd2 ? branch_row[2] : branch_row[0];\n'''+s[b:]\ns=s.replace('branch_cond = branch_equal;', 'branch_cond = branch_base;').replace('branch_cond = \"'!branch_equal;'\"', 'branch_cond = \"'!branch_base;'\"').replace('branch_cond = branch_slt;', 'branch_cond = branch_base;').replace('branch_cond = \"'!branch_slt;'\"', 'branch_cond = \"'!branch_base;'\"').replace('branch_cond = branch_ult;', 'branch_cond = branch_base;').replace('branch_cond = \"'!branch_ult;'\"', 'branch_cond = \"'!branch_base;'\"')\np.write_text(s)\nPY\npython - <<'PY' > cores/bench/experiments/parallel_probe_timing.log 2>&1\nfrom tools.eval.gowin import build_all,summarize\nimport json\nr=build_all('.', 'cores/bench/generated/predictor_parallel/rtl','fpga/core_bench_si.sv','cores/bench/generated/predictor_parallel/timing')\nprint(json.dumps(r,indent=2));print(json.dumps(summarize(r),indent=2))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
