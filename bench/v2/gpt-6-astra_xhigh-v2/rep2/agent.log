{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"mkdir -p cores/bench/generated/r15probe; python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r15probe')\nfor variant in ['base','coarse']:\n dest=root/variant/'rtl'\n shutil.copytree('cores/bench/rtl',dest,dirs_exist_ok=True)\np=root/'coarse/rtl/alu.sv'\ns=p.read_text()\nblock='''\n  logic [7:0] coarse_enable;\n  logic shift_fill;\n  logic [31:0] left_tree [1:15], right_tree [1:15];\n  logic [31:0] left_one, right_one, left_result, right_result;\n  assign shift_fill = (op == ALU_SRA) && a[31];\n  for (genvar k = 0; k < 8; k++) begin : coarse_shift\n    assign coarse_enable[k] = (b[4:2] == 3'(k));\n    assign left_tree[8+k] = {32{coarse_enable[k]}} & (a << (4*k));\n    if (k == 0) begin : zero_shift\n      assign right_tree[8+k] = {32{coarse_enable[k]}} & a;\n    end else begin : nonzero_shift\n      assign right_tree[8+k] = {32{coarse_enable[k]}} & {{(4*k){shift_fill}}, a[31:4*k]};\n    end\n  end\n  for (genvar k = 1; k < 8; k++) begin : shift_reduce\n    assign left_tree[k] = left_tree[2*k] | left_tree[2*k+1];\n    assign right_tree[k] = right_tree[2*k] | right_tree[2*k+1];\n  end\n  assign left_one = b[0] ? {left_tree[1][30:0],1'b0} : left_tree[1];\n  assign left_result = b[1] ? {left_one[29:0],2'b0} : left_one;\n  assign right_one = b[0] ? {shift_fill,right_tree[1][31:1]} : right_tree[1];\n  assign right_result = b[1] ? {{2{shift_fill}},right_one[31:2]} : right_one;\n'''\ns=s.replace('  logic        [4:0]  shamt;','')\ns=s.replace('  always_comb begin\\\\n    shamt = b[4:0];',block+'\\\\n  always_comb begin')\ns=s.replace('out = a << shamt;','out = left_result;').replace('out = a >> shamt;','out = right_result;').replace('out = \"'$unsigned($signed(a) >>> shamt);'\"','out = right_result;')\np.write_text(s)\nPY\npython - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nimport json\nroot=Path.cwd(); dest=root/'cores/bench/generated/r15probe'\ndef run(v):\n r=build(root,dest/v/'rtl','fpga/core_bench_si.sv',1,dest/v/'p1')\n (dest/v/'result.json').write_text(json.dumps(r,indent=2))\n print(v,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as ex:\n list(ex.map(run,['base','coarse']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
