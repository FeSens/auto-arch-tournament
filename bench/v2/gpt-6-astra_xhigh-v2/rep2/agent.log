{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hyp_probe')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'alu.sv'\ns=p.read_text()\na=s.index('  // 64-bit products,')\nb=s.index('    case (op)',a)\ns=s[:a]+'''  // One signedness-selectable product; all four RV32M multiply modes.\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  logic signed [32:0] mul_a, mul_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] mul_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign mul_a = $signed({((op == ALU_MULH || op == ALU_MULHSU) && a[31]), a});\n  assign mul_b = $signed({((op == ALU_MULH) && b[31]), b});\n  assign mul_product = mul_a * mul_b;\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n'\"'''+s[b:]\ns=s.replace('mul_uu[31:0]', 'mul_product[31:0]').replace('\"'$unsigned(mul_ss[63:32])'\"','\"'$unsigned(mul_product[63:32])'\"').replace('mul_uu[63:32]','\"'$unsigned(mul_product[63:32])'\"').replace('\"'$unsigned(mul_su[63:32])'\"','\"'$unsigned(mul_product[63:32])'\"')\np.write_text(s)\nprint('Created isolated multiplier prototype:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
