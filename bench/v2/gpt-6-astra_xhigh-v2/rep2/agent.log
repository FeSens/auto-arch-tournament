\"if_id_w\") >> 2) & 0xFFFFFFFF == word\n        assert val(\"if_id_w\") & 1 == ir\n        branch = word & 0x7F == 0x63 and (word >> 12) & 7 not in (2, 3)\n        target = self.target(pc, word)\n        prediction = int(not target & 3 and\n                         (word & 0x7F == 0x6F or\n            \n…[4131 of 7203 chars elided by tools/bench/transcript.py; sha256:852f272baae8870f]…\n   0x700: JAL(10, 0x10000),\n        0x10700: BEQ(0, 0, 8),\n        0x10704: SW(10, 0, 0x1FC),\n        0x10708: EBREAK(),\n    }\n    pcs = [0, 256, 260, 512, 516, 768, 1024, 800, 804, 0x700, 0x10700, 0x10708]\n    for seed in range(5):\n        rng = random.Random(0xB170 + seed)\n        check = _PredictionChecks(dut)\n        def stalls(cycle, ia, da, wen):\n            return (int(rng.random() >= .22), int(rng.random() >= .22))\n        writes = []\n        rets, memory = await _run(dut, program, max_cycles=250,\n                                  stall_fn=stalls if seed else None,\n                                  observe=check, stores=writes)\n        _check_trace(rets, program, pcs)\n        assert check.training == [(0, 1), (256, 0), (512, 0), (768, 1), (0x10700, 1)]\n        assert not memory and not writes\n        assert not check.memory_requests and not check.divide_requests\n        for pc, rd, link in ((260, 5, 264), (516, 6, 520), (1024, 7, 1028),\n                             (804, 9, 808), (0x700, 10, 0x704)):\n", "exit_code": 0, "status": "completed"}}
