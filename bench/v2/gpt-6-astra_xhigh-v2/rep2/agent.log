{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport yaml,json,jsonschema\nfrom pathlib import Path\np=Path('cores/bench/experiments/hypotheses/hyp-20261002-003-r9s2.yaml'); jsonschema.validate(yaml.safe_load(p.read_text()),json.loads(Path('schemas/hypothesis.schema.json').read_text()));print('Hypothesis schema valid')\n# Gray encoding agrees with every abstract two-bit saturation transition.\ngray=[0b00,0b01,0b11,0b10]\nfor s,g in enumerate(gray):\n for t in (0,1):\n  d,w=g>>1,g&1;n=((t if w else d)<<1)|(t\"'^d)\n  exp=min(s+1,3) if t else max(s-1,0)\n  assert n==gray[exp],(s,t,n,exp)\nprint('\"'All 8 Gray counter transitions match saturation')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
