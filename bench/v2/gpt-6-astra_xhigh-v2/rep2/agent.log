{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom tools.eval.fpga import COREMARK_SIM_FLAGS, parse_iterations, validate_coremark_uart\nfrom tools.eval.gowin import parse_reports, summarize\nroot = Path.cwd()\nproc = subprocess.run([str(root / 'cores/bench/obj_dir/cosim_sim'), str(root / 'bench/programs/coremark.elf'), '50000000', *COREMARK_SIM_FLAGS], capture_output=True, text=True, timeout=600)\n(root / 'cores/bench/generated/coremark.jsonl').write_text(proc.stdout)\nassert proc.returncode == 0, (proc.returncode, proc.stderr)\nmarker = json.loads(proc.stdout.splitlines()[-1])\niterations = parse_iterations(str(root))\nassert marker['ebreak'] and not marker['oob']\nassert marker['bench_bracketed']\nassert 'Correct operation validated.' in marker['uart']\nvalid, reason = validate_coremark_uart(marker['uart'], iterations)\nassert valid, reason\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert cycles > 0\nresults = [dict(place_option=p, **parse_reports(root / f'cores/bench/generated/timing/gowin_p{p}')) for p in range(3)]\nsummary = summarize(results)\nassert not summary['placement_failed'], summary\nsummary.update(cycles=cycles, iterations=iterations, fitness=summary['fmax_mhz'] * 1e6 * iterations / cycles)\nsummary['passes_fitness_threshold'] = summary['fitness'] > 94.27598\n(root / 'cores/bench/generated/measurement.json').write_text(json.dumps(summary, indent=2) + '\\\\n')\nprint(json.dumps(summary, indent=2))\nprint(marker['uart'])\nprint('Markers:', marker['bench_start_cycle'], marker['bench_stop_cycle'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
