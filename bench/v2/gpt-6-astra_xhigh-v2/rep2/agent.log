{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nroot=Path('/srv/hwebench/tmp/9e6b10b9/f53f45f0/r6s2-prototype')\nfor filename in ['core_pkg.sv','if_stage.sv','id_stage.sv']:\n p=Path('cores/bench/rtl')/filename\n (root/('precomputed.'+filename)).write_text(p.read_text())\n p.write_text((root/(filename+'.original')).read_text())\np=Path('cores/bench/rtl/ex_stage.sv')\n(root/'precomputed.ex_stage.sv').write_text(p.read_text())\np.write_text((root/'ex_stage.original.sv').read_text())\np=Path('cores/bench/rtl/if_stage.sv')\ns=p.read_text()\na=s.index('  // Nonblocking writes')\nb=s.index('\\\\n  always_comb begin',a)\ns=s[:a]+'''  // Decode only the write address globally; each entry updates locally.\n  // Lookup still observes pre-edge state when read and write collide.\n  for (genvar row = 0; row < 64; row++) begin : predictor_row\n    always_ff @(posedge clock) begin\n      if (reset) counters[row] <= 2'b10;\n      else if (train_valid && train_index == 6'(row)) begin\n        if (train_taken) begin\n          if (counters[row] \"'!= 2'\"'b11)\n            counters[row] <= counters[row] + 2'b01;\n        end else begin\n          if (counters[row] \"'!= 2'\"'b00)\n            counters[row] <= counters[row] - 2'b01;\n        end\n      end\n    end\n  end\n''' + s[b:]\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
