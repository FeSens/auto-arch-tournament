2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  end\n\nendmodule\n{'completed': True, 'iter_per_cycle': 2.514257094856383e-06, 'cycles': 3977318, 'iterations': 10, 'bracketed_cycles': True}\nSBY  0:51:35 [insn_beq_ch0] engine_0: finished (returncode=0)\nSBY  0:51:35 [insn_beq_ch0] engine_0: Status returned by engine: pass\nSBY  0:51:35 [insn_beq_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:00:54 (54)\nSBY  0:51:35 [insn_beq_ch0] summary: Elapsed process time [H:MM:SS (secs)]","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot=Path('/srv/hwebench/tmp/9e6b10b9/78a8d491')\np=Path('cores/bench/rtl/divider.sv'); (root/'divider-radix8.sv').write_text(p.read_text()); p.write_text((root/'divider-original.sv').read_text())\np=Path('cores/bench/rtl/forward_unit.sv'); (root/'forward-original.sv').write_text(p.read_text())\np.write_text('''// Compare future forwarding addresses before the ID/EX edge.\nmodule forward_unit (\n  input logic clock, reset,\n  input logic stall_id, stall_ex_mem, hold_mem_wb,\n  input logic [4:0] if_id_rs1, if_id_rs2,\n  input logic [4:0] id_ex_rs1, id_ex_rs2, id_ex_rd,\n  input logic [4:0] ex_mem_rd,\n  input logic ex_mem_w_en,\n  input logic [4:0] mem_wb_rd,\n  input logic mem_wb_w_en,\n  output logic [1:0] fwd_rs1, fwd_rs2\n);\n  logic [4:0] next_rs1, next_rs2, next_ex_rd, next_wb_rd;\n  logic ex_rs1_q, ex_rs2_q, wb_rs1_q, wb_rs2_q;\n  assign next_rs1 = stall_id ? id_ex_rs1 : if_id_rs1;\n  assign next_rs2 = stall_id ? id_ex_rs2 : if_id_rs2;\n  assign next_ex_rd = stall_ex_mem ? ex_mem_rd : id_ex_rd;\n  assign next_wb_rd = hold_mem_wb ? mem_wb_rd : ex_mem_rd;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      ex_rs1_q <= 1'b0; ex_rs2_q <= 1'b0;\n      wb_rs1_q <= 1'b0; wb_rs2_q <= 1'b0;\n    end else begin\n      ex_rs1_q <= next_rs1 \"'!= 5'\"'b0 && next_rs1 == next_ex_rd;\n      ex_rs2_q <= next_rs2 \"'!= 5'\"'b0 && next_rs2 == next_ex_rd;\n      wb_rs1_q <= next_rs1 \"'!= 5'\"'b0 && next_rs1 == next_wb_rd;\n      wb_rs2_q <= next_rs2 \"'!= 5'\"'b0 && next_rs2 == next_wb_rd;\n    end\n  end\n  always_comb begin\n    if (ex_rs1_q && ex_mem_w_en) fwd_rs1 = 2'd1;\n    else if (wb_rs1_q && mem_wb_w_en) fwd_rs1 = 2'd2;\n    else fwd_rs1 = 2'd0;\n    if (ex_rs2_q && ex_mem_w_en) fwd_rs2 = 2'd1;\n    else if (wb_rs2_q && mem_wb_w_en) fwd_rs2 = 2'd2;\n    else fwd_rs2 = 2'd0;\n  end\nendmodule\n''')\np=Path('cores/ben