gh\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[14646 of 17718 chars elided by tools/bench/transcript.py; sha256:c9636f4584d11bee]…\n str, sim_bin: str | None = None, env: dict | None = None) -> dict:\n210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n220:                'reason': f'coremark_harness_error: {e}'}\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n257:    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n341:        'ipc_coremark': float,           — iter/cycle\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n", "exit_code": 0, "status": "completed"}}
