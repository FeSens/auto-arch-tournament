{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/probe_mul/test');p.mkdir(exist_ok=True)\n(p/'test_probe_mul.py').write_text('''from test_alu import *\nimport test_alu as base\nfrom cocotb.triggers import Timer\noriginal_setup = base._setup\noriginal_check = base._check\nasync def setup(dut):\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 0\n    await original_setup(dut)\nasync def check(dut, op, a, b, expected):\n    if op not in (base.ALU_MUL, base.ALU_MULH, base.ALU_MULHU, base.ALU_MULHSU):\n        return await original_check(dut, op, a, b, expected)\n    expected = base._expected(op, a, b, expected)\n    dut.op.value = op\n    dut.a.value = a & base.MASK32\n    dut.b.value = b & base.MASK32\n    dut.mul_req_valid.value = 1\n    dut.mul_result_ready.value = 0\n    await Timer(1, \\\"ns\\\")\n    assert int(dut.mul_req_ready.value) == 1\n    await base._tick(dut)\n    dut.mul_req_valid.value = 0\n    dut.a.value = 0x12345678\n    dut.b.value = 0x87654321\n    assert int(dut.mul_result_valid.value) == 0\n    assert int(dut.mul_req_ready.value) == 0\n    await base._tick(dut)\n    assert int(dut.mul_result_valid.value) == 1\n    assert int(dut.out.value) == expected\n    for _ in range(2):\n        await base._tick(dut)\n        assert int(dut.mul_result_valid.value) == 1\n        assert int(dut.out.value) == expected\n    dut.mul_result_ready.value = 1\n    await base._tick(dut)\n    dut.mul_result_ready.value = 0\n    assert int(dut.mul_result_valid.value) == 0\n    assert int(dut.mul_req_ready.value) == 1\nbase._setup = setup\nbase._check = check\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
