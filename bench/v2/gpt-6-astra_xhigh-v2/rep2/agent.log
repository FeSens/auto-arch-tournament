{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nM=(1<<32)-1\nT35=(1<<35)-1\n\ndef radix4(a,d):\n    h=a>>30\n    if d==0: digit,r=3,h\n    elif d==1: digit,r=h,0\n    elif d==2: digit,r=h>>1,h&1\n    elif d==3: digit,r=int(h==3),0 if h==3 else h\n    else: digit,r=0,h\n    q=((a<<2)|digit)&M\n    multiples=(0,d,d<<1,d+(d<<1))\n    assert multiples[3] < 1<<34\n    for cycle in range(5):\n        for stage in range(3):\n            t=(r<<2)|(q>>30)\n            trials=[(t-m)&T35 for m in multiples]\n            digit=next((k for k in (3,2,1) if not (trials[k]>>34)),0)\n            selected=trials[digit] if digit else t\n            assert selected <= M\n            r=selected&M\n            q=((q<<2)|digit)&M\n            if d: assert r < d\n    return q,r\n\ndef s32(x):\n    return x-(1<<32) if x>>31 else x\n\ncases=set()\nvalues=[0,1,2,3,4,5,7,15,16,17,0x3fffffff,0x40000000,0x40000001,0x55555554,0x55555555,0x55555556,0x7fffffff,0x80000000,0x80000001,0xfffffffe,M]\nfor a in values:\n    for b in values: cases.add((a,b))\nfor h in range(4):\n    for d in range(9):\n        for tail in (0,1,0x15555555,0x2aaaaaaa,0x3fffffff): cases.add(((h<<30)|tail,d))\nfor a in range(256):\n    for b in range(256): cases.add((a,b))\nrng=random.Random(0xD144)\nfor _ in range(20000): cases.add((rng.getrandbits(32),rng.getrandbits(32)))\nchecks=0\nfor a,b in cases:\n    for signed in (False,True):\n        aa=s32(a) if signed else a\n        bb=s32(b) if signed else b\n        q,r=radix4(abs(aa),abs(bb))\n        if b==0:\n            q,r=M,a\n            eq,er=M,a\n        else:\n            q=(-q if (aa<0)\"'!=(bb<0) else q)&M\n            r=(-r if aa<0 else r)&M\n            eq=abs(aa)//abs(bb)\n            if (aa<0)!=(bb<0): eq=-eq\n            er=aa-eq*bb\n            eq&=M\n            er&=M\n        assert (q,r)==(eq,er),(hex(a),hex(b),signed,(q,r),(eq,er))\n        checks+=2\nprint(f'\"'PASS: {checks:,} quotient/remainder reference comparisons over {len(cases):,} operand pairs; peeled digit plus five three-digit iterations, explicit 34/35-bit arithmetic.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
