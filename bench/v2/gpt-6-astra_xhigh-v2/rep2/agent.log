{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p /srv/hwebench/tmp/9e6b10b9/b95c43cc/r13probe/rtl; cp cores/bench/rtl/*.sv /srv/hwebench/tmp/9e6b10b9/b95c43cc/r13probe/rtl/; command -v yosys; command -v verilator; sed -n '1,110p' cores/bench/test/conftest.py; sed -n '1,110p' cores/bench/test/test_alu.py\"", "aggregated_output": "/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n\"\"\"Unit tests for rtl/alu.sv.\n\nBase operations remain combinational. Multiply captures operands at edge one\nand transfers at edge two. Division transfers at edge nine. Both hold completion.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport random\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n    RTL, TEST_DIR, SIM_BUILD,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\nALT_CONSTANTS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, real):\n    if ALTOPS and op in ALT_CONSTANTS:\n        value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (value ^ ALT_CONSTANTS[op]) & MASK32\n    return real & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Retain arithmetic references while dispatching blocking multiplies.\"\"\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    expected = _expected(op, a, b, expected)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_mul(dut, op, a, b, expected, hold=0, ready_early=True):\n    expected = _expected(op, a, b, expected)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.mul_req_valid.value = 1\n    dut.mul_result_ready.value = int(ready_early)\n    await Timer(1, \"ns\")\n    assert int(dut.mul_req_ready.value) == 1\n    assert int(dut.mul_result_valid.value) == 0\n    await _tick(dut)  # edge one: capture, no completion accepted yet\n    assert int(dut.mul_req_ready.value) == 0\n    assert int(dut.mul_result_valid.value) == 1, \"multiply added more than one wait\"\n    dut.mul_result_ready.value = 0\n    # Leave an unaccepted request asserted; change signedness AND result half.\n    for cycle in range(hold + 1):\n        dut.op.value = ALU_MULH if op == ALU_MUL else ALU_MUL\n        dut.a.value = (0x80000001 + cycle) & MASK32\n        dut.b.value = (0xFFFFFFFD - cycle) & MASK32\n        await Timer(1, \"ns\")\n        assert int(dut.out.value) == expected, (\n            f\"multiply op={op} a={a:#x} b={b:#x}: \"\n            f\"expected {expected:#x}, got {int(dut.out.value):#x}\"\n        )\n        assert int(dut.div_result_valid.value) == 0\n        if cycle < hold:\n            await _tick(dut)\n            assert int(dut.mul_req_ready.value) == 0\n            assert int(dut.mul_result_valid.value) == 1\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 1\n", "exit_code": 0, "status": "completed"}}
