{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/9e6b10b9/70e838ae/r14_micro')\nd=root/'branch_verify/rtl';shutil.copytree(root/'branch_seed/rtl',d,dirs_exist_ok=True)\np=d/'core_pkg.sv';s=p.read_text().replace('    logic        branch_invert;','    logic        branch_invert;\\\\n    logic        branch_recover_invert;');p.write_text(s)\np=d/'id_stage.sv';s=p.read_text().replace('      reg_q.instr    <= in.instr;', '      reg_q.branch_recover_invert <= in.predicted_taken \"'^ (dec_branch_op == BR_BNE || dec_branch_op == BR_BGE || dec_branch_op == BR_BGEU);'\"\\\\n      reg_q.instr    <= in.instr;');p.write_text(s)\np=d/'ex_stage.sv';s=p.read_text();start=s.index('  assign redirect = ex_accept');end=s.index('  // Only an accepted conditional branch',start)\ns=s[:start]+'''  logic branch_eligible, jump_eligible, conditional_recover, jump_recover;\n  logic control_accept, mismatch;\n  assign control_accept = \"'!reset && in.valid && !stall;\n  assign branch_eligible = !in.ctrl.is_illegal && branch_target[1:0]==2'\"'b00;\n  assign jump_eligible = \"'!in.ctrl.is_illegal && !misalign_jump;\n  assign mismatch = branch_result_tree[1] ''^ in.branch_recover_invert;\n  assign conditional_recover = in.ctrl.is_branch &&\n             ((branch_eligible && mismatch) || (!branch_eligible && in.predicted_taken));\n  assign jump_recover = in.ctrl.is_jump &&\n             (in.ctrl.is_jalr ? jump_eligible : (in.predicted_taken != jump_eligible));\n  assign redirect = control_accept && (conditional_recover || jump_recover);\n  assign redirect_target = in.ctrl.is_jalr ? jump_target :\n                           in.predicted_taken ? (in.pc+32'\"'d4) : branch_target;\n\n'''+s[end:];s=s.replace('assign train_valid = ex_accept && in.ctrl.is_branch', 'assign train_valid = control_accept && in.ctrl.is_branch');s=s.replace('  logic ex_accept, actual_taken, direct_control;','  logic ex_accept;');s=s.replace('''  assign actual_taken = (branch_taken || in.ctrl.is_jump) &&\n                        \"'!in.ctrl.is_illegal && !misalign_fault;\n  assign direct_control = in.ctrl.is_branch ||\n                          (in.ctrl.is_jump && !in.ctrl.is_jalr);\n'\"''','');s=s.replace('  logic ex_accept;\\\\n  assign ex_accept = \"'!reset && in.valid && !stall && !execute_wait;'\"\\\\n','');p.write_text(s)\nshutil.copytree('cores/bench/test',root/'branch_verify/test',dirs_exist_ok=True)\np=root/'branch_verify/test/test_pipeline.py';s=p.read_text().replace('(payload >> 34) & 15','(payload >> 35) & 15');p.write_text(s)\nPY\npython3 -u - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nr=Path('/srv/hwebench/tmp/9e6b10b9/70e838ae/r14_micro/branch_verify')\nx=build(Path.cwd(),r/'rtl','fpga/core_bench_si.sv',1,r/'gowin_p1')\n(r/'timing_p1.json').write_text(json.dumps(x,indent=2));print(json.dumps(x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
