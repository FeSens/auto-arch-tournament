{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/divider.sv'", "aggregated_output": "// Shared blocking RV32M divider. A request captures normalized operands;\n// edge two peels the top two bits and registers 3D, 5D and 7D. Edges three\n// through seven each perform two radix-8 restoring steps, consuming\n// exactly 2 + 5*6 = 32 bits. Edge eight registers sign correction.\n// Completion is held until result_ready (earliest transfer at edge nine),\n// including ALTOPS.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        req_valid,\n  output logic        req_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, ITERATE = 2'd1,\n                         CORRECT = 2'd2, DONE = 2'd3;\n  logic [1:0] state_q;\n  logic [2:0] iteration_q;\n  assign req_ready = (state_q == IDLE);\n  assign result_valid = (state_q == DONE);\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n`else\n  logic signed_op, remainder_op;\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign remainder_op = (op == ALU_REM || op == ALU_REMU);\n  logic [31:0] quotient_q, remainder_q, divisor_q, dividend_q;\n  logic quotient_negative_q, remainder_negative_q, select_remainder_q;\n  logic zero_q, overflow_q;\n  logic [34:0] divisor_three_q, divisor_five_q, divisor_seven_q;\n  logic [34:0] divisor_one, divisor_two, divisor_four, divisor_six, divisor_eight;\n  logic [1:0] first_digit, first_remainder;\n  assign divisor_one = {3'b0, divisor_q};\n  assign divisor_two = {2'b0, divisor_q, 1'b0};\n  assign divisor_four = {1'b0, divisor_q, 2'b0};\n  assign divisor_six = divisor_three_q << 1;\n  assign divisor_eight = {divisor_q, 3'b0};\n\n  // Initially R=0, so the first trial dividend is only h=A[31:30].\n  // Decode D=0..3 separately; D>=4 cannot fit into h. This network\n  // does not use the recurrence or bypass the registered 3D multiple.\n  always_comb begin\n    first_digit = 2'd0;\n    first_remainder = quotient_q[31:30];\n  \n…[4722 of 7794 chars elided by tools/bench/transcript.py; sha256:e3499c3e076d1486]…\neration_q <= iteration_q + 3'd1;\n          if (iteration_q == 3'd5) state_q <= CORRECT;\n        end\n        CORRECT: begin\n          state_q <= DONE;\n`ifdef RISCV_FORMAL_ALTOPS\n          case (op_q)\n            ALU_DIV:  result <= (a_q - b_q) ^ 32'h7f8529ec;\n            ALU_DIVU: result <= (a_q - b_q) ^ 32'h10e8fd70;\n            ALU_REM:  result <= (a_q - b_q) ^ 32'h8da68fa5;\n            ALU_REMU: result <= (a_q - b_q) ^ 32'h3138d0e1;\n            default:  result <= '0;\n          endcase\n`else\n          if (zero_q)\n            result <= select_remainder_q ? dividend_q : 32'hffffffff;\n          else if (overflow_q)\n            result <= select_remainder_q ? 32'b0 : 32'h80000000;\n          else if (select_remainder_q)\n            result <= remainder_negative_q ? -remainder_q : remainder_q;\n          else\n            result <= quotient_negative_q ? -quotient_q : quotient_q;\n`endif\n        end\n        DONE: if (result_ready) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
