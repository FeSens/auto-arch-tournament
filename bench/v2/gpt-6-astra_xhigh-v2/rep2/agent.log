{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nr=Path('cores/bench/rtl');bak=Path('cores/bench/generated/hypgen_original')\nfor n in ['core.sv','mem_stage.sv','hazard_unit.sv']:(r/n).write_bytes((bak/n).read_bytes())\np=r/'hazard_unit.sv';s=p.read_text().replace('  input  logic       redirect,','  input logic if_id_branch,\\\\n  input  logic       redirect,').replace('load_use_hazard = id_ex_valid && id_ex_mem_read && imem_ready', 'load_use_hazard = id_ex_valid && id_ex_mem_read && imem_ready && \"'!if_id_branch'\"');p.write_text(s)\np=r/'mem_stage.sv';s=p.read_text().replace('  input  logic               hold_wb,','  input  logic               hold_wb,\\\\n  output logic [31:0] branch_load_data,\\\\n  output logic branch_load_valid,');s=s.replace('  // ── MEM/WB register', '  assign branch_load_data = load_data;\\\\n  assign branch_load_valid = in.valid && in.ctrl.mem_read && ctrl_with_trap.reg_write;\\\\n\\\\n  // ── MEM/WB register');p.write_text(s)\np=r/'core.sv';s=p.read_text().replace('  logic        wb_w_en;', '  logic [31:0] branch_load_data;\\\\n  logic branch_load_valid;\\\\n  logic        wb_w_en;');s=s.replace('    .in              (id_ex_w),','''    .in              (id_ex_w),\n    .branch_load_data (branch_load_data),\n    .branch_load_valid(branch_load_valid),\n    .branch_load_rd   (ex_mem_w.rd),''').replace('    .in         (ex_mem_w),','''    .in         (ex_mem_w),\n    .branch_load_data(branch_load_data),\n    .branch_load_valid(branch_load_valid),''').replace('    .if_id_rs2      (if_id_w.instr[24:20]),','''    .if_id_rs2      (if_id_w.instr[24:20]),\n    .if_id_branch   (if_id_w.instr[6:0] == 7'h63 && if_id_w.instr[14:12] \"'!= 3'\"'d2 && if_id_w.instr[14:12] \"'!= 3'\"'d3),''').replace('.ex_mem_w_en (ex_mem_w.ctrl.reg_write),', '.ex_mem_w_en (ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.ctrl.mem_read),'\"');p.write_text(s)\np=r/'ex_stage.sv';s=p.read_text().replace('  input  id_ex_t   in,','''  input  id_ex_t   in,\n  input logic [31:0] branch_load_data,\n  input logic branch_load_valid,\n  input logic [4:0] branch_load_rd,''')\ns=s.replace('  logic        branch_cond;','''  logic [31:0] compare_rs1, compare_rs2;\n  assign compare_rs1 = branch_load_valid && branch_load_rd \"'!= 5'\"'b0 && branch_load_rd == in.rs1_addr\n                     ? branch_load_data : rs1;\n  assign compare_rs2 = branch_load_valid && branch_load_rd \"'!= 5'\"'b0 && branch_load_rd == in.rs2_addr\n                     ? branch_load_data : rs2;\n  logic        branch_cond;''')\nstart=s.index('    case (in.ctrl.branch_op)');end=s.index('    branch_taken ',start);part=s[start:end].replace('rs1','compare_rs1').replace('rs2','compare_rs2');s=s[:start]+part+s[end:];s=s.replace('is_divide ? div_rs1_q : rs1;', 'is_divide ? div_rs1_q : in.ctrl.is_branch ? compare_rs1 : rs1;').replace('is_divide ? div_rs2_q : rs2;', 'is_divide ? div_rs2_q : in.ctrl.is_branch ? compare_rs2 : rs2;');p.write_text(s)\nPY\npython - <<'PY' > cores/bench/generated/hypgen_load_branch_timing.log 2>&1\nfrom tools.eval.gowin import build_all,summarize\nimport json\nr=build_all('.','cores/bench/rtl','fpga/core_bench_si.sv','cores/bench/generated/load_branch_timing')\nprint(json.dumps({'results':r,'summary':summarize(r)},indent=2))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
