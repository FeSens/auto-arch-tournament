{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/ex_stage.sv');s=p.read_text()\ns=s.replace('  logic branch_equal, branch_ult, branch_slt;','  logic branch_equal, branch_ult, branch_slt;\\\\n  logic [31:0] branch_a, branch_b;\\\\n  logic branch_base, branch_mismatch, branch_eligible;\\\\n  assign branch_a = {rs1[31] \"'^ !in.ctrl.branch_op[1], rs1[30:0]};'\"\\\\n  assign branch_b = {rs2[31] \"'^ !in.ctrl.branch_op[1], rs2[30:0]};'\"')\ns=s.replace('rs1[b*8 +: 8] < rs2[b*8 +: 8]', 'branch_a[b*8 +: 8] < branch_b[b*8 +: 8]')\ns=s.replace('  assign branch_slt = (rs1[31] \"'!= rs2[31]) ? rs1[31] : branch_ult;'\"', '''  assign branch_slt = branch_ult;\n  assign branch_base = in.ctrl.branch_op[2] ? branch_ult : branch_equal;\n  assign branch_mismatch = branch_base \"'^ (in.ctrl.branch_op[0] ''^ in.predicted_taken);\n  assign branch_eligible = !in.ctrl.is_illegal && (branch_target[1:0] == 2'\"'b00);''')\ns=s.replace('  logic ex_accept, actual_taken, direct_control;', '  logic ex_accept, actual_taken;')\ns=s.replace('''  assign direct_control = in.ctrl.is_branch ||\n                          (in.ctrl.is_jump && \"'!in.ctrl.is_jalr);\n  assign redirect = ex_accept &&\n                    ((direct_control && (in.predicted_taken != actual_taken)) ||\n                     (in.ctrl.is_jalr && actual_taken));\n  assign redirect_target = !actual_taken ? (in.pc + 32'\"'d4)\n                         : in.ctrl.is_jump ? jump_target : branch_target;''','''  assign redirect = ex_accept &&\n                    ((in.ctrl.is_branch &&\n                      ((branch_eligible && branch_mismatch) ||\n                       (\"'!branch_eligible && in.predicted_taken))) ||\n                     (in.ctrl.is_jump && !in.ctrl.is_jalr &&\n                      (in.predicted_taken != actual_taken)) ||\n                     (in.ctrl.is_jalr && actual_taken));\n  assign redirect_target = in.ctrl.is_jalr ? jump_target\n                         : in.predicted_taken ? (in.pc + 32'\"'d4) : branch_target;''')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
