{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/generated/r10s0_probe/test_r64_vectors.py <<'PY'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parents[2]/'test'))\nimport cocotb\nfrom test_alu import _setup,_check_div,_div_reference,ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU\n\n@cocotb.test()\nasync def radix64_boundaries(dut):\n    await _setup(dut)\n    mask=(1<<32)-1\n    pairs=set()\n    ds={0,1,2,3,5,7,63,64,65,127,128,129,0x7fffffff,0x80000000,0xfffffffe,mask}\n    for k in range(1,64):\n        for bit in (26,29,31,32):\n            d=(1<<bit)//k\n            ds.update(v for v in (d-1,d,d+1) if 0<=v<=mask)\n    for d in sorted(ds):\n        for digit in range(64):\n            for delta in (-1,0,1):\n                a=d*digit+delta\n                if 0<=a<=mask:pairs.add((a,d))\n        for a in (0,1,0x80000000,mask):pairs.add((a,d))\n    for shift in (0,6,12,18,24):\n        for digit in range(64):\n            q=digit<<shift\n            for d in (1,2,3,7,63):\n                for rem in (0,d-1):\n                    a=q*d+rem\n                    if a<=mask:pairs.add((a,d))\n    for idx,(a,b) in enumerate(sorted(pairs)):\n        for op in (ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU):\n            await _check_div(dut,op,a,b,_div_reference(op,a,b),hold=2 if idx%4093==0 else 0)\n    dut._log.info('Checked %d operand pairs in all four operations',len(pairs))\nPY\npython - <<'PY' > cores/bench/generated/r10s0_probe/r64_vectors.log 2>&1\nfrom pathlib import Path\nfrom cocotb_tools.runner import get_runner\np=Path('cores/bench/generated/r10s0_probe').resolve()\nget_runner('verilator').test(hdl_toplevel='alu',test_module='test_r64_vectors',test_dir=str(p),build_dir=str(p/'r64_sim_build/alu'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
