{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/divider.sv')\nb=Path('cores/bench/generated/r10_probe')\nb.mkdir(parents=True,exist_ok=True)\ns=p.read_text(); (b/'divider.original.sv').write_text(s)\ns=s.replace(\\\"localparam logic [1:0] IDLE = 2'd0, ITERATE = 2'd1,\\\\n                         CORRECT = 2'd2, DONE = 2'd3;\\\", \\\"localparam logic [1:0] IDLE = 2'd0, ITERATE = 2'd1, DONE = 2'd3;\\\")\na=s.index('  logic [34:0] divisor_three_q')\nz=s.index('  // Initially R=0',a)\ns=s[:a]+'''  logic [36:0] odd_q [1:15];\n  logic [36:0] multiples [1:31];\n  logic [36:0] wide_d;\n  logic [1:0] first_digit, first_remainder;\n  assign wide_d = {5'b0, divisor_q};\n  assign multiples[1] = wide_d;\n'''+''.join(f'  assign multiples[{k}] = '+ ('wide_d' if k & (k-1) == 0 else f'odd_q[{((k//(k & -k))-1)//2}]')+f' << {(k & -k).bit_length()-1};\\\\n' for k in range(2,32))+s[z:]\na=s.index('  logic [31:0] quotient_step')\nz=s.index('\"'`endif'\"',a)\ns=s[:a]+'''  logic [36:0] shifted;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [37:0] trial [1:31];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [32:0] fit;\n  logic [31:0] take;\n  logic [31:0] r_tree [1:63];\n  logic [4:0] q_tree [1:63];\n  logic [31:0] next_quotient, next_remainder;\n  assign shifted = {remainder_q, quotient_q[31:27]};\n  assign fit[0] = 1'b1;\n  assign fit[32] = 1'b0;\n  for (genvar k = 1; k < 32; k++) begin : trials\n    assign trial[k] = {1'b0, shifted} - {1'b0, multiples[k]};\n    assign fit[k] = \"'!trial[k][37];\n  end\n  for (genvar k = 0; k < 32; k++) begin : leaves\n    assign take[k] = fit[k] && !fit[k+1];\n    if (k == 0) begin : zero\n      assign r_tree[32+k] = {32{take[k]}} & shifted[31:0];\n    end else begin : nonzero\n      assign r_tree[32+k] = {32{take[k]}} & trial[k][31:0];\n    end\n    assign q_tree[32+k] = {5{take[k]}} & 5'\"'(k);\n  end\n  for (genvar k = 1; k < 32; k++) begin : reduction\n    assign r_tree[k] = r_tree[2*k] | r_tree[2*k+1];\n    assign q_tree[k] = q_tree[2*k] | q_tree[2*k+1];\n  end\n  assign next_remainder = r_tree[1];\n  assign next_quotient = {quotient_q[26:0], q_tree[1]};\n'''+s[z:]\ns=s.replace(\\\"      result <= '0;\\\\n\\\",'')\ns=s.replace(\\\"      divisor_three_q <= '0;\\\\n      divisor_five_q <= '0;\\\\n      divisor_seven_q <= '0;\\\", \\\"      for (int j = 1; j < 16; j++) odd_q[j] <= '0;\\\")\na=s.index('            // Independent full-width multiples')\nz=s.index('            quotient_q <= {quotient_q[29:0]',a)\ndef csd(n):\n digits=[]; j=0\n while n:\n  if n&1:\n   c=2-(n%4); digits.append((c,j)); n-=c\n  n//=2; j+=1\n return sorted(digits,key=lambda t:t[1],reverse=True)\nlines=[]\nfor k in range(3,32,2):\n expr=''\n for c,j in csd(k):\n  term=f'(wide_d << {j})' if j else 'wide_d'\n  expr += (' - ' if c<0 else ' + ' if expr else '')+term\n lines.append(f'            odd_q[{(k-1)//2}] <= {expr};\\\\n')\ns=s[:a]+''.join(lines)+s[z:]\ns=s.replace('quotient_step[2]', 'next_quotient').replace('remainder_step[2]', 'next_remainder')\ns=s.replace(\\\"if (iteration_q == 3'd5) state_q <= CORRECT;\\\", \\\"if (iteration_q == 3'd6) state_q <= DONE;\\\")\na=s.index('        CORRECT: begin')\nz=s.index('        DONE: if (result_ready)',a)\nbody=s[a:z]\nbody=body[body.index('\"'`ifdef RISCV_FORMAL_ALTOPS'\"'):body.rindex('        end')]\nbody=body.replace('result <=', 'result =')\ns=s[:a]+s[z:]\ns=s.replace('  always_ff @(posedge clock) begin', '  always_comb begin\\\\n'+body+'  end\\\\n\\\\n  always_ff @(posedge clock) begin',1)\ns=s.replace('// edge two peels the top two bits and registers 3D, 5D and 7D. Edges three\\\\n// through seven each perform two radix-8 restoring steps, consuming\\\\n// exactly 2 + 5*6 = 32 bits. Edge eight registers sign correction.', '// edge two peels two bits and registers odd multiples through 31D.\\\\n// Edges three through eight each consume one five-bit radix-32 digit.\\\\n// Correction is combinational from final held state into EX/MEM.')\np.write_text(s)\nprint('Temporary divider probe installed; original saved under generated/r10_probe.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
