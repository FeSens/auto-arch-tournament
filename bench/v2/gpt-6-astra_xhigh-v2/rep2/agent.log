{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/operand_probe')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv'\ns=p.read_text()\na=s.index('  always_comb begin\\\\n    case (fwd_rs1_sel)')\nb=s.index('  logic [31:0] alu_result;',a)\ns=s[:a]+'''  logic rs1_id, rs1_mem, rs1_wb, rs2_id, rs2_mem, rs2_wb;\n  assign rs1_mem = (fwd_rs1_sel == 2'd1);\n  assign rs1_wb = (fwd_rs1_sel == 2'd2);\n  assign rs1_id = \"'!rs1_mem && !rs1_wb;\n  assign rs2_mem = (fwd_rs2_sel == 2'\"'d1);\n  assign rs2_wb = (fwd_rs2_sel == 2'd2);\n  assign rs2_id = \"'!rs2_mem && !rs2_wb;\n  assign rs1 = ({32{rs1_id}} & in.rs1_val) |\n               ({32{rs1_mem}} & fwd_ex_mem) |\n               ({32{rs1_wb}} & fwd_mem_wb);\n  assign rs2 = ({32{rs2_id}} & in.rs2_val) |\n               ({32{rs2_mem}} & fwd_ex_mem) |\n               ({32{rs2_wb}} & fwd_mem_wb);\n\n  // One level of source selection, including PC/immediate selection.\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = (({32{!in.ctrl.is_auipc && rs1_id}} & in.rs1_val) |\n                  ({32{!in.ctrl.is_auipc && rs1_mem}} & fwd_ex_mem)) |\n                 (({32{!in.ctrl.is_auipc && rs1_wb}} & fwd_mem_wb) |\n                  ({32{in.ctrl.is_auipc}} & in.pc));\n  assign alu_b = (({32{!in.ctrl.alu_src && rs2_id}} & in.rs2_val) |\n                  ({32{!in.ctrl.alu_src && rs2_mem}} & fwd_ex_mem)) |\n                 (({32{!in.ctrl.alu_src && rs2_wb}} & fwd_mem_wb) |\n                  ({32{in.ctrl.alu_src}} & in.imm));\n\n'\"'''+s[b:]\np.write_text(s)\nprint('Created isolated operand selection prototype:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
