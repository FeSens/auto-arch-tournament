{"type": "item.completed", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c \"sed -n '110,250p' cores/bench/test/test_pipeline.py && tail -4 cores/bench/generated/predictor_probe/piped_persistent/formal.log\"", "aggregated_output": "        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ir, dr = stall_fn(cycle, ia, da, wen) if stall_fn else (1, 1)\n        dut.io_imemReady.value = ir\n        dut.io_dmemReady.value = dr\n        word = imem.get(ia & ~3, EBREAK())\n        if not ir and invalid_word_fn is not None:\n            word = invalid_word_fn(cycle, ia)\n        dut.io_imemData.value = word\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(2, \"ns\")\n        if observe is not None:\n            observe(cycle, ia, word, ir, dr)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Accept a store only at the edge where the bus is ready. Keeping\n        # this log catches repeated stores even when they write equal data.\n        if wen and dr:\n            wdata = int(dut.io_dmemWData.value)\n            if stores is not None:\n                stores.append((cycle, da, wen, wdata))\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_a\n…[3090 of 6162 chars elided by tools/bench/transcript.py; sha256:0bc3c18aabb9f471]…\n=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\nSBY  1:38:48 [insn_sub_ch0] engine_0: ##   0:00:00  Skipping step 0..\nSBY  1:38:48 [insn_xori_ch0] engine_0: ##   0:00:00  Solver: bitwuzla\nSBY  1:38:48 [insn_xor_ch0] engine_0: ##   0:00:00  Skipping step 13..\nSBY  1:38:48 [insn_sw_ch0]", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nb=Path('cores/bench/generated/predictor_probe/piped_persistent');(b/'test').mkdir(exist_ok=True)\ns='''import sys,random\nimport cocotb\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parents[4]/'test'))\nfrom test_pipeline import _run,_b,ADDI,SW,BEQ,DIV,EBREAK,_check_trace,_PredictionChecks\n\n@cocotb.test()\nasync def registered_training_and_retained_reset(dut):\n    counters=[2]*64\n    pending=None\n    event_count=0\n    apply_count=0\n    recovery_count=0\n    def observe(cycle,pc,word,ir,dr):\n        nonlocal pending,event_count,apply_count,recovery_count\n        top=dut.u_if\n        assert int(top.train_valid_q.value)==(pending is not None)\n        if pending is not None:\n            assert int(top.train_index_q.value)==pending[0]\n            assert int(top.train_taken_q.value)==pending[1]\n        target=_PredictionChecks.target(pc,word)\n        branch=word&127==0x63 and (word>>12)&7 not in (2,3)\n        expected=int((target&3)==0 and (word&127==0x6f or (branch and counters[(pc>>2)&63]>=2)))\n        assert int(top.predicted_taken.value)==expected,(cycle,pc,counters[(pc>>2)&63],expected)\n        recovery_count+=int(dut.redirect.value)\n        if int(dut.io_rvfi_valid_0.value) and int(dut.io_rvfi_insn_0.value)==EBREAK():\n            return\n        if pending is not None:\n            i,t=pending;counters[i]=max(0,min(3,counters[i]+(1 if t else -1)));apply_count+=1\n        pending=(int(dut.train_index.value),int(dut.train_taken.value)) if int(dut.train_valid.value) else None\n        event_count+=pending is not None\n    false={0:_b(32,0,0,1,0x63),4:ADDI(2,0,23),8:SW(2,0,0x100),12:EBREAK(),32:SW(2,0,0x180),36:DIV(3,2,0)}\n    true={0:BEQ(0,0,16),4:DIV(3,0,0),8:SW(2,0,0x180),16:ADDI(2,0,42),20:SW(2,0,0x100),24:EBREAK()}\n    alias={0:BEQ(0,0,256),256:_b(32,0,0,1,0x63),260:ADDI(2,0,19),264:SW(2,0,0x100),268:EBREAK(),288:SW(2,0,0x180),292:DIV(3,2,0)}\n    for n in range(24):\n        pending=None # each _run performs architectural reset, canceling the stage\n        program,pcs,value=[(false,[0,4,8,12],23),(true,[0,16,20,24],42),(alias,[0,256,260,264,268],19)][(n//4)%3]\n        rng=random.Random(n)\n        def stalls(c,ia,da,w):return (int(rng.random()>.3),int(rng.random()>.4))\n        stores=[]\n        rets,mem=await _run(dut,program,max_cycles=300,observe=observe,stores=stores,stall_fn=stalls if n%2 else None)\n        _check_trace(rets,program,pcs)\n        assert mem=={0x100:value} and len(stores)==1\n    # Cancel a valid captured event before its counter-write edge.\n    pending=None\n    await _run(dut,false,max_cycles=100,observe=observe,abort_after=2)\n    assert pending is not None\n    pending=None\n    rets,mem=await _run(dut,true,max_cycles=100,observe=observe)\n    _check_trace(rets,true,[0,16,20,24]);assert mem=={0x100:42}\n    assert event_count==apply_count+1,(event_count,apply_count)\n    assert recovery_count>0\n    dut._log.info('26 executions; accepted=%d applied=%d (one canceled on reset), recoveries=%d',event_count,apply_count,recovery_count)\n'''\n(b/'test/probe_training.py').write_text(s)\nprint('Prepared directed repeated-reset and event pipeline probe')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
