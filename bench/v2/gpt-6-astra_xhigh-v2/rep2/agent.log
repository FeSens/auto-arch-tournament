  2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n  assign imem_addr = pc;\nendmodule\n''';p.write_text(s)\nprint('Fetch queue prototype written.')\nPY\"","aggregated_output":"Fetch queue prototype written.\n","exit_code":0,"status":"completed"}}
