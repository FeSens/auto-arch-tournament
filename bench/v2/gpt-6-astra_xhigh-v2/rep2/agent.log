{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport subprocess\nfor f in ['core.sv','ex_stage.sv','id_stage.sv','core_pkg.sv']:\n p=Path('cores/bench/rtl')/f;p.write_bytes(subprocess.check_output(['git','show','HEAD:'+str(p)]))\np=Path('cores/bench/rtl/core_pkg.sv');s=p.read_text().replace('    ctrl_t       ctrl;\\\\n    logic [31:0] instr;', '    ctrl_t       ctrl;\\\\n    logic        branch_recover_invert;\\\\n    logic [31:0] instr;',1);p.write_text(s)\np=Path('cores/bench/rtl/id_stage.sv');s=p.read_text().replace('      reg_q.ctrl     <= ctrl_decoded;', '      reg_q.ctrl     <= ctrl_decoded;\\\\n      reg_q.branch_recover_invert <= in.predicted_taken \"'^ dec_branch_op[0];'\"');p.write_text(s)\np=Path('cores/bench/rtl/ex_stage.sv');s=p.read_text();a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');b=s.index('    branch_taken  =',a)\ns=s[:a]+'''  logic [31:0] branch_a, branch_b;\n  logic branch_equal, branch_less, branch_base, branch_mismatch, branch_eligible;\n  assign branch_a = {rs1[31] \"'^ !in.ctrl.branch_op[1], rs1[30:0]};\n  assign branch_b = {rs2[31] ''^ !in.ctrl.branch_op[1], rs2[30:0]};\n  assign branch_equal = rs1 == rs2;\n  assign branch_less = branch_a < branch_b;\n  assign branch_base = in.ctrl.branch_op[2] ? branch_less : branch_equal;\n  assign branch_mismatch = branch_base ''^ in.branch_recover_invert;\n  assign branch_eligible = !in.ctrl.is_illegal && (branch_target[1:0] == 2'\"'b00);\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU:\n        branch_cond = branch_base \"'^ in.ctrl.branch_op[0];\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''+s[b:]\na=s.index('  logic ex_accept, actual_taken, direct_control;');b=s.index('  // Only an accepted conditional branch',a)\ns=s[:a]+'''  logic ex_accept, jump_eligible;\n  assign ex_accept = \"'!reset && in.valid && !stall && !execute_wait;\n  assign jump_eligible = !in.ctrl.is_illegal && !misalign_jump;\n  assign redirect = ex_accept &&\n                    ((in.ctrl.is_branch &&\n                      ((branch_eligible && branch_mismatch) ||\n                       (!branch_eligible && in.predicted_taken))) ||\n                     (in.ctrl.is_jump && !in.ctrl.is_jalr &&\n                      (in.predicted_taken != jump_eligible)) ||\n                     (in.ctrl.is_jalr && in.ctrl.is_jump && jump_eligible));\n  assign redirect_target = in.ctrl.is_jalr ? jump_target\n                         : in.predicted_taken ? (in.pc + 32'\"'d4) : branch_target;\n\n'''+s[b:]\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
