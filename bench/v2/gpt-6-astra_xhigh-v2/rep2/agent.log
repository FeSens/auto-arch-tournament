{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py');s=p.read_text();idx=s.index('def test_pipeline_runner')\ns=s[:idx]+'''@cocotb.test()\nasync def fetch_queue_full_recovery_wrap_and_bus_overlap(dut):\n    program = [ADDI(1, 0, 100), ADDI(2, 0, 3), DIV(3, 1, 2),\n               SW(3, 0, 0x200), BEQ(1, 2, 16), ADDI(4, 3, 7),\n               JAL(0, 16), DIV(9, 1, 0), SW(1, 0, 0x204),\n               DIV(10, 1, 0)]\n    program += [ADDI(5, 0, 0)] + [ADDI(5, 5, 1)] * 32 + [EBREAK()]\n    wanted_pcs = [0, 4, 8, 12, 16, 20, 24] + list(range(40, len(program) * 4, 4))\n    check = _PredictionChecks(dut)\n    full = simultaneous = drain_under_istall = recovery_full = 0\n    blocked = 0\n    def stalls(cycle, ia, da, wen):\n        nonlocal blocked\n        if wen and da == 0x200 and blocked < 12:\n            blocked += 1\n            return (1, 0)\n        return (int(cycle % 11 < 8), 1)\n    def observe(cycle, pc, word, ir, dr):\n        nonlocal full, simultaneous, drain_under_istall, recovery_full\n        count = len(check.fetch_queue)\n        consume = bool(int(dut.if_id_w.value) & 1) and not int(dut.stall_if.value)\n        full += count == 4\n        simultaneous += count == 4 and consume and ir\n        drain_under_istall += count > 0 and consume and not ir\n        recovery_full += count == 4 and bool(int(dut.redirect.value))\n        check(cycle, pc, word, ir, dr)\n    stores = []\n    rets, mem = await _run(dut, program, max_cycles=500, stall_fn=stalls,\n                           stores=stores, observe=observe)\n    _check_trace(rets, program, wanted_pcs)\n    assert mem == {0x200: 33} and len(stores) == 1\n    assert rets[-2][\\\"rd_wdata\\\"] == 32\n    assert full and simultaneous and drain_under_istall and recovery_full\n    assert check.divide_requests == [8]\n\n\n'''+s[idx:];p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
