{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nbase=Path('cores/bench'); bak=Path('/srv/hwebench/tmp/9e6b10b9/03a87001/r7s1-original')\nfor p in bak.rglob('*'):\n if p.is_file(): (base/p.relative_to(bak)).write_bytes(p.read_bytes())\n(base/'rtl/multiplier.sv').unlink()\np=base/'rtl/core.sv';s=p.read_text().replace('.imem_ready     (io_imemReady)', '.imem_ready     (if_id_w.valid)');p.write_text(s)\np=base/'rtl/if_stage.sv';s=p.read_text();start=s.index('  // Recovery overrides');s=s[:start]+'''  // Fall-through elastic fetch queue. Fetch PC belongs to the producer;\n  // stall applies only to consumption of the oldest fetched instruction.\n  localparam integer DEPTH = 4;\n  if_id_t entries [0:DEPTH-1];\n  logic [1:0] read_q, write_q;\n  logic [2:0] count_q;\n  if_id_t fetched;\n  logic consume, fetch_accept, enqueue, dequeue;\n  always_comb begin\n    fetched.pc = pc;\n    fetched.instr = imem_data;\n    fetched.predicted_taken = predicted_taken;\n    fetched.valid = imem_ready;\n    out = (count_q \"'!= 0) ? entries[read_q] : fetched;\n    out.valid = (count_q != 0) || imem_ready;\n  end\n  assign consume = !stall && out.valid;\n  assign dequeue = consume && count_q != 0;\n  assign fetch_accept = imem_ready && (count_q < DEPTH || dequeue);\n  assign enqueue = fetch_accept && (count_q != 0 || !consume);\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      read_q <= '\"'0;\n      write_q <= '0;\n      count_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      read_q <= '0;\n      write_q <= '0;\n      count_q <= '0;\n    end else begin\n      if (fetch_accept) pc <= next_pc;\n      if (enqueue) begin\n        entries[write_q] <= fetched;\n        write_q <= write_q + 2'd1;\n      end\n      if (dequeue) read_q <= read_q + 2'd1;\n      case ({enqueue, dequeue})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n  assign imem_addr = pc;\nendmodule\n''';p.write_text(s)\nprint('Fetch queue prototype written.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
