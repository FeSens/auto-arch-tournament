 assign candidates[8] = {32{select_op[ALU_SRL]}} & (a >> shamt);\n  assign candidates[9] = {32{select_op[ALU_SRA]}} & \"'$unsigned($signed(a) >>> shamt);\n  assign candidates[10] = {32{select_op[ALU_LUI]}} & b;\n  assign candidates[11] = {32{|select_op[14:11]}} & mul_result;\n  assign candidates[12] = {32{|select_op[18:15]}} & div_result;\n  assign candidates[13] = {32{select_op[19]}} & link_value;\n  assign candidates[14] = '\"'0;\n  assign candidates[15] = '0;\n  for (genvar k = 0; k < 16; k++) begin : result_leaves\n    assign tree[16+k] = candidates[k];\n  end\n  for (genvar k = 1; k < 16; k++) begin : result_groups\n    assign tree[k] = tree[2*k] | tree[2*k+1];\n  end\n  assign out = tree[1];\nendmodule\n''';p.write_text(s)\np=d/'ex_stage.sv';s=p.read_text().replace('  alu u_alu (','  alu #(.PREDECODED(1)) u_alu (\\\\n    .result_select(in.alu_select), .link_value(in.pc + 32\\\\'d4),').replace(\\\"in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result\\\",'alu_result');p.write_text(s)\nshutil.copytree('cores/bench/test',r/'test',dirs_exist_ok=True)\nprint(r)\nPY\npython3 -u - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nr=Path('/srv/hwebench/tmp/9e6b10b9/70e838ae/r14_micro/predecode')\nx=build(Path.cwd(),r/'rtl','fpga/core_bench_si.sv',1,r/'gowin_p1')\n(r/'timing_p1.json').write_text(json.dumps(x,indent=2));print(json.dumps(x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
