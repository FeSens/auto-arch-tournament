{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"cat > cores/bench/generated/r10s0_probe/r16_probe.py <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/r10s0_probe')\nrtl=base/'r16_rtl'\nrtl.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copyfile(p,rtl/p.name)\np=rtl/'divider.sv'\ns=p.read_text()\na=s.index('  logic [34:0] divisor_three_q')\nb=s.index('\"'`endif'\"\\\\n\\\\n  always_ff')\nlogic='''  logic [35:0] multiples [1:15];\n  logic [35:0] odd_q [1:7];\n  assign multiples[1] = {4'b0,divisor_q};\n'''\nfor k in range(2,16):\n if k%2==0: logic+=f'  assign multiples[{k}] = multiples[{k//2}] << 1;\\\\n'\n else: logic+=f'  assign multiples[{k}] = odd_q[{k//2}];\\\\n'\nlogic+='''\n  logic [11:0] first_digit, first_remainder;\n  logic [11:0] prep_q [0:3];\n  logic [11:0] prep_r [0:3];\n  logic [15:0] prep_d [1:15];\n  assign prep_d[1] = {4'b0,divisor_q[11:0]};\n'''\nfor k in range(2,16):\n if k%2==0: logic+=f'  assign prep_d[{k}] = prep_d[{k//2}] << 1;\\\\n'\n elif k==15: logic+='  assign prep_d[15] = (prep_d[1] << 4) - prep_d[1];\\\\n'\n elif k==7: logic+='  assign prep_d[7] = (prep_d[1] << 3) - prep_d[1];\\\\n'\n else: logic+=f'  assign prep_d[{k}] = prep_d[{k-1}] + prep_d[1];\\\\n'\nlogic+='''  assign prep_q[0] = quotient_q[31:20];\n  assign prep_r[0] = 12'b0;\n  for (genvar j=0; j<3; j++) begin: prep\n    localparam integer W=4+4*j;\n    logic [W-1:0] t;\n    logic [W:0] trial [1:15];\n    logic [16:0] fit;\n    logic [15:0] take;\n    logic [W-1:0] candidate [0:15];\n    logic [W-1:0] layer1 [0:7],layer2 [0:3],layer3 [0:1];\n    if (j==0) assign t = prep_q[j][11:8];\n    else assign t = {prep_r[j][W-5:0],prep_q[j][11:8]};\n    assign fit[0] = 1'b1;\n    assign fit[16] = 1'b0;\n    assign candidate[0] = {W{take[0]}} & t;\n    for (genvar k=1;k<16;k++) begin: trials\n      assign trial[k] = {1'b0,t} - {1'b0,prep_d[k][W-1:0]};\n      assign fit[k] =