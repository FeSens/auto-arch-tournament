{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase operations and multiplication remain combinational. Division uses\neight internal clocks and holds completion until the consumer accepts it.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport random\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n    RTL, TEST_DIR, SIM_BUILD,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\nALT_CONSTANTS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, real):\n    if ALTOPS and op in ALT_CONSTANTS:\n        value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (value ^ ALT_CONSTANTS[op]) & MASK32\n    return real & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    expected = _expected(op, a, b, expected)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0, ready_early=False\n…[10411 of 13483 chars elided by tools/bench/transcript.py; sha256:a03f83877935200d]…\nin range(9):\n            await _tick(dut)\n            assert int(dut.div_result_valid.value) == 0\n        await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    \"\"\"Run the same vectors and exact latency assertions with ALTOPS defined.\"\"\"\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = str(SIM_BUILD / \"alu_altops\")\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"divider.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1},\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n                build_dir=build_dir, extra_env={\"TEST_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat Makefile formal/run_all.sh cores/bench/core.yaml .gitignore && rg --files cores/bench/test'", "aggregated_output": ".PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n.DEFAULT_GOAL := help\n\n# Resolve OSS CAD Suite path so commands work even when the user hasn't\n# sourced .toolchain/oss-cad-suite/environment in this shell.\nTOOLCHAIN_DIR := $(CURDIR)/.toolchain\nOSS_BIN       := $(TOOLCHAIN_DIR)/oss-cad-suite/bin\nLOCAL_BIN     := $(TOOLCHAIN_DIR)/bin\nexport PATH := $(OSS_BIN):$(LOCAL_BIN):$(PATH)\n\n# Orchestrator knobs (pass-through to tools.orchestrator):\n#   N        — number of rounds for `make loop` (default 10).\n#   K        — tournament size, slots per round (default 1 = sequential).\n#   AGENT    — codex (default) or claude. Honors a pre-existing\n#              AGENT_PROVIDER env var if AGENT isn't set on the make\n#              command line.\n#   BASE     — when forking a new TARGET, copy from cores/<BASE>/.\n#              Default: baseline (orchestrator-side default).\n#   COREMARK — target CoreMark iterations/sec (e.g. '370').\n#   LUT      — target LUT count (e.g. '3000').\n#   WORKTREE — default ON. `make loop` first creates a dedicated git worktree\n#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    ?= $(or $(AGENT_PROVIDER),codex)\nBASE     ?=\nCOREMARK ?=\nLUT      ?=\nWORKTREE ?= 1\n\n# Compose optional CLI flags for the orchestrator. Empty vars produce\n# empty strings so the orchestrator falls back to its defaults.\nORCH_FLAGS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[21931 of 25003 chars elided by tools/bench/transcript.py; sha256:ea5f858e5638788c]…\nowaway harness-verification runs (one-model YAMLs + their output\n# trees). These are reliability checks, not benchmark data — output is\n# regenerable and the YAMLs only encode \"rerun this single model to\n# confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n# `models-*-verify.yaml` for the throwaway model YAML.\nbench/*-verify/\nbench/smoke-*/\ntools/bench/models-*-verify.yaml\n\n# Aborted/partial bench output preserved locally with a debug-tag suffix\n# (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n# `results.jsonl.<tag>`). They document a known-broken state for the\n# author's own postmortem; the canonical results live in the un-suffixed\n# per-model dirs.\nbench/*.failed-*\nbench/*.validate-*\nbench/*.prev-*\nbench/*.stale-*\nbench/*.partial-*\nbench/results.jsonl.*\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
