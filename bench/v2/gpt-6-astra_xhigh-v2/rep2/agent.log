{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hyp_probe')\ntests=base/'test'\ntests.mkdir(exist_ok=True)\nfor name in ('test_alu.py','_helpers.py','conftest.py'):\n shutil.copy2(Path('cores/bench/test')/name,tests/name)\np=tests/'test_alu.py'\ns=p.read_text()\ns+='''\n\n@cocotb.test()\nasync def multiplication_signedness_sweep(dut):\n    await _setup(dut)\n    rng = random.Random(20261001)\n    corners = (0, 1, 2, 0x7fff, 0x8000, 0xffff, 0x10000, 0x10001,\n               0x7fffffff, 0x80000000, 0x80000001, 0xffff0000, 0xffffffff)\n    pairs = [(a,b) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]\n    for a,b in pairs:\n        sa = a if a < 0x80000000 else a - 0x100000000\n        sb = b if b < 0x80000000 else b - 0x100000000\n        for op, result in ((ALU_MUL, a*b), (ALU_MULH, (sa*sb)>>32),\n                           (ALU_MULHU, (a*b)>>32), (ALU_MULHSU, (sa*b)>>32)):\n            await _check(dut, op, a, b, result)\n'''\np.write_text(s)\nprint('Created isolated ALU tests with 40,676 additional multiply vectors')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
