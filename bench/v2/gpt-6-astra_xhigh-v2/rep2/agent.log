{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY' > \\\"\"'$TMPDIR/branch-lockstep.log\" 2>&1\nimport os, re, subprocess\nfrom pathlib import Path\nfrom cocotb_tools.runner import get_runner\nroot = Path.cwd()\nrtl = root / '\"'cores/bench/rtl'\ntmp = Path(os.environ['TMPDIR']) / 'branch-lockstep'\ntmp.mkdir(exist_ok=True)\noriginal = {p.name: subprocess.check_output(['git', 'show', f'HEAD:cores/bench/rtl/{p.name}'], text=True) for p in rtl.glob('*.sv')}\nmodules = [m for text in original.values() for m in re.findall(r'\\\\bmodule\\\\s+(\\\\w+)\\\\s*\\\\(', text)]\npattern = re.compile(r'\\\\b(' + '|'.join(modules) + r')\\\\b')\nfor name, text in original.items():\n    if name \"'!= '\"'core_pkg.sv':\n        (tmp / ('prior_' + name)).write_text(pattern.sub(lambda m: 'prior_' + m[0], text))\nfor p in rtl.glob('*.sv'):\n    (tmp / p.name).write_text(p.read_text())\nsource = (tmp / 'core.sv').read_text()\nports = re.findall(r'\"'^'\"\\\\s*(input|output)\\\\s+logic\\\\s+(\\\\[[\"'^'\"\\\\]]+\\\\])?\\\\s*(\\\\w+)', source, re.M)\noutputs = [(width, name) for kind, width, name in ports if kind == 'output']\nextra = '\\\\n'.join(f'wire {width} prior_{name};' for width, name in outputs)\nextra += '\\\\nprior_core prior(\\\\n' + ',\\\\n'.join(f'.{name}({\\\"prior_\\\" if kind == \\\"output\\\" else \\\"\\\"}{name})' for kind, width, name in ports) + '\\\\n);\\\\n'\nextra += 'always @(posedge clock) if (\"'!reset) begin'\"\\\\n'\nfor width, name in outputs:\n    extra += f'  assert ({name} == prior_{name}) else \"'$fatal(1, \"cycle mismatch: {name}\");'\"\\\\n'\nfor name in ('if_id_w', 'id_ex_w', 'ex_mem_w', 'mem_wb_w', 'execute_wait', 'stall_id', 'stall_ex_mem', 'hold_mem_wb', 'fwd_rs1_sel', 'fwd_rs2_sel', 'redirect', 'redirect_target', 'train_valid', 'train_index', 'train_taken'):\n    extra += f'  assert ({name} == prior.{name}) else \"'$fatal(1, \"cycle mismatch: {name}\");'\"\\\\n'\nextra += 'end\\\\n'\n(tmp / 'core.sv').write_text(source.replace('\\\\nendmodule', '\\\\n' + extra + '\\\\nendmodule'))\nsources = [tmp / 'core_pkg.sv'] + sorted(p for p in tmp.glob('*.sv') if p.name \"'!= '\"'core_pkg.sv')\nfor yosys in (False, True):\n    build = tmp / ('yosys' if yosys else 'native')\n    runner = get_runner('verilator')\n    runner.build(sources=sources, hdl_toplevel='core', build_dir=build, always=True,\n                 defines={'YOSYS': 1} if yosys else {},\n                 build_args=['--assert', '-Wall', '-Wno-fatal', '-Wno-style'])\n    runner.test(hdl_toplevel='core', test_module='test_pipeline',\n                test_dir=root / 'cores/bench/test', build_dir=build,\n                results_xml=build / 'results.xml')\nprint('Original/candidate cycle equivalence passed for both pipeline variants.')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
