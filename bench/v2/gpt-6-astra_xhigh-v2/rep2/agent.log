{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nr=Path('/srv/hwebench/tmp/9e6b10b9/f53f45f0/r6s2-prototype')\np=r/'persistent-rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\n(p/'if_stage.sv').write_text((r/'if_stage.persistent.sv').read_text())\ns='''import cocotb\nimport random\nimport test_pipeline as p\n\n@cocotb.test()\nasync def retained_history_and_recovery(dut):\n    state = 2\n    rng = random.Random(61927)\n    for stalled in (False, True):\n        for outcome in (False, False, True, True, True, False, False, False, True, True, True):\n            predictions, training, redirects, stores = [], [], [], []\n            branch = p.BEQ(0, 0, 8) if outcome else p._b(8, 0, 0, 1, 0x63)\n            program = {0: branch, 4: p.SW(0, 0, 0x100) if outcome else p.EBREAK(),\n                       8: p.EBREAK() if outcome else p.SW(0, 0, 0x100),\n                       12: p.DIV(31, 0, 0)}\n            def observe(cycle, pc, word, ir, dr):\n                if pc == 0 and ir and not int(dut.stall_if.value):\n                    predictions.append((int(dut.if_id_w.value) >> 1) & 1)\n                if int(dut.train_valid.value):\n                    training.append(int(dut.train_taken.value))\n                if int(dut.redirect.value):\n                    redirects.append(int(dut.redirect_target.value))\n                assert not int(dut.io_dmemWEn.value)\n                assert not int(dut.io_dmemREn.value)\n                assert not int(dut.u_ex.div_req_valid.value)\n            def stalls(cycle, ia, da, wen):\n                return int(rng.random() >= .22), int(rng.random() >= .22)\n            rets, mem = await p._run(dut, program, stores=stores, observe=observe,\n                                     stall_fn=stalls if stalled else None)\n            assert predictions == [state >> 1], (state, predictions)\n            assert training == [int(outcome)]\n            assert redirects == ([8 if outcome else 4] if (state >> 1) \"'!= outcome else [])\n            assert [v['\"'order'] for v in rets] == [0, 1]\n            assert [v['pc'] for v in rets] == [0, 8 if outcome else 4]\n            assert rets[0]['pc_next'] == rets[1]['pc']\n            assert not any(v['trap'] for v in rets)\n            assert not mem and not stores\n            state = max(0, min(3, state + (1 if outcome else -1)))\n'''\n(r/'persistence_probe.py').write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
