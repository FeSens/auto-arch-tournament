 return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\ntools/eval/formal.py:65:def _build_formal_env(worktree: Path, target: str | None,\ntools/eval/formal.py:79:    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\ntools/eval/formal.py:88:def _cleanup_formal_workdir(worktree_path: Path, core_name: str | None,\ntools/eval/formal.py:107:def run_formal(worktree: str, target: str | None = None) -> dict:\ntools/eval/formal.py:112:                RTL_DIR=cores/<target>/rtl and CORE_NAME=<target> into\nformal/run_all.sh:2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\nformal/run_all.sh:5:# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\nformal/run_all.sh:24:if [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\nformal/run_all.sh:25:  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\nformal/run_all.sh:26:  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.