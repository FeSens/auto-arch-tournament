{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/predictor_probe')\nfor name,source in [('piped','cores/bench/rtl'),('piped_gray',base/'gray/rtl'),('piped_persistent',base/'persistent/rtl')]:\n d=base/name/'rtl'; d.mkdir(parents=True,exist_ok=True)\n for f in Path(source).glob('*.sv'): shutil.copy2(f,d/f.name)\n p=d/'if_stage.sv';s=p.read_text();a=s.index('  localparam');\n head=s[:a];tail=s[a:]\n tail=tail.replace('train_valid','train_valid_q').replace('train_taken','train_taken_q').replace('train_index','train_index_q')\n pipe='''  logic train_valid_q, train_taken_q;\n  logic [5:0] train_index_q;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      train_valid_q <= 1'b0;\n      train_taken_q <= 1'b0;\n      train_index_q <= 6'b0;\n    end else begin\n      train_valid_q <= train_valid;\n      train_taken_q <= train_taken;\n      train_index_q <= train_index;\n    end\n  end\n\n'''\n p.write_text(head+pipe+tail)\nprint('Prepared registered-training variants')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
