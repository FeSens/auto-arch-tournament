{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"git diff -- cores/bench/rtl/alu.sv\nsed -n '315,341p' cores/bench/test/test_alu.py\"","aggregated_output":"diff --git a/cores/bench/rtl/alu.sv b/cores/bench/rtl/alu.sv\nindex 610bb09..617a7ba 100644\n--- a/cores/bench/rtl/alu.sv\n+++ b/cores/bench/rtl/alu.sv\n@@ -41,22 +41,18 @@ module alu (\n     .result(div_result)\n   );\n \n-  // 64-bit products, computed once and selected per op.\n-  // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high\n-  // half). Verilator's UNUSEDSIGNAL is silenced locally — the unused\n-  // bits are dead-code-eliminated by Yosys.\n+  // A signed 33-bit representation covers both signed and unsigned RV32\n+  // operands. Low-product bits are independent of the extension signs.\n+  logic signed [32:0] mul_a, mul_b;\n   /* verilator lint_off UNUSEDSIGNAL */\n-  logic signed [63:0] mul_ss;  // signed*signed\n-  logic        [63:0] mul_uu;  // unsigned*unsigned (both halves used)\n-  logic signed [63:0] mul_su;  // signed*unsigned (a signed, b unsigned)\n+  logic signed [65:0] mul_product;\n   /* verilator lint_on UNUSEDSIGNAL */\n \n   always_comb begin\n     shamt = b[4:0];\n-\n-    mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n-    mul_uu = {32'b0, a} * {32'b0, b};\n-    mul_su = $signed({{32{a[31]}}, a}) * $signed({32'b0, b});\n+    mul_a = $signed({((op == ALU_MULH || op == ALU_MULHSU) && a[31]), a});\n+    mul_b = $signed({((op == ALU_MULH) && b[31]), b});\n+    mul_product = mul_a * mul_b;\n \n     case (op)\n       ALU_ADD:    out = a + b;\n@@ -83,10 +79,10 @@ module alu (\n       ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n       ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n `else\n-      ALU_MUL:    out = mul_uu[31:0];\n-      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n-      ALU_MULHU:  out = mul_uu[63:32];\n-      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n+      ALU_MUL:    out = mul_product[31:0];\n+      ALU_MULH:   out = $unsigned(mul_product[63:32]);\n+      ALU_MULHU:  out = $unsigned(mul_product[63:32]);\n+      ALU_MULHSU: out = $unsigned(mul_product[63:32]);\n `endif\n       ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n       default:  out = 32'b0;\n\n\n@cocotb.test()\nasync def deterministic_m_extension_vectors(dut):\n    await _setup(dut)\n    boundaries = [0, 1, 2, 3, 0x7FFFFFFF, 0x80000000, 0x80000001,\n                  0xFFFFFFFE, 0xFFFFFFFF]\n    vectors = [(a, b) for a in boundaries for b in boundaries]\n    rng = random.Random(0xD1A1DE)\n    vectors += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(80)]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in vectors:\n            await _check_div(dut, op, a, b, _div_reference(op, a, b))\n    for a, b in vectors:\n        await _check(dut, ALU_MUL, a, b, a * b)\n        await _check(dut, ALU_MULH, a, b, (_signed(a) * _signed(b)) >> 32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (_signed(a) * b) >> 32)\n\n\n@cocotb.test()\nasync def final_two_bits_and_power_boundaries(dut):\n    \"\"\"Distinguish exactly 16 radix-4 digits from either 15 or 18.\"\"\"\n    await _setup(dut)\n    for base in (0, 4, 0x100, 0x01010100, 0x15555554, 0x3FFFFFFC, 0xFFFFFFFC):\n        for digit in range(4):\n            q = base + digit\n","exit_code":0,"status":"completed"}}
