ergence_at': i,\n            'insn': hex(ref['insn']), 'pc': hex(ref['pc']),\n            'field': field, 'expected': hex(expected), 'got': hex(got)}\n\ndef compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n            ref_reason=None, sim_returncode=0, sim_stderr=''):\n    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\n        # Direct-equality RVFI fields. trap/halt/intr/mode/ixl are included\n    \n…[10096 of 13168 chars elided by tools/bench/transcript.py; sha256:bc6eeee4c58455a0]…\nl/fpga.py:341:        'ipc_coremark': float,           — iter/cycle\ntools/eval/fpga.py:372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\ntools/eval/fpga.py:385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\ntest/cosim/main.cpp:27:static bool oob_access = false;  // sticky: once set, final marker reports it\ntest/cosim/main.cpp:32:// Benchmark-time MMIO markers. CoreMark's portme.c writes to BENCH_START\ntest/cosim/main.cpp:70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\ntest/cosim/main.cpp:131:        //     allowed (markers); anything else outside dmem is OOB (handled\ntest/cosim/main.cpp:152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\ntest/cosim/main.cpp:253:        // Emit final record, plus an explicit completion marker. Consumers MUST\ntest/cosim/reference.py:3:discipline so cosim traces stay aligned across illegal / misaligned\ntest/cosim/reference.py:114:        write-side fields and force npc = pc + 4 so the trace stays in\n", "exit_code": 0, "status": "completed"}}
