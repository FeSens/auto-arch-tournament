{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python3 -B - <<'PY'\nimport sys, time, pickle, collections\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nm=RV32IM(); m.load_elf('/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep2/bench/programs/coremark.elf')\ntrace=[]; active=False; counts=collections.Counter(); start=time.monotonic()\nfor i in range(10000000):\n r=m.step()\n if r is None: break\n if r['mem_wmask'] and r['mem_addr']==0x10000100:\n  active=True\n if active: counts[r['insn']&127]+=1\n if (r['insn']&127) in (0x63,0x67,0x6f): trace.append((r['pc'],r['insn'],r['npc'],active))\n if r['mem_wmask'] and r['mem_addr']==0x10000104:\n  break\n if i and i%1000000==0: print('Retirements',i,'elapsed',round(time.monotonic()-start,1),flush=True)\nwith open('/srv/hwebench/tmp/9e6b10b9/c55739d5/branch_trace.pkl','wb') as f: pickle.dump(trace,f)\nprint('Total retirements',m.retired,'measured',sum(counts.values()),'OOB',m.oob_access,'elapsed',time.monotonic()-start)\nprint('Measured opcode counts',dict(counts))\nprint('Controls',len(trace),'measured',sum(x[3] for x in trace))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
