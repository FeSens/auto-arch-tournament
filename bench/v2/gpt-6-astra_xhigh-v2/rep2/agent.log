{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json,yaml,jsonschema\nlogs=[json.loads(s) for s in Path('cores/bench/experiments/log.jsonl').read_text().splitlines()]\nd=next(d for d in logs if d['id']=='hyp-20261001-003-r5s2')['hypothesis']\nd={'id':'hyp-20261001-003-r6s2','title':'Retain bimodal predictor history across reset on the address-isolated champion','category':'predictor',**d}\nd['motivation']='''The champion now includes the separate memory effective-address path and\nscores 129.31 iterations/s at 54.331 MHz with 4,201,709 bracketed cycles.\nPrior predictor work showed that larger direction tables have too little\naccuracy headroom to clear the threshold alone. The r5s2 reset-independent\ncounter experiment improved its older parent but lost to the effective-\naddress change. Reapply that one predictor change to the current champion,\nretaining its memory-address isolation and every other accepted change.\n\nA fresh isolated prototype has median Gowin Fmax 56.862 MHz across placement\noptions 52.998/56.862/56.862 MHz. Logic falls from 3,772 to 3,490 cells;\nFF remains 826 and LUT-RAM remains 8. This is reduced predictor reset logic\nand different physical implementation, not RAM inference. Expected\nunchanged cycles would give approximately 135.33 iterations/s, 4.66 percent\nabove the champion, narrowly above the required 4.6 percent.\n'''\ns=d['hypothesis']\na=s.index(\\\"The prototype's unchanged cycles\\\")\nb=s.index('Tests must distinguish',a)\ns=s[:a]+'''The current prototype uses exactly the original indexed training logic,\nwith configuration-time initialization and the runtime-reset guard replacing\nonly counter reset. Its measured median is 56.862 MHz; confirm unchanged\n4,201,709 cycles and every canonical stalled CoreMark check. Acceptance\nrequires more than 135.25826 iterations/s, or roughly 56.832 MHz at unchanged\ncycles. This margin is narrow and timing must be checked on the final RTL.\nDo not incorporate any recovery-stage or local-update experiments.\n\n'''+s[b:]\nd['hypothesis']=s\nd['expected_impact']={'fitness_delta_pct':5,'confidence':'medium'}\np=Path('cores/bench/experiments/hypotheses/hyp-20261001-003-r6s2.yaml')\np.write_text(yaml.safe_dump(d,sort_keys=False,width=85))\njsonschema.validate(d,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Written and validated persistent-table hypothesis')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
