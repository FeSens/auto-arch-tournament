{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nm=json.loads(Path('cores/bench/generated/recovery-cones.json').read_text())['modules']['core']\ncells=m['cells']; nets=m['netnames']; drivers={}\nfor name,cell in cells.items():\n    for port,direction in cell['port_directions'].items():\n        if direction=='output':\n            for bit in cell['connections'][port]:\n                drivers[bit]=(name,cell)\nlate={b for name in ('redirect','u_mem.branch_cond','u_mem.actual_taken') for b in nets[name]['bits']}\nfor signal in ('rs1_ex_match_q','rs2_ex_match_q','rs1_wb_match_q','rs2_wb_match_q'):\n    name='u_fwd.'+signal\n    q=nets[name]['bits'][0]; regname,reg=drivers[q]\n    assert 'dff' in reg['type'], (regname,reg['type'])\n    todo=list(reg['connections']['D']); visited=set()\n    while todo:\n        b=todo.pop()\n        if b in visited or not isinstance(b,int): continue\n        visited.add(b)\n        if b not in drivers: continue\n        _,cell=drivers[b]\n        if 'dff' in cell['type'] or 'mem' in cell['type']: continue\n        for port,direction in cell['port_directions'].items():\n            if direction=='input': todo.extend(cell['connections'][port])\n    assert not visited & late, (name,visited & late)\n    print(name, ': no MEM correction, condition or actual-taken in combinational D cone;',len(visited),'bits inspected')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
