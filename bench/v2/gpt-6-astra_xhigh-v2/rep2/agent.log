{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, subprocess\nfrom pathlib import Path\nrtl=Path('cores/bench/rtl'); gen=Path('cores/bench/generated')\nsources=[rtl/'core_pkg.sv']+sorted(p for p in rtl.glob('*.sv') if p.name\"'!='\"'core_pkg.sv')\nscript='read_verilog -sv -D YOSYS -Icores/bench/rtl '+' '.join(map(str,sources))+'; hierarchy -top core; proc; flatten; opt_clean; write_json cores/bench/generated/recovery-cones.json'\nwith (gen/'recovery-cones.log').open('w') as log:\n    subprocess.run(['yosys','-Q','-T','-p',script],stdout=log,stderr=subprocess.STDOUT,check=True)\nm=json.loads((gen/'recovery-cones.json').read_text())['modules']['core']; drivers={}\nfor name,cell in m['cells'].items():\n    for port,direction in cell['port_directions'].items():\n        if direction=='output':\n            for bit in cell['connections'][port]: drivers[bit]=(name,cell)\nlate={b for name in ('redirect','u_mem.branch_cond','u_mem.actual_taken') for b in m['netnames'][name]['bits']}\nreport=[]\nfor signal in ('rs1_ex_match_q','rs2_ex_match_q','rs1_wb_match_q','rs2_wb_match_q'):\n    name='u_fwd.'+signal\n    _,reg=drivers[m['netnames'][name]['bits'][0]]\n    assert 'dff' in reg['type']\n    todo=list(reg['connections']['D']); visited=set()\n    while todo:\n        bit=todo.pop()\n        if bit in visited or not isinstance(bit,int): continue\n        visited.add(bit)\n        if bit not in drivers: continue\n        _,cell=drivers[bit]\n        if 'dff' in cell['type'] or 'mem' in cell['type']: continue\n        for port,direction in cell['port_directions'].items():\n            if direction=='input': todo.extend(cell['connections'][port])\n    assert not visited & late, name\n    report.append({'register':name,'correction_in_cone':False,'condition_in_cone':False,'actual_taken_in_cone':False,'bits_examined':len(visited)})\n(gen/'recovery-cones-audit.json').write_text(json.dumps(report,indent=2))\nprint(json.dumps(report,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
