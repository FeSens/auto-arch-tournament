{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > /srv/hwebench/tmp/9e6b10b9/9b62f6a5/r7s2-control-profile.json\nimport subprocess,json,collections\np=subprocess.Popen(['cores/bench/obj_dir/cosim_sim','bench/programs/coremark.elf','50000000','--istall','--dstall'],stdout=subprocess.PIPE,text=True)\nactive=False\ncounts=collections.Counter()\ntables={n:{} for n in (8,16,32,64)}\nfor line in p.stdout:\n d=json.loads(line)\n if 'ebreak' in d: continue\n pc=d['pc_rdata']; ins=d['insn']; op=ins&127\n if d.get('mem_wmask') and d.get('mem_addr')==0x10000100: active=True\n if d.get('mem_wmask') and d.get('mem_addr')==0x10000104: active=False\n if active: counts['instructions']+=1\n if op==0x67:\n  actual=d['pc_wdata']\n  if active:\n   counts['jalr']+=1\n   counts['return' if ((ins>>7)&31)==0 and ((ins>>15)&31) in (1,5) else 'other_indirect']+=1\n  for n,t in tables.items():\n   i=(pc>>2)&(n-1)\n   if active and t.get(i)==(pc,actual): counts[f'btb_{n}_correct']+=1\n   t[i]=(pc,actual)\n if active and op==0x63: counts['branch']+=1\n if active and op==0x6f: counts['jal']+=1\nassert p.wait()==0\nprint(json.dumps(dict(counts),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
