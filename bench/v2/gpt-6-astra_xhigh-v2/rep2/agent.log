{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport subprocess\nimport tempfile\n\nrtl = Path('cores/bench/rtl').resolve()\nsource = (rtl / 'alu.sv').read_text()\nshift_start = source.index('  logic        [4:0]  shamt;')\nshift_end = source.index('  logic [31:0] div_result;', shift_start)\nshifter = source[shift_start:shift_end]\nresult_case = source[source.rindex('  always_comb begin'):]\nreference_case = result_case.replace('out = left_fine4;', 'out = a << b[4:0];', 1)\nreference_case = reference_case.replace('out = right_fine4;', 'out = a >> b[4:0];', 1)\nreference_case = reference_case.replace('out = right_fine4;', 'out = \"'$unsigned($signed(a) >>> b[4:0]);'\"', 1)\nassert reference_case \"'!= result_case\nheader = '\"'(input [4:0] op, input [31:0] a, b, mul_result, div_result, output logic [31:0] out);\\\\n'\nmiter = ('module actual' + header + shifter + result_case + '\\\\n'\n         + 'module reference' + header + reference_case + '\\\\n'\n         + '''module shift_miter(input [4:0] op, input [31:0] a, b,\n                              input [31:0] mul_result, div_result,\n                              output equivalent);\n  wire [31:0] actual_out, reference_out;\n  actual dut(op, a, b, mul_result, div_result, actual_out);\n  reference ref_alu(op, a, b, mul_result, div_result, reference_out);\n  assign equivalent = actual_out == reference_out;\nendmodule\n''')\n# Only sequential M-extension outputs are cut, identically in both cones.\n# The actual replacement network and result case are read verbatim from RTL.\nwork = Path(tempfile.mkdtemp(prefix='bench-shift-sat-', dir=os.environ['TMPDIR']))\n(work / 'miter.sv').write_text(miter)\nscript = (f'read_verilog -sv {rtl / \\\"core_pkg.sv\\\"} {work / \\\"miter.sv\\\"}; '\n          'prep -top shift_miter -flatten; '\n          'sat -verify -prove equivalent 1 -show-inputs')\nresult = subprocess.run(['yosys', '-p', script], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\n(work / 'proof.log').write_text(result.stdout)\nprint('Proof artifacts:', work)\nprint('\\\\n'.join(result.stdout.splitlines()[-24:]))\nraise SystemExit(result.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
