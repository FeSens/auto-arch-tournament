{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport os, re, subprocess, tempfile\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl').resolve()\nex = (rtl / 'ex_stage.sv').read_text()\nid_text = (rtl / 'id_stage.sv').read_text()\nold = subprocess.check_output(['git', 'show', 'HEAD:cores/bench/rtl/ex_stage.sv'], text=True)\ntree = ex[ex.index('  logic [31:1] branch_eq_tree'):ex.index('    branch_taken  =')]\nreference = old[old.index('    case (in.ctrl.branch_op)'):old.index('    branch_taken  =')]\nreference = reference.replace('in.ctrl.branch_op', 'dec_branch_op').replace('branch_cond', 'original')\nassigns = []\nfor name in ('branch_eq', 'branch_signed', 'branch_unsigned', 'branch_invert'):\n    value = re.search(r'reg_q\\\\.' + name + r'\\\\s*<=\\\\s*(.*?);', id_text, re.S).group(1)\n    assigns.append(f'assign in.{name} = {value};')\nsource = '''module branch_miter(input [31:0] rs1, rs2, input [2:0] dec_branch_op, output same);\nid_ex_t in;\nlogic branch_cond, original;\n''' + '\\\\n'.join(assigns) + '\\\\n' + tree + '\\\\nend\\\\nalways_comb begin\\\\n' + reference + '\\\\nend\\\\nassign same = branch_cond == original;\\\\nendmodule\\\\n'\nwith tempfile.TemporaryDirectory(prefix='branch-predecode-', dir=os.environ['TMPDIR']) as scratch:\n    miter = Path(scratch) / 'branch_miter.sv'\n    miter.write_text(source)\n    result = subprocess.run(['yosys', '-Q', '-T', '-p', f'read_verilog -sv {rtl / \\\"core_pkg.sv\\\"} {miter}; prep -top branch_miter; sat -verify -prove same 1 -show-inputs'], capture_output=True, text=True)\n    (Path(os.environ['TMPDIR']) / 'branch-predecode-sat.log').write_text(result.stdout + result.stderr)\n    print('\\\\n'.join(result.stdout.splitlines()[-20:]))\n    assert result.returncode == 0, result.stderr\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
