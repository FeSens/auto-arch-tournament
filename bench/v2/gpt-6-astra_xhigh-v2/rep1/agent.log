{"type":"item.started","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport json,subprocess\nfrom tools.eval.cosim import run_one,TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart,parse_iterations\np=Path('cores/bench/generated/radix8_probe')\nsim=str((p/'obj_dir/cosim_sim').resolve())\ncases=[(e,flags) for e in Path('bench/programs').glob('*.elf') if e.name\"'!='\"'coremark.elf' for flags in TRACE_STALL_MODES]\nwith ThreadPoolExecutor(max_workers=4) as pool:\n results=list(pool.map(lambda ef:run_one(ef[0].resolve(),sim,str(Path.cwd()),sim_flags=ef[1]),cases))\nfor r in results: print(json.dumps(r),flush=True)\nr=subprocess.run([sim,'bench/programs/coremark.elf','50000000','--bench','--istall','--dstall'],capture_output=True,text=True,timeout=180)\nprint('coremark_rc',r.returncode)\nmarker=json.loads(r.stdout.splitlines()[-1]); print(json.dumps(marker))\nprint('CRC',validate_coremark_uart(marker.get('uart',''),parse_iterations('.')))\n(p/'cosim_results.json').write_text(json.dumps({'trace':results,'coremark':marker,'coremark_rc':r.returncode},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
