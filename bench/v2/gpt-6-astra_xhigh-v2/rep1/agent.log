{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench')\ndst=Path('/srv/hwebench/tmp/867d4c2f/5300ad79/r13-carry')\ndst.mkdir(exist_ok=True)\nfor sub in ['rtl','test']:\n shutil.copytree(src/sub,dst/sub,dirs_exist_ok=True)\n(dst/'rtl/block_carry_adder.sv').write_text('''module block_carry_adder #(\n  parameter integer WIDTH = 32,\n  parameter integer BLOCK = WIDTH > 16 ? 8 : 4\n) (\n  input wire [WIDTH-1:0] a, b,\n  input wire carry_in,\n  output wire [WIDTH-1:0] sum,\n  output wire carry_out\n);\n  localparam integer COUNT = (WIDTH+BLOCK-1)/BLOCK;\n  localparam integer LEVELS = \"'$clog2(COUNT);\n  wire [COUNT-1:0] g [0:LEVELS];\n  wire [COUNT-1:0] p [0:LEVELS];\n  wire [COUNT:0] c;\n  assign c[0] = carry_in;\n  for (genvar i=0; i<COUNT; i++) begin : segment\n    localparam integer LO = i*BLOCK;\n    localparam integer BITS = (WIDTH-LO < BLOCK) ? WIDTH-LO : BLOCK;\n    wire [BITS:0] s0 = {1'\"'b0,a[LO+:BITS]} + {1'b0,b[LO+:BITS]};\n    wire [BITS:0] s1 = {1'b0,a[LO+:BITS]} + {1'b0,b[LO+:BITS]} + {{BITS{1'b0}},1'b1};\n    assign g[0][i] = s0[BITS];\n    assign p[0][i] = &(a[LO+:BITS] \"'^ b[LO+:BITS]);\n    assign c[i+1] = g[LEVELS][i] | (p[LEVELS][i] & carry_in);\n    assign sum[LO+:BITS] = c[i] ? s1[BITS-1:0] : s0[BITS-1:0];\n  end\n  for (genvar l=0; l<LEVELS; l++) begin : level\n    for (genvar i=0; i<COUNT; i++) begin : prefix\n      if (i >= (1<<l)) begin : combine\n        assign g[l+1][i] = g[l][i] | (p[l][i] & g[l][i-(1<<l)]);\n        assign p[l+1][i] = p[l][i] & p[l][i-(1<<l)];\n      end else begin : pass\n        assign g[l+1][i] = g[l][i];\n        assign p[l+1][i] = p[l][i];\n      end\n    end\n  end\n  assign carry_out = c[COUNT];\nendmodule\n'\"''')\np=dst/'rtl/alu.sv'; s=p.read_text(); pos=s.index('  always_comb begin')\ns=s[:pos]+'''  wire [31:0] add_result, sub_result;\n  wire sub_carry;\n  block_carry_adder u_add