{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/867d4c2f/4aca2877/branch_cmp_r9')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv'\ns=p.read_text()\nold='''  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n'\"'''\nnew='''  // Heap-indexed balanced lexicographic comparison tree. Low child\n  // holds the less-significant group; high child has precedence.\n  wire [31:1] compare_equal, compare_less;\n  for (genvar group = 0; group < 16; group++) begin : cmp_leaf\n    wire a1 = rs1[2*group+1];\n    wire a0 = rs1[2*group];\n    wire b1 = rs2[2*group+1];\n    wire b0 = rs2[2*group];\n    assign compare_equal[16+group] = ~(a1 \"'^ b1) & ~(a0 ''^ b0);\n    assign compare_less[16+group] = (~a1 & b1)\n                                    | (~(a1 ''^ b1) & ~a0 & b0);\n  end\n  for (genvar node = 1; node < 16; node++) begin : cmp_merge\n    assign compare_equal[node] = compare_equal[2*node+1] & compare_equal[2*node];\n    assign compare_less[node] = compare_less[2*node+1]\n                                | (compare_equal[2*node+1] & compare_less[2*node]);\n  end\n  wire compare_signed_less = (rs1[31] ''^ rs2[31]) ? rs1[31] : compare_less[1];\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = compare_equal[1];\n      BR_BNE:  branch_cond = !compare_equal[1];\n      BR_BLT:  branch_cond = compare_signed_less;\n      BR_BGE:  branch_cond = !compare_signed_less;\n      BR_BLTU: branch_cond = compare_less[1];\n      BR_BGEU: branch_cond = !compare_less[1];\n'\"'''\nassert s.count(old)==1\np.write_text(s.replace(old,new))\nprint('Prototype sources:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
