{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"sed -n '1090,1155p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\n@cocotb.test()\nasync def prediction_held_branches_and_divider_completion(dut):\n    program = [LW(1, 0, 512), SW(0, 0, 516), BEQ(1, 0, 8), ADDI(2, 1, 1),\n               DIV(3, 1, 1), BEQ(3, 0, 8), REM(4, 1, 1),\n               JAL(0, 8), 0xffffffff, EBREAK()]\n    for value in (0, 7):\n        for seed in range(8):\n            observations = []\n            await _checked_run(dut, program, prediction_check=True, seed=seed,\n                               initial_memory={512: value}, observations=observations)\n            if seed == 0:\n                assert observations[0].held_branches > 0\n    for seed in (None, 0, 7, 123):\n        await _checked_run(dut, _division_program(), prediction_check=True, seed=seed)\n\n\ndef _operand_program():\n    # The U-immediate's raw source fields deliberately alias x5. Raw RVFI\n    # still reads x5 while the ALU must select PC and the U-immediate.\n    auipc = (5 << 20) | (5 << 15) | (6 << 7) | 0x17\n    return [\n        ADDI(1, 0, 21), ADDI(1, 0, 35), ADD(2, 1, 1),  # two simultaneous matches\n        ADDI(0, 1, 7), ADD(3, 0, 0),                  # x0 never forwards\n        ADDI(5, 0, 9), auipc, ADDI(7, 5, 5),          # both ALU overrides\n        ADDI(8, 0, 512), ADDI(9, 0, 77), SW(9, 8, 0),\n        LW(10, 8, 0), ADD(11, 10, 10),                # both load-use sources\n        LW(12, 8, 0), SW(0, 8, 4), ADD(13, 12, 12),  # invalid-but-retained WB\n        ADDI(14, 0, 100), ADDI(15, 0, 7), DIV(16, 14, 15),\n        ADD(17, 16, 16), REM(18, 17, 15), SW(18, 8, 8),\n        ADDI(19, 0, 29), LW(19, 8, 2), ADD(20, 19, 19),  # load write suppressed\n        ADDI(21, 0, 31), JAL(21, 2), ADD(22, 21, 21),    # jump write suppressed\n        ADDI(23, 0, 2), JALR(21, 23, 0), ADD(24, 21, 21),\n        BEQ(24, 22, 8), ADDI(21, 0, 999), ADD(25, 21, 21),  # redirect squash\n        0xffffffff, ADDI(26, 25, 1), EBREAK(),\n    ]\n\n\n@cocotb.test()\nasync def operand_masks_youngest_writer_and_holds(dut):\n    coverage = set()\n    for seed in (None, 0, 7, 123):\n        observations = []\n        await _checked_run(dut, _operand_program(), seed=seed, operand_check=True,\n                           observations=observations)\n        coverage.update(observations[1].covered)\n    blocked = 0\n\n    def hold_retained_load(cycle, pc, ir, dr):\n        nonlocal blocked\n        if pc == 64 and blocked < 5:\n            blocked += 1\n            return ir, False\n        return ir, dr\n\n    observations = []\n    await _checked_run(dut, _operand_program(), operand_check=True,\n                       ready_fn=hold_retained_load, observations=observations)\n    coverage.update(observations[1].covered)\n    required = {\"youngest\", \"x0\", \"auipc_override\", \"immediate_override\",\n                \"retained_wb\", \"division_launch\", \"division_done\", \"division_consumer\",\n                \"flush\", \"trap_suppressed\"}\n    required.update((source, mask) for source in (15, 20) for mask in (1, 2, 4))\n    assert coverage >= required, f\"missing operand coverage: {required - coverage}\"\n\n\n","exit_code":0,"status":"completed"}}
