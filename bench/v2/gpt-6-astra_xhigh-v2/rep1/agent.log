{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c \"rg -n 'divisor_q|triple|quotient_bank|prefix|runner' cores/bench/test/test_div_unit.py\"","aggregated_output":"10:from cocotb_tools.runner import get_runner\n57:    \"\"\"Independent prefix division checks capture, all edges, and frozen completion.\"\"\"\n65:    prefix = dividend >> (32 - consumed)\n66:    q, r = divmod(prefix, divisor) if divisor else ((1 << consumed) - 1, prefix)\n67:    assert int(dut.divisor_q.value) == divisor\n71:        assert int(dut.triple_divisor_q.value) == 3 * divisor\n168:    # Every two-bit launch prefix, including D=0 and the D>=4 bypass.\n169:    for prefix in range(4):\n172:                pairs.add(((prefix << 30) | tail, divisor))\n174:    # Straddle every bank's prefix bound; high dividend prefixes exercise\n183:    # Put trial prefixes immediately below, at and above all radix-4\n193:                    prefix = digit * divisor + delta\n194:                    if 0 <= prefix <= limit:\n196:                            pairs.add(((prefix << (32 - bits)) | tail, divisor))\n251:def test_div_unit_runner(altops):\n252:    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n254:    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n258:    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n","exit_code":0,"status":"completed"}}
