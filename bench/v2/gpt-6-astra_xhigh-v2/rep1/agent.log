{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"rg -n 'iterations|bench_cycles|cycle|markers|parse_iterations' tools/eval/fpga.py; ls cores/bench/test/*.result.xml\"","aggregated_output":"1:\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n83:def parse_iterations(worktree: str) -> int:\n204:    \"\"\"Run CoreMark on Verilator sim, return {iter_per_cycle, completed, cycles, iterations}.\n206:    benchmark hit maxcycles without completing and the cycle count is meaningless.\"\"\"\n211:    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n212:    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n219:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n223:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n226:    # Last line is the ebreak/maxcycles marker; second-to-last is the final retirement.\n231:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n235:        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n236:        # a hung CPU with whatever cycle count it happened to reach.\n237:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n238:                'reason': 'maxcycles_hit_before_ebreak'}\n241:    # point during this run, the cycle count we're about to divide by is tainted\n246:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n250:    iterations = parse_iterations(worktree)\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n258:    # If both markers aren't present, the run is INVALID for fitness\n263:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n264:                'reason': f'bench_markers_missing: '\n265:                          f'start={marker.get(\"bench_start_cycle\")} '\n266:                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n268:    if elapsed_cycles <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n280:    \"\"\"Require CoreMark's own validation and exact expected CRC markers,\n301:    reported_iterations = _uart_int(uart, r'Iterations\\s*:\\s*(\\d+)')\n302:    if reported_iterations != iterations:\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n341:        'ipc_coremark': float,           — iter/cycle\n342:        'fitness': float,                — iter/sec = fmax_hz * iter/cycle\n343:        'cycles': int, 'iterations': int,\n382:    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n387:        'cycles':        cm['cycles'],\n388:        'iterations':    cm['iterations'],\ncores/bench/test/test_alu_runner.result.xml\ncores/bench/test/test_decoder_runner.result.xml\ncores/bench/test/test_div_unit_runner[False].result.xml\ncores/bench/test/test_div_unit_runner[True].result.xml\ncores/bench/test/test_imm_gen_runner.result.xml\n","exit_code":0,"status":"completed"}}
