{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pickle,collections\ntrace=pickle.load(open('/srv/hwebench/tmp/867d4c2f/89db00f9/predictor-control-trace.pkl','rb'))\nbranches=[(pc,ins,(npc\"'!=pc+4),bool(ins>>31)) for pc,ins,npc in trace if ins&127==0x63]\nprint('\"'conditional branches',len(branches),'taken',sum(t for _,_,t,_ in branches))\nfor size in [16,32,64,128,256,512,1024]:\n c=[2]*size; misses=0; sites=collections.Counter()\n for pc,ins,t,bias in branches:\n  i=(pc>>2)&(size-1); miss=((c[i]>>1==bias)\"'!=t); misses+=miss; sites[pc]+=miss\n  c[i]=min(3,c[i]+1) if t==bias else max(0,c[i]-1)\n print('\"'agree',size,'misses',misses,'worst',[(hex(pc),n) for pc,n in sites.most_common(8)])\nfor size in [64,128,256,512,1024]:\n for hist_bits in [3,5,7,9]:\n  for agree in [False,True]:\n   c=[2]*size; h=0; misses=0\n   for pc,ins,t,bias in branches:\n    i=((pc>>2)\"'^h)&(size-1); pred=(c[i]>>1==bias) if agree else bool(c[i]>>1); misses+=pred!=t\n    val=(t==bias) if agree else t\n    c[i]=min(3,c[i]+1) if val else max(0,c[i]-1)\n    h=((h<<1)|t)&((1<<hist_bits)-1)\n   print('\"'gshare',size,hist_bits,agree,misses)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
