{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport re, json\nfrom pathlib import Path\nfrom collections import Counter\npath = Path('cores/bench/generated/netlist-inspection/impl/pnr/core_bench.vo')\ns = path.read_text()\ndef net(s):\n    return ''.join(s.strip().lstrip('\\\\\\\\').split())\ncells = {}\ndrivers = {}\nfor m in re.finditer(r'\"'^('\"\\\\w+)\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s+\\\\((.*?)\\\\n\\\\);', s, re.M | re.S):\n    kind, name, body = m.groups()\n    name = net(name)\n    ports = {p: net(n) for p,n in re.findall(r'\\\\.(\\\\w+)\\\\((.*?)\\\\)', body)}\n    cells[name] = (kind, ports)\n    for p in ('F', 'O', 'Q', 'SUM', 'COUT'):\n        if p in ports:\n            assert ports[p] not in drivers, (ports[p], name)\n            drivers[ports[p]] = name\n\ndef cone(target):\n    todo = [target]\n    seen, leaves, used = set(), set(), set()\n    while todo:\n        n = todo.pop()\n        if n in seen:\n            continue\n        seen.add(n)\n        name = drivers.get(n)\n        if name is None:\n            leaves.add(n)\n            continue\n        kind, ports = cells[name]\n        if not (kind.startswith('LUT') or kind.startswith('MUX2') or kind == 'ALU'):\n            leaves.add(n)\n            continue\n        used.add(name)\n        todo.extend(v for p,v in ports.items() if p not in ('F', 'O', 'SUM', 'COUT'))\n    return seen, leaves, used\nprint('Primitive instances:', Counter(k for k,p in cells.values()))\nsummary = {}\nfor target in ('cpu/raw_rs1_mask_1_3', 'cpu/raw_rs1_mask[1]', 'cpu/raw_rs2_mask[1]', 'cpu/raw_rs1_mask[2]', 'cpu/raw_rs2_mask[2]'):\n    seen, leaves, used = cone(target)\n    assert len(used) > 10, 'incomplete cone'\n    forbidden = [n for n in seen if 'ctrl.is_branch' in n or 'ctrl.branch_op' in n or re.search(r'(?:/rs2|rs2_val)\\\\[', n)]\n    assert not forbidden, (target, forbidden)\n    high_rs1 = [n for n in seen if re.search(r'(?:/rs1|rs1_val)\\\\[(?:[2-9]|[12][0-9]|3[01])\\\\]', n)]\n    assert not high_rs1, (target, high_rs1)\n    summary[target] = {'combinational_cells': len(used), 'leaves': sorted(leaves), 'no_branch_controls_or_rs2': True, 'no_rs1_bits_above_1': True}\n    print(target, len(used), 'cells;', len(leaves), 'leaves; no branch control/rs2/high rs1 dependencies')\nprint('Qualification leaves:', summary['cpu/raw_rs1_mask_1_3']['leaves'])\nseen, leaves, used = cone('cpu/raw_rs1_mask_1_3')\nprint('Qualification cells:', sorted(used))\nPath('cores/bench/generated/netlist-cone-local.json').write_text(json.dumps(summary, indent=2) + '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
