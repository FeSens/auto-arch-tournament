under cores/<TARGET>/test/\"\nMakefile:79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\nMakefile:80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\nMakefile:81:\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\nMakefile:82:\t@e\n…[1520 of 4592 chars elided by tools/bench/transcript.py; sha256:5d5b6f7c85a733f2]…\nsim_build\ntools/eval/gowin.py:22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\ntools/eval/gowin.py:33:def gowin_env(base: dict | None, workdir: Path) -> dict:\ntools/eval/gowin.py:121:        \"lutram\": _cells(r, \"--SSRAM(RAM16)\") or 0,\ntools/eval/gowin.py:158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\ntools/eval/gowin.py:173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\ntools/eval/gowin.py:175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\ntools/eval/gowin.py:200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\ntools/eval/gowin.py:206:    ap.add_argument(\"--worktree\", default=\".\")\ntools/eval/gowin.py:207:    ap.add_argument(\"--paths\", type=int, default=5)\ntools/eval/gowin.py:208:    ap.add_argument(\"--all-options\", action=\"store_true\",\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cat tools/eval/_slots.py\nsed -n '1,160p' cores/bench/test/_helpers.py\ncommand -v yosys\ncommand -v verilator\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"cat tools/eval/_slots.py\nsed -n '1,160p' cores/bench/test/_helpers.py\ncommand -v yosys\ncommand -v verilator\"", "aggregated_output": "\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/867d4c2f/fff86200/r14-alu-prefix')\nroot.mkdir(exist_ok=True)\nshutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',root/'test',dirs_exist_ok=True)\np=root/'rtl/alu.sv'\ns=p.read_text()\nnetwork='''\n  wire sub = op == ALU_SUB;\n  wire [31:0] bx = b \"'^ {32{sub}};\n  wire [31:0] bit_p = a ''^ bx;\n  wire [31:0] bit_g = a & bx;\n  wire [7:0] group_p [0:3];\n  wire [7:0] group_g [0:3];\n  wire [31:0] addsub;\n  for (genvar k=0; k<8; k++) begin : block_pg\n    wire [3:0] p = bit_p[4*k+:4];\n    wire [3:0] g = bit_g[4*k+:4];\n    assign group_p[0][k] = &p;\n    assign group_g[0][k] = g[3] | (p[3]&g[2])\n                         | (p[3]&p[2]&g[1]) | (p[3]&p[2]&p[1]&g[0]);\n    wire cin;\n    if (k==0) assign cin = sub;\n    else assign cin = group_g[3][k-1] | (group_p[3][k-1] & sub);\n    assign addsub[4*k+:4] = a[4*k+:4] + bx[4*k+:4] + {3'\"'b0,cin};\n  end\n  for (genvar level=0; level<3; level++) begin : prefix\n    for (genvar k=0; k<8; k++) begin : col\n      if (k >= (1<<level)) begin : combine\n        assign group_g[level+1][k] = group_g[level][k]\n                    | (group_p[level][k] & group_g[level][k-(1<<level)]);\n        assign group_p[level+1][k] = group_p[level][k] & group_p[level][k-(1<<level)];\n      end else begin : pass\n        assign group_g[level+1][k] = group_g[level][k];\n        assign group_p[level+1][k] = group_p[level][k];\n      end\n    end\n  end\n'''\ns=s.replace('  logic        [4:0]  shamt;',network+'\\\\n  logic        [4:0]  shamt;')\ns=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = addsub;').replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = addsub;')\np.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
