{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,subprocess\nprobe=Path('cores/bench/generated/r13_front').resolve(); src=Path('/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal'); base=probe/'formal_root'; stage=base/'cores/probe'; stage.mkdir(parents=True,exist_ok=True)\nfor p in src.iterdir():\n if p.is_dir() and p.name not in ('cores','.git','.agents','.codex'):\n  dest=base/p.name\n  if not dest.exists():dest.symlink_to(p,target_is_directory=True)\nfor p in (probe/'rtl').glob('*.sv'):shutil.copy2(p,stage/p.name)\nshutil.copy2('formal/wrapper_si.sv',stage/'wrapper.sv')\ncfg=Path('formal/checks_si.cfg').read_text().split('[verilog-files]')[0]\nfiles=['core_pkg.sv']+[p.name for p in sorted((probe/'rtl').glob('*.sv')) if p.name\"'!='\"'core_pkg.sv']+['wrapper.sv']\n(stage/'checks.cfg').write_text(cfg+'[verilog-files]\\\\n'+'\\\\n'.join('@basedir@/cores/@core@/'+f for f in files)+'\\\\n')\nwith (probe/'formal.log').open('w') as f:\n subprocess.run(['python3',str(src/'checks/genchecks.py')],cwd=stage,check=True,stdout=f,stderr=subprocess.STDOUT)\n r=subprocess.run(['make','-j8','-k','-f','makefile'],cwd=stage/'checks',stdout=f,stderr=subprocess.STDOUT)\nstatuses={p.parent.name:p.read_text().strip() for p in (stage/'checks').glob('*/status')}\nprint('formal returncode',r.returncode,'checks',len(statuses)); print(statuses)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
