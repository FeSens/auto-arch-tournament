{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"sed -n '516,570p' cores/bench/test/test_pipeline.py\"","aggregated_output":"        target = (pc + (_jump_offset(insn) if opcode == 0x6f else _branch_offset(insn))) & 0xffffffff\n        bias_taken = _branch_offset(insn) < 0\n        agrees = self.counters[(pc >> 2) & 63] >= 2\n        prediction = not (target & 3) and (opcode == 0x6f or (branch and agrees == bias_taken))\n        assert int(dut.u_if.predicted_taken.value) == prediction, (pc, insn, self.counters)\n        assert (int(dut.u_if.out.value) >> 2) & 0xffffffff == insn, \"recovery changed raw fetch data\"\n        assert int(dut.u_hazard.if_id_rs1.value) == (insn >> 15) & 31\n        assert int(dut.u_hazard.if_id_rs2.value) == (insn >> 20) & 31\n        self.check_table(dut)\n        bundle = int(dut.u_id.reg_q.value)\n        assert bool(bundle & 1) == (self.ex_slot is not None)\n        assert bool(bundle & 2) == (self.ex_slot is not None and self.ex_slot[2])\n        hold = bool(int(dut.stall_ex_mem.value) or int(dut.execute_busy.value))\n        recover, train, taken = False, False, False\n        ex = None\n        if self.ex_slot is not None and self.index < len(self.expected):\n            ex = self.expected[self.index]\n            assert self.ex_slot[:2] == (ex[\"pc_rdata\"], ex[\"insn\"])\n            op, f3 = ex[\"insn\"] & 127, (ex[\"insn\"] >> 12) & 7\n            legal_branch = op == 0x63 and f3 in (0, 1, 4, 5, 6, 7)\n            taken = not ex[\"trap\"] and (op in (0x6f, 0x67) or\n                    (legal_branch and _branch_condition(f3, ex[\"rs1_rdata\"], ex[\"rs2_rdata\"])))\n            train = not hold and legal_branch and not ex[\"trap\"]\n            recover = not hold and taken != self.ex_slot[2]\n            if hold and legal_branch:\n                self.held_branches += 1\n        assert int(dut.redirect.value) == recover, (cycle, self.ex_slot, ex)\n        assert int(dut.train_valid.value) == train, (cycle, self.ex_slot, hold)\n        if int(dut.u_ex.div_start.value):\n            assert ex is not None and ex[\"insn\"] & 0x7f == 0x33\n            assert ex[\"insn\"] >> 25 == 1 and ((ex[\"insn\"] >> 12) & 7) >= 4\n            self.divisions += 1\n            assert self.div_launch_cycle is None, \"divider relaunched before acceptance\"\n            self.div_launch_cycle = cycle\n            self.div_completion_seen = False\n        if int(dut.u_ex.div_done.value):\n            assert self.div_launch_cycle is not None\n            if not self.div_completion_seen:\n                assert cycle - self.div_launch_cycle == 8, \"DIV/REM EX occupancy changed\"\n                self.div_completion_seen = True\n            if not int(dut.stall_ex_mem.value):\n                self.div_launch_cycle = None\n        if self.ex_slot is None:\n            assert not int(dut.execute_busy.value), \"invalid DIV payload launched\"\n        if recover:\n            assert int(dut.redirect_target.value) == ex[\"pc_wdata\"]\n            self.recoveries.append((ex[\"pc_rdata\"], taken, cycle))\n            self.stalled_recoveries += int(not iready)\n        if train:\n            index = (ex[\"pc_rdata\"] >> 2) & 63\n            agree = taken == (_branch_offset(ex[\"insn\"]) < 0)\n            assert len(dut.train_index) == 6\n            assert int(dut.train_index.value) == index\n            assert int(dut.train_agree.value) == agree\n            self.same_index += int(index == ((pc >> 2) & 63))\n","exit_code":0,"status":"completed"}}
