{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY' > \\\"\"'$TMPDIR/split-coremark-full-rvfi.log\" 2>&1\nimport json\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\nsys.path.insert(0, str(Path('\"'test/cosim').resolve()))\nfrom reference import RV32IM\nfrom run_cosim import compare\ncpu = RV32IM()\ncpu.load_elf('bench/programs/coremark.elf')\nstart = time.monotonic()\ncount = 0\ncompleted = False\nwith subprocess.Popen(['cores/bench/obj_dir/cosim_sim', 'bench/programs/coremark.elf', '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE, text=True) as proc:\n    for line in proc.stdout:\n        sim = json.loads(line)\n        ref = cpu.step()\n        assert ref is not None, ('reference stopped', count)\n        result = compare([ref], [sim])\n        assert result['passed'], (count, result)\n        count += 1\n        if count % 250000 == 0:\n            print(f'{count} full RVFI retirements checked in {time.monotonic()-start:.1f}s', flush=True)\n        if ref['insn'] == 0x00100073:\n            completed = True\n            assert not proc.stdout.read().strip(), 'unexpected retirement after EBREAK'\n            break\n    assert proc.wait() == 0\nassert completed and not cpu.oob_access\nprint(json.dumps(dict(passed=True, retired=count, seconds=time.monotonic()-start, full_rvfi=True, istall=True, dstall=True)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
