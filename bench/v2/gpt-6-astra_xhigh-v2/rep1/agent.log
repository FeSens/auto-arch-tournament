d (seed is None or rng.randrange(100) >= 22)\n        dready = not store_wait and (seed is None or rng.randrange(100) >= 22)\n        pc = int(dut.io_imemAddr.value)\n        if ready_fn is not None:\n            iready, dready = ready_fn(cycle, pc, iready, dready)\n        dut.io_imemRea\n…[3477 of 6549 chars elided by tools/bench/transcript.py; sha256:47fdd6ae772b1834]…\n         assert not int(dut.redirect.value), \"reset failed to suppress recovery\"\n            dut.clock.value = 1\n            await Timer(5, \"ns\")\n            monitor.counters = [2] * 64\n            monitor.check_table(dut)\n            assert int(dut.io_imemAddr.value) == 0\n            assert not int(dut.u_id.reg_q.value) & 3\n            assert not int(dut.io_rvfi_valid_0.value)\n            return None\n        if operands is not None:\n            operands.before_edge(dut, insn)\n        if monitor is not None:\n            monitor.before_edge(dut, pc, insn, iready, cycle)\n        dut.clock.value = 1\n        await Timer(6, \"ns\")\n        if monitor is not None:\n            monitor.after_edge(dut)\n        if operands is not None:\n            operands.after_edge(dut)\n    raise AssertionError(\"pipeline did not terminate\")\n\n\n@cocotb.test()\nasync def division_dependencies_and_retirement_bound(dut):\n    cycles = await _checked_run(dut, _division_program())\n    assert max(b - a for a, b in zip(cycles, cycles[1:])) == 10\n", "exit_code": 0, "status": "completed"}}
