{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"rg -n 'hold|reset|x0|w_en' cores/bench/test/test_reg_file.py\"","aggregated_output":"1:\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\n2:bypass, and the synchronous-reset-clears-all property.\"\"\"\n12:async def _reset(dut):\n13:    dut.reset.value    = 1\n14:    dut.w_en.value     = 0\n21:    dut.reset.value = 0\n26:    dut.w_en.value   = 1\n30:    dut.w_en.value = 0\n41:async def reset_clears_all(dut):\n43:    await _reset(dut)\n46:        assert rs1 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n52:    await _reset(dut)\n60:async def x0_hardwired(dut):\n62:    await _reset(dut)\n72:    await _reset(dut)\n76:    dut.w_en.value     = 1\n81:    dut.w_en.value = 0\n87:    await _reset(dut)\n","exit_code":0,"status":"completed"}}
