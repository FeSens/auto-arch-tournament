e(dut)\n        bundle = int(dut.u_id.reg_q.value)\n        assert bool(bundle & 1) == (self.ex_slot is not None)\n        assert bool(bundle & 2) == (self.ex_slot is not None and self.ex_slot[2])\n        hold = bool(int(dut.stall_ex_mem.value) or int(dut.execute_busy.value))\n\n…[15624 of 18696 chars elided by tools/bench/transcript.py; sha256:1510a6279bfcfdc4]…\n held_mem_wb = int(dut.u_mem.reg_q.value) & ~1 if held_ex_mem is not None else None\n        dut.clock.value = 1\n        await Timer(6, \"ns\")\n        if held_ex_mem is not None:\n            assert int(dut.u_ex.reg_q.value) == held_ex_mem, \"backpressure changed EX/MEM partials or metadata\"\n            assert int(dut.u_mem.reg_q.value) == held_mem_wb, \"backpressure changed retained WB data or replayed valid\"\n        if monitor is not None:\n            monitor.after_edge(dut)\n        if operands is not None:\n            operands.after_edge(dut)\n    raise AssertionError(\"pipeline did not terminate\")\n\n\n@cocotb.test()\nasync def division_dependencies_and_retirement_bound(dut):\n    cycles = await _checked_run(dut, _division_program())\n    assert max(b - a for a, b in zip(cycles, cycles[1:])) == 10\n\n\n@cocotb.test()\nasync def division_with_both_bus_stalls(dut):\n    for seed in range(12):\n        await _checked_run(dut, _division_program(), seed=seed)\n\n\n@cocotb.test()\nasync def division_retirement_timing_unchanged(dut):\n", "exit_code": 0, "status": "completed"}}
