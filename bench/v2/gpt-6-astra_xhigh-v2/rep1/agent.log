{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/867d4c2f/9a141926/prefix_probe')\nfor sub in ('rtl','test'):shutil.copytree(Path('cores/bench')/sub,p/sub,dirs_exist_ok=True)\nf=p/'rtl/div_unit.sv';s=f.read_text()\na=s.index('  for (genvar p = 0; p < 7; p++) begin : phase')\nb=s.index('\\\\n  always_comb begin\\\\n    magnitude',a)\ns=s[:a]+'''  for (genvar p = 0; p < 7; p++) begin : phase\n    localparam integer C = p == 0 ? 2 : 4 + 4*p;\n    localparam integer N = p == 0 ? 6 : 4;\n    localparam integer P = C + N;\n    localparam integer DIGITS = N / 2;\n    wire large_d;\n    wire [31:0] qstep [0:DIGITS];\n    wire [31:0] rstep [0:DIGITS];\n    if (P < 32) assign large_d = |divisor_q[31:P];\n    else assign large_d = 1'b0;\n    assign qstep[0] = quotient_bank[p];\n    assign rstep[0] = 32'(remainder_bank[p][C-1:0]);\n    for (genvar digit = 0; digit < DIGITS; digit++) begin : radix4\n      localparam integer T = C + 2*(digit+1);\n      wire high_d;\n      wire [T-1:0] trial = {rstep[digit][T-3:0], qstep[digit][31:30]};\n      wire [T+1:0] d1 = {2'b0, divisor_q[T-1:0]};\n      wire [T+1:0] d2 = d1 << 1;\n      wire [T+1:0] d3;\n      if (T < 32) assign high_d = |divisor_q[31:T];\n      else assign high_d = 1'b0;\n      if (p == 0) assign d3 = d1 + d2;\n      else assign d3 = triple_divisor_q[T+1:0];\n      wire [T:0] diff1 = {1'b0,trial} - {1'b0,d1[T-1:0]};\n      wire [T:0] diff2 = {1'b0,trial} - {1'b0,d2[T-1:0]};\n      wire [T:0] diff3 = {1'b0,trial} - {1'b0,d3[T-1:0]};\n      wire borrow1 = high_d || diff1[T];\n      wire borrow2 = high_d || (|d2[T+1:T]) || diff2[T];\n      wire borrow3 = high_d || (|d3[T+1:T]) || diff3[T];\n      wire take3 = \"'!borrow3;\n      wire take2 = borrow3 && !borrow2;\n      wire take1 = borrow2 && !borrow1;\n      wire take0 = borrow1;\n      wire [T-1:0] remainder_next = (diff3[T-1:0] & {T{take3}})\n                           | (diff2[T-1:0] & {T{take2}})\n                           | (diff1[T-1:0] & {T{take1}})\n                           | (trial & {T{take0}});\n      assign rstep[digit+1] = 32'\"'(remainder_next);\n      assign qstep[digit+1] = {qstep[digit][29:0], \"'!borrow2, take3 | take1};\n    end\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        quotient_bank[p+1] <= 32'\"'b0;\n        remainder_bank[p+1] <= 32'b0;\n      end else if (active_q && \"'!complete_q && iteration_q == 3'\"'(p)) begin\n        quotient_bank[p+1] <= large_d ? quotient_bank[p] << N : qstep[DIGITS];\n        remainder_bank[p+1] <= large_d\n                              ? (remainder_bank[p] << N) | (quotient_bank[p] >> (32-N))\n                              : rstep[DIGITS];\n      end\n    end\n  end\n''' +s[b:]\nf.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
