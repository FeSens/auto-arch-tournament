{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '480,630p' cores/bench/test/test_pipeline.py; sed -n '685,850p' cores/bench/test/test_pipeline.py; sed -n '930,1150p' cores/bench/test/test_pipeline.py; sed -n '1340,1415p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "def _branch_condition(funct3, a, b):\n    sa, sb = a - (1 << 32) if a >> 31 else a, b - (1 << 32) if b >> 31 else b\n    return {0: a == b, 1: a != b, 4: sa < sb, 5: sa >= sb,\n            6: a < b, 7: a >= b}.get(funct3, False)\n\n\nclass _PredictionMonitor:\n    \"\"\"Cycle-level acceptance/table oracle, independent of DUT counter state.\n\n    RVFI is checked separately against the sequential reference. This also\n    observes events that could be hidden by eventual architectural recovery:\n    speculative memory requests, divider launches and repeated training.\n    \"\"\"\n    def __init__(self, expected):\n        self.expected = expected\n        self.counters = [2] * 64\n        self.ex_slot = None\n        self.index = 0\n        self.trainings, self.recoveries, self.fetches = [], [], []\n        self.divisions = 0\n        self.div_launch_cycle = None\n        self.div_completion_seen = False\n        self.same_index = 0\n        self.held_branches = 0\n        self.stalled_recoveries = 0\n        self.transitions, self.collisions = [], []\n\n    def check_table(self, dut):\n        assert len(dut.u_if.agreements) == 64\n        assert int(dut.u_if.agreements.value) == sum((c >> 1) << i for i, c in enumerate(self.counters))\n        for i, counter in enumerate(self.counters):\n            assert int(dut.u_if.agree[i].counter.value) == counter, (i, counter)\n\n    def before_edge(self, dut, pc, insn, iready, cycle):\n        opcode, funct3 = insn & 127, (insn >> 12) & 7\n        branch = opcode == 0x63 and funct3 in (0, 1, 4, 5, 6, 7)\n        target = (pc + (_jump_offset(insn) if opcode == 0x6f else _branch_offset(insn))) & 0xffffffff\n        bias_taken = _branch_offset(insn) < 0\n        agrees = self.counters[(pc >> 2) & 63] >= 2\n        prediction = not (target & 3) and (opcode == 0x6f or (branch and agrees == bias_taken))\n        assert int(dut.u_if.predicted_taken.value) == prediction, (pc, insn, self.counters)\n        assert (int(dut.u_if.out.value) >> 2) & 0xffffffff == insn, \"recovery changed raw fetch data\"\n        assert int(dut.u_haza\n…[25918 of 28990 chars elided by tools/bench/transcript.py; sha256:51e7694d29bac145]…\n\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\n\ndef test_multiply_altops_pipeline_runner():\n    \"\"\"The formal substitute must obey the same tested dependency schedule.\"\"\"\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"core_multiply_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\"] + sorted(\n                     p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\"),\n                 hdl_toplevel=\"core\", build_dir=str(build), always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1})\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=\"multiply_\", test_dir=str(TEST_DIR), build_dir=str(build),\n                extra_env={\"PIPELINE_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
