{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport re\nimport subprocess\nfrom pathlib import Path\np = 'cores/bench/rtl/alu.sv'\nold = subprocess.check_output(['git', 'show', 'HEAD:' + p], text=True)\nnew = Path(p).read_text()\ndef altops(text):\n    return text.split('\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n', 1)[1].split('\"'`else'\"', 1)[0]\nassert altops(old) == altops(new)\nfor line in old.splitlines():\n    if 'mul_ss =' in line or 'mul_uu =' in line or 'mul_su =' in line:\n        assert line in new\ncode = re.sub(r'/\\\\*.*?\\\\*/|//[\"'^'\"\\\\n]*', '', new, flags=re.S)\nassert '/' not in code and '%' not in code\nfor line in code.splitlines():\n    if '*' in line:\n        assert any(name in line for name in ('mul_ss =', 'mul_uu =', 'mul_su =', 'step'))\nprint('ALTOPS formulas and multiplier expressions unchanged; no division, modulo, or reconstruction multiplier.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
