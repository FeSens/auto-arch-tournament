{"type": "item.started", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,yaml,json,jsonschema\nbase=Path('/srv/hwebench/tmp/867d4c2f/1f06f49f/predictor_profile')\np=base/'three'; shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\ns=(base/'parallel/rtl/ex_stage.sv').read_text()\na=s.index('  wire [31:0] branch_rs1_candidates'); b=s.index('  always_comb begin\\\\n    branch_cond = |selected_branch_predicates;',a)\nblock='''  wire [31:0] branch_rs1_candidates [0:2];\n  wire [2:0] selected_branch_predicates;\n  assign branch_rs1_candidates[0] = in.rs1_val;\n  assign branch_rs1_candidates[1] = fwd_ex_mem;\n  assign branch_rs1_candidates[2] = fwd_mem_wb;\n  for (genvar lhs = 0; lhs < 3; lhs++) begin : branch_lhs\n      wire equal = branch_rs1_candidates[lhs] == rs2;\n      wire less_unsigned = branch_rs1_candidates[lhs] < rs2;\n      wire less_signed = (branch_rs1_candidates[lhs][31] \"'^ rs2[31])\n                         ? branch_rs1_candidates[lhs][31] : less_unsigned;\n      logic predicate;\n      always_comb begin\n        case (in.ctrl.branch_op)\n          BR_BEQ: predicate = equal;\n          BR_BNE: predicate = !equal;\n          BR_BLT: predicate = less_signed;\n          BR_BGE: predicate = !less_signed;\n          BR_BLTU: predicate = less_unsigned;\n          BR_BGEU: predicate = !less_unsigned;\n          default: predicate = 1'\"'b0;\n        endcase\n      end\n      assign selected_branch_predicates[lhs] = predicate && in.raw_rs1_mask[lhs];\n  end\n\n'''\ns=s[:a]+block+s[b:];(p/'rtl/ex_stage.sv').write_text(s)\n# Reuse the independent miter with the new extracted comparison network.\nproof=(base/'parallel/prove_branch.sv').read_text(); a=proof.index('  wire [31:0] branch_rs1_candidates'); b=proof.index('wire [31:0] rs1=',a)\nfor k,v in {'in.rs1_val':'a','in.ctrl.branch_op':'op','in.raw_rs1_mask':'ma'}.items(): block=block.replace(k,v)\nproof=proof[:a]+block+proof[b:];(p/'prove_branch.sv').write_text(proof)\nshutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\npth=Path('cores/bench/experiments/hypotheses/hyp-20261001-003-r10s2.yaml'); d=yaml.safe_load(pth.read_text())\nd['title']='Three-way branch-predicate selection for faster predictor recovery'\nd['hypothesis']=d['hypothesis'].replace('Define the three rs1 candidates as in.rs1_val, fwd_ex_mem, fwd_mem_wb and the three rs2 candidates as in.rs2_val, fwd_ex_mem, fwd_mem_wb. Evaluate the decoded branch condition independently for every candidate pair before forwarding selection. Pair (i,j) is selected by in.raw_rs1_mask[i] AND in.raw_rs2_mask[j]. OR the nine pair outcomes masked by those enables to produce branch_cond. The existing one-hot masks retain younger-producer priority and choose exactly one pair for a valid instruction. Compare the original sources directly; never feed these predicate units from the already-muxed rs1/rs2 buses.', 'Define three rs1 candidates: in.rs1_val, fwd_ex_mem and fwd_mem_wb. Compare each candidate against the EXISTING fully forwarded rs2 bus in parallel. Select the three decoded one-bit branch outcomes with in.raw_rs1_mask[0], [1] and [2], then OR them to produce branch_cond. The existing registered one-hot mask retains younger-producer priority and selects exactly one result for a valid instruction. Do not feed these predicate units from the already-muxed rs1 bus. Preserve rs2 forwarding without modification. Use exactly three predicate units, not a nine-pair network, to bound operand fanout and comparator area.')\nd['hypothesis']=d['hypothesis'].replace('Same-source EX/MEM-versus-EX/MEM and MEM/WB-versus-MEM/WB comparisons are constant equal and not-less; allow synthesis to fold them. ', '')\nd['hypothesis']=d['hypothesis'].replace('Each pair evaluates','Each candidate comparison evaluates').replace('once per pair','once per candidate comparison')\nd['hypothesis']=d['hypothesis'].replace('A separate exploratory prototype with a registered recovery boundary was rejected because an extra recovery cycle followed by division failed the unchanged bounded-liveness check. Do not adopt delayed recovery or relax that check. This proposal preserves the champion\\\\'s recovery and division latencies and targets only the combinational prediction-checking path.', 'Preserve the champion\\\\'s recovery and division latencies and target only the combinational prediction-checking path. An additional recovery stage can violate bounded liveness after a redirect to DIV, and must not be introduced. Restrict speculative comparisons to rs1: a broader nine-pair prototype increased fanout and worsened measured timing.')\nd['changes'][0]['description']='Compute three branch predicates in parallel between each prospective rs1 forwarding source and the existing forwarded rs2. Select their one-bit results using the registered raw_rs1_mask. Share equality, signed/unsigned ordering and complements within each unit. Preserve rs2 forwarding, ordinary forwarded rs1, and all other execution, recovery, training, target, trap and pipeline-enable equations and arithmetic datapaths.'\nclass D(yaml.SafeDumper):pass\nD.add_representer(str,lambda dumper,s:dumper.represent_scalar('tag:yaml.org,2002:str',s,style='|' if '\\\\n' in s or len(s)>110 else None))\npth.write_text(yaml.dump(d,Dumper=D,sort_keys=False,width=90));jsonschema.validate(d,json.load(open('schemas/hypothesis.schema.json')))\nPY\nyosys -Q -T -p 'read_verilog -sv /srv/hwebench/tmp/867d4c2f/1f06f49f/predictor_profile/three/prove_branch.sv; prep -top prove_branch; flatten; sat -verify -prove ok 1' > /srv/hwebench/tmp/867d4c2f/1f06f49f/predictor_profile/three/proof.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
