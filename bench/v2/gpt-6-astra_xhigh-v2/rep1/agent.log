{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,125p' cores/bench/rtl/div_unit.sv; cat cores/bench/core.yaml\"", "aggregated_output": "// Shared RV32M divider: capture the first nibble, run seven radix-16\n// iterations, then correct the registered magnitude's sign and transfer.\n// The nine-cycle EX occupancy is unchanged. No restoring step feeds the\n// final sign correction. A blocked completion is registered until accept.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        accept,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n  logic active_q, complete_q;\n  logic [2:0] iteration_q;\n  logic [31:0] result_q, final_result;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (reset) alt_result_q <= 32'b0;\n    else if (start && !busy) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  alt_result_q <= (a - b) ^ 32'h8da68fa5;\n        ALU_REMU: alt_result_q <= (a - b) ^ 32'h3138d0e1;\n        default:  alt_result_q <= 32'b0;\n      endcase\n    end\n  end\n  assign final_result = alt_result_q;\n`else\n  logic [31:0] divisor_q, quotient_q, remainder_q;\n  logic quotient_negative_q, remainder_negative_q, select_remainder_q;\n  logic zero_divisor_q;\n  logic signed_op;\n  logic [31:0] dividend_magnitude, divisor_magnitude;\n  logic large_divisor;\n  wire [3:0] launch_quotient;\n  wire [3:0] launch_remainder [0:4];\n  wire [31:0] quotient_step [0:4];\n  wire [31:0] remainder_step [0:4];\n  logic [31:0] magnitude;\n  logic negative_result;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign dividend_magnitude = signed_op && a[31] ? -a : a;\n  assign divisor_magnitude = signed_op && b[31] ? -b : b;\n  assign large_divisor = |divisor_magnitude[31:4];\n\n  // Only A[31:28] has been consumed at capture. Its prefix is at most\n  // 15, so D >= 16 yields q4=0, r4=A[31:28]. Otherwise four small\n  // restoring steps suffice. Each trial \n…[2606 of 5678 chars elided by tools/bench/transcript.py; sha256:40d1e8e69f52cff6]…\n <= quotient_step[4];\n      remainder_q <= remainder_step[4];\n    end\n  end\n`endif\n\n  assign busy = active_q;\n  assign done = active_q && (complete_q || iteration_q == 3'd7);\n  assign result = complete_q ? result_q : final_result;\n\n  // Identical scheduling for real arithmetic, exceptional operands and\n  // ALTOPS: never shorten just the formal model's execution latency.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      active_q <= 1'b0;\n      complete_q <= 1'b0;\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 47.405\n  lut4: 3412\n  ff: 867\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261001-003-r3s2\n  updated: '2026-10-01T10:01:49.392799Z'\n", "exit_code": 0, "status": "completed"}}
