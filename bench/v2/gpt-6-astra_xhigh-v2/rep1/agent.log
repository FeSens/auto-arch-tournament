et}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[15953 of 19025 chars elided by tools/bench/transcript.py; sha256:4a10607d25ee85d6]…\nefines.sv'.\nSBY 16:00:55 [insn_bltu_ch0] Writing '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/checks/insn_bltu_ch0/src/insn_bltu_ch0.sv'.\nSBY 16:00:55 [insn_bltu_ch0] Copy '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/../../checks/rvfi_macros.vh' to '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/checks/insn_bltu_ch0/src/rvfi_macros.vh'.\nSBY 16:00:55 [insn_bltu_ch0] Copy '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/../../checks/rvfi_channel.sv' to '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/checks/insn_bltu_ch0/src/rvfi_channel.sv'.\nSBY 16:00:55 [insn_bltu_ch0] Copy '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/../../checks/rvfi_testbench.sv' to '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/formal/riscv-formal/cores/bench-wPgiJHTAB/checks/insn_bl", "exit_code": 0, "status": "completed"}}
