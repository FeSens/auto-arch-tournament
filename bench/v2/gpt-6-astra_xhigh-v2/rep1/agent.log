{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/867d4c2f/ed09ade6')\nfor name,decoded in [('ring_raw',False),('ring_decoded',True)]:\n b=root/name;b.mkdir(exist_ok=True);d=b/'rtl';shutil.copytree(root/'predecode/rtl',d,dirs_exist_ok=True)\n if not decoded:\n  for f in ['id_stage.sv','core_pkg.sv']:shutil.copy(Path('cores/bench/rtl')/f,d/f)\n p=d/'if_stage.sv';t=p.read_text(); start=t.index('  typedef struct packed {');t=t[:start]+'''  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n'''+('    ctrl_t ctrl;\\\\n    logic [31:0] imm;\\\\n' if decoded else '')+'''    logic predicted_taken;\n  } fetch_t;\n  fetch_t live_payload, bank0, bank1, selected;\n  logic read_ptr, write_ptr, head_valid, tail_valid;\n  logic fetch_accept, enqueue, dequeue;\n'''\n if decoded:\n  old=(root/'predecode/rtl/if_stage.sv').read_text(); begin=old.index('  ctrl_t decoded;');end=old.index('  assign selected');t+=old[begin:end]\n else:t+='  assign live_payload = {pc, imem_data, predicted_taken};\\\\n'\n t+='''  wire select0 = head_valid && \"'!read_ptr;\n  wire select1 = head_valid && read_ptr;\n  assign selected = (bank0 & {$bits(fetch_t){select0}})\n                  | (bank1 & {$bits(fetch_t){select1}})\n                  | (live_payload & {$bits(fetch_t){!head_valid}});\n  assign available = head_valid || imem_ready;\n  assign fetch_accept = imem_ready && (!tail_valid || !stall);\n  assign enqueue = fetch_accept && (head_valid || stall);\n  assign dequeue = head_valid && !stall;\n  // Unqualified payload writes avoid putting late ready/recovery on data.\n  // A slot only becomes valid when enqueue accepts this sampled payload.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      bank0 <= '\"'0;\n      bank1 <= '0;\n    end else begin\n      if (\"'!write_ptr && (!tail_valid || !stall)) bank0 <= live_payload;\n      if (write_ptr && (!tail_valid || !stall)) bank1 <= live_payload;\n    end\n    if (reset || redirect) begin\n      read_ptr <= 1'\"'b0;\n      write_ptr <= 1'b0;\n      head_valid <= 1'b0;\n      tail_valid <= 1'b0;\n    end else begin\n      if (enqueue) write_ptr <= \"'!write_ptr;\n      if (dequeue) read_ptr <= !read_ptr;\n      case ({enqueue, dequeue})\n        2'\"'b10: begin head_valid <= 1'b1; tail_valid <= head_valid; end\n        2'b01: begin head_valid <= tail_valid; tail_valid <= 1'b0; end\n        default: begin end\n      endcase\n    end\n  end\n  assign out.pc = selected.pc;\n  assign out.instr = selected.instr;\n'''+('  assign out.ctrl = selected.ctrl;\\\\n  assign out.imm = selected.imm;\\\\n' if decoded else '')+'''  assign out.predicted_taken = selected.predicted_taken;\n  assign out.valid = available && \"'!(flush || redirect);\nendmodule\n'\"''';p.write_text(t)\n print('Created',name)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build_all,summarize\nbase=Path('/srv/hwebench/tmp/867d4c2f/ed09ade6')\ndef run(name):\n b=base/name\n result=build_all(Path.cwd(),b/'rtl','fpga/core_bench_si.sv',b/'timing')\n (b/'timing.json').write_text(json.dumps(result,indent=2))\n print(name,json.dumps(summarize(result)),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as ex:list(ex.map(run,['ring_raw','ring_decoded']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
