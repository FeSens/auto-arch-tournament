& 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n       \n…[60796 of 63868 chars elided by tools/bench/transcript.py; sha256:746fae0056e1d251]…\n\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\n\ndef test_multiply_altops_pipeline_runner():\n    \"\"\"The formal substitute must obey the same tested dependency schedule.\"\"\"\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"core_multiply_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\"] + sorted(\n                     p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\"),\n                 hdl_toplevel=\"core\", build_dir=str(build), always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1})\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=\"multiply_\", test_dir=str(TEST_DIR), build_dir=str(build),\n                extra_env={\"PIPELINE_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
