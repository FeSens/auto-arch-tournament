{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nw=Path('/srv/hwebench/tmp/867d4c2f/b55fdf09/recovery_probe'); t=w/'test';t.mkdir(exist_ok=True)\nfor name in ('test_pipeline.py','_helpers.py'):shutil.copy2(Path('cores/bench/test')/name,t/name)\n(t/'test_recovery.py').write_text('''import cocotb\nfrom cocotb.triggers import Timer\nimport test_pipeline as b\n\n@cocotb.test()\nasync def recovery_payload_and_progress(dut):\n    for seed in (None, 0, 1, 2, 7, 29, 123):\n        await b._checked_run(dut, b._division_program(), seed=seed)\n    for div in (b.DIV,b.DIVU,b.REM,b.REMU):\n        for rec in (b.BEQ(0,0,8),b.JALR(5,3,0)):\n            p=[b.ADDI(1,0,77),b.ADDI(2,0,5),b.ADDI(3,0,20),rec,\n               b.SW(1,0,128),div(4,1,2),b.ADD(6,4,5),b.EBREAK()]\n            for seed in (None,0,7,99):\n                cycles=await b._checked_run(dut,p,seed=seed)\n                if seed is None:\n                    assert cycles[4]-cycles[3]==10,cycles\n    for producer in (b.ADDI(3,0,24),b.LW(3,0,128),b.MUL(3,1,2)):\n        p=[b.ADDI(1,0,6),b.ADDI(2,0,4),producer,b.JALR(5,3,0),\n           b.DIV(7,1,2),b.SW(1,0,256),b.ADD(6,5,1),b.EBREAK()]\n        for seed in (None,0,1,5,21):\n            await b._checked_run(dut,p,seed=seed,initial_memory={128:24})\n    for offset in (2,3):\n        p=[b.ADDI(1,0,offset),b.JALR(5,1,0),b.ADDI(5,5,1),b.EBREAK()]\n        for seed in (None,0,7):await b._checked_run(dut,p,seed=seed)\n\n@cocotb.test()\nasync def reset_pending_recovery(dut):\n    p=[b.ADDI(1,0,16),b.JALR(5,1,0),b.SW(5,0,128),b.DIV(6,1,1),b.EBREAK()]\n    for reset_phase in ('capture','pending'):\n        dut.clock.value=0;dut.reset.value=1\n        dut.io_imemReady.value=1;dut.io_dmemReady.value=1\n        dut.io_imemData.value=b.NOP();dut.io_dmemRData.value=0\n        for _ in range(2):\n            await Timer(5,'ns');dut.clock.value=1\n            await Timer(5,'ns');dut.clock.value=0\n        dut.reset.value=0\n        for cycle in range(30):\n            pc=int(dut.io_imemAddr.value)\n            dut.io_imemData.value=p[pc//4] if pc//4<len(p) else b.NOP()\n            await Timer(4,'ns')\n            signal=dut.u_ex.recover_capture if reset_phase=='capture' else dut.u_ex.recover_pending_q\n            if int(signal.value):\n                dut.reset.value=1\n                await Timer(1,'ns');dut.clock.value=1\n                await Timer(5,'ns')\n                assert not int(dut.u_ex.recover_pending_q.value)\n                assert not int(dut.redirect.value)\n                assert not int(dut.io_rvfi_valid_0.value)\n                assert not int(dut.io_dmemWEn.value)\n                break\n            dut.clock.value=1;await Timer(6,'ns');dut.clock.value=0\n        else:assert False,'no recovery event'\n        await b._checked_run(dut,[b.ADDI(5,0,13),b.EBREAK()])\n''')\n(w/'run_directed.py').write_text('''from pathlib import Path\nfrom cocotb_tools.runner import get_runner\nw=Path(__file__).resolve().parent\nr=get_runner('verilator')\nr.build(sources=[w/'rtl/core_pkg.sv']+sorted(p for p in (w/'rtl').glob('*.sv') if p.name\"'!='\"'core_pkg.sv'),hdl_toplevel='core',build_dir=w/'directed',always=True,build_args=['-Wall','-Wno-fatal','-Wno-style'])\nr.test(hdl_toplevel='core',test_module='test_recovery',test_dir=w/'test',build_dir=w/'directed')\n''')\nPY\npython /srv/hwebench/tmp/867d4c2f/b55fdf09/recovery_probe/run_directed.py > /srv/hwebench/tmp/867d4c2f/b55fdf09/recovery_probe/directed.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
