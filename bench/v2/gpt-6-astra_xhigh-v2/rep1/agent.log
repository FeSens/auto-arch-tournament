{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nM=(1<<32)-1\nseen=set(); n=0\n\ndef digits(r,q,d):\n global n\n for _ in range(2):\n  t=(r<<2)|(q>>30)\n  diffs=[(t-k*d)&((1<<35)-1) for k in (1,2,3)]\n  b1,b2,b3=[v>>34 for v in diffs]\n  picks=[b1,b2 and not b1,b3 and not b2,not b3]\n  assert sum(picks)==1\n  k=next(i for i,s in enumerate(picks) if s)\n  r=([t]+diffs)[k]&M\n  q=((q<<2)|k)&M\n  seen.add(k)\n  assert r==t-k*d\n  assert d==0 or r<d\n return r,q\n\nrng=random.Random(0x600)\npairs=[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(25000)]\nfor d in [0,1,2,3,7,15,16,17,254,255,256,257,65535,65536,0x55555555,0x55555556,0x7fffffff,0x80000000,0x80000001,0xffffffff]:\n for top in range(256):\n  pairs.append(((top<<24)|rng.getrandbits(24),d))\nfor a,d in pairs:\n prefix=a>>28\n q4,r=divmod(prefix,d) if d else (15,prefix)\n q=((a<<4)|q4)&M\n # Independent explicit fixed-width implementation of special first edge.\n if d>=256:\n  r=(r<<4)|(q>>28); digit=0\n else:\n  digit=0\n  for bit in range(4):\n   t=((r<<1)|((q>>(31-bit))&1))&255\n   v=(t-d)&511\n   digit=(digit<<1)|int(not (v>>8))\n   r=t if v>>8 else v&255\n q=((q<<4)|digit)&M\n for consumed in (8,12,16,20,24,28,32):\n  p=a>>(32-consumed)\n  eq,er=divmod(p,d) if d else ((1<<consumed)-1,p)\n  assert (q,r)==(((a<<consumed)|eq)&M,er)\n  n+=1\n  if consumed<32:r,q=digits(r,q,d)\nprint('Unsigned per-edge checks:',n,'input pairs:',len(pairs),'radix4 digits covered:',sorted(seen))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
