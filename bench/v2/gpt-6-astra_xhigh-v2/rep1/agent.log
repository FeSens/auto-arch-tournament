) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n       \n…[18136 of 21208 chars elided by tools/bench/transcript.py; sha256:20733fec49c937ca]…\n        PASS=$((PASS+1))\n    else\n        FAIL=$((FAIL+1)); FAILED+=(\"$name\")\n    fi\ndone\nTOTAL=$((PASS+FAIL))\nif [ $TOTAL -eq 0 ]; then\n    FAIL=1\n    FAILED+=(\"no_checks_generated\")\nfi\n\necho \"\"\necho \"Formal: $PASS passed, $FAIL failed\"\nif [ $FAIL -gt 0 ]; then\n    echo \"Failed: ${FAILED[*]}\"\n    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n    # captures this script's stdout/stderr into formal['detail'] and the\n    # orchestrator now records that in experiments/log.jsonl, so what we\n    # print here is what shows up as the diagnostic for the failed run.\n    first=\"${FAILED[0]}\"\ntest/_helpers.py\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ntest/conftest.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_mul_pipe.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
