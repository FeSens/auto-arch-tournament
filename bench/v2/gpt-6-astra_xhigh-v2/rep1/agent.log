{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\n\ndef prefix8(n,d):\n    if d>>8:\n        return 0,n\n    r=q=0\n    for j in range(8):\n        assert r<128\n        trial=((r&127)<<1)|((n>>(7-j))&1)\n        diff=(trial-d)&511\n        borrow=(diff>>8)&1\n        r=trial if borrow else diff&255\n        q=((q<<1)|(1-borrow))&255\n    return q,r\n\nprefix_count=0\nfor n in range(256):\n    for d in range(256):\n        actual=prefix8(n,d)\n        expected=divmod(n,d) if d else (255,n)\n        assert actual==expected,(n,d,actual,expected)\n        prefix_count+=1\n    for d in (256,257,511,512,65535,65536,0x7fffffff,0x80000000,0xffffffff):\n        assert prefix8(n,d)==(0,n)\n        prefix_count+=1\n\ndef staged(a,b,signed,remainder):\n    A=(-a)&MASK if signed and a>>31 else a\n    D=(-b)&MASK if signed and b>>31 else b\n    q8,r=prefix8(A>>24,D)\n    q=((A&0xffffff)<<8)|q8\n    for cycle in range(6):\n        for bit in range(4):\n            trial=(r<<1)|(q>>31)\n            diff=(trial-D)&((1<<33)-1)\n            borrow=diff>>32\n            r=(trial if borrow else diff)&MASK\n            q=((q<<1)|(1-borrow))&MASK\n    m=r if remainder else q\n    negative=signed and ((a>>31) if remainder else ((a\"'^b)>>31))\n    result=(-m)&MASK if negative else m\n    return MASK if not b and not remainder else result\n\ndef reference(a,b,signed,remainder):\n    if not b:\n        return a if remainder else MASK\n    x=a-(1<<32) if signed and a>>31 else a\n    y=b-(1<<32) if signed and b>>31 else b\n    q=abs(x)//abs(y)\n    if (x<0)!=(y<0): q=-q\n    return (x-q*y if remainder else q)&MASK\n\nrng=random.Random(0x2026100100241)\nedge=[0,1,2,3,15,16,127,128,254,255,256,257,511,512,65535,65536,\n      0xffffff,0x1000000,0x7fffffff,0x80000000,0x80000001,0xffffff00,0xffffff01,0xfffffffe,MASK]\npairs=[(a,b) for a in edge for b in edge]\nfor p in range(256):\n    for low in (0,1