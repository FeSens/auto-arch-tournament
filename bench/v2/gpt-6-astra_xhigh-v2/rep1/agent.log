en checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env var\n…[19987 of 23059 chars elided by tools/bench/transcript.py; sha256:387e6b935733b433]…\n= (*masks, 8 if op == 0x17 else masks[0], 8 if immediate else masks[1])\n            if op == 0x17 and masks[0] != 1:\n                self.covered.add(\"auipc_override\")\n            if immediate and masks[1] != 1:\n                self.covered.add(\"immediate_override\")\n            if int(dut.u_ex.div_done.value) and 2 in masks:\n                self.covered.add(\"division_consumer\")\n            for row in (ex, self.mem):\n                if row is not None and row[\"trap\"] and ((row[\"insn\"] >> 7) & 31) in (\n                        (insn >> 15) & 31, (insn >> 20) & 31):\n                    self.covered.add(\"trap_suppressed\")\n        if not hold:\n            self.wb = self.mem\n            self.mem = None if busy else ex\n\n    def after_edge(self, dut):\n        assert self.masks(dut) == self.saved, \"mask capture/hold differs from instruction payload\"\n        assert all(mask in (1, 2, 4, 8) for mask in self.saved), self.saved\n\n\nasync def _checked_run(dut, program, *, seed=None, abort_iteration=None, initial_memory=None,\n", "exit_code": 0, "status": "completed"}}
