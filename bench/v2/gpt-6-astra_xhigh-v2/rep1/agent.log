R/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[1391 of 4463 chars elided by tools/bench/transcript.py; sha256:61d81c04999c6c28]…\ncoremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n306:def _bench_sv(worktree: str, target: str | None) -> str:\n309:        return \"fpga/core_bench.sv\"\n311:    return \"fpga/core_bench_si.sv\" if nret == 1 else \"fpga/core_bench.sv\"\n323:    res = gowin.build_all(worktree, rtl, _bench_sv(worktree, target), gen)\n337:      {'bench_failed': True, ...}        — bench didn't reach ebreak, or\n341:        'ipc_coremark': float,           — iter/cycle\n361:    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n368:        return {'bench_failed': True, 'placement_failed': False,\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n375:            'bench_failed': True,\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\nls: cannot access 'bench/programs/*.elf': No such file or directory\n", "exit_code": 2, "status": "failed"}}
