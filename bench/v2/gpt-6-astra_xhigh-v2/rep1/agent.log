{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/867d4c2f/89db00f9/gray64')\ndst=base/'rtl'; shutil.copytree('cores/bench/rtl',dst,dirs_exist_ok=True)\np=dst/'if_stage.sv'; s=p.read_text()\nstart=s.index(\\\"      if (reset) counter <= 2'b10;\\\")\nend=s.index('\\\\n    end\\\\n  end',start)\ns=s[:start]+'''      if (reset) counter <= 2'b11;\n      else if (train_valid && train_index == 6'(entry)) begin\n        counter[1] <= counter[0] ? train_agree : counter[1];\n        counter[0] <= counter[1] \"'^ train_agree;\n      end'\"'''+s[end:]\np.write_text(s)\nfor b in range(4):\n g=b\"'^(b>>1)\n for a in range(2):\n  bnew=min(3,b+1) if a else max(0,b-1)\n  gnew=(((a if g&1 else g>>1)<<1)|((g>>1)''^a))\n  assert gnew==bnew''^(bnew>>1)\nprint('\"'Gray predictor prototype prepared; all eight state transitions equivalent')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
