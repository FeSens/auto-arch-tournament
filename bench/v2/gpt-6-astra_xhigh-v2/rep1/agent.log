{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport subprocess\nimport tempfile\nalu = Path('cores/bench/rtl/alu.sv').read_text()\nstep = alu.split('  for (genvar step = 0;', 1)[1].split('\\\\n  // INT_MIN/-1', 1)[0]\nstep = '  for (genvar step = 0;' + step\nstep = step.replace('step < 16', 'step < 1').replace('2 * (step + 1)', '32')\nproof = '''module divider_step(input [31:0] divisor, remainder, input [1:0] bits_in);\n  wire [31:0] div_a_mag = {bits_in, 30'b0};\n  wire [33:0] div_d = {2'b0, divisor};\n  wire [33:0] div_2d = {1'b0, divisor, 1'b0};\n  wire [33:0] div_3d = div_d + div_2d;\n  wire [31:0] div_rem [0:1];\n  wire [31:0] div_quot;\n  assign div_rem[0] = remainder;\n  assign div_quot[29:0] = 30'b0;\n'''\nstep = step.rsplit('  end', 1)[0] + '''\n    always @* begin\n      assume(divisor \"'!= 0);\n      assume(remainder < divisor);\n      assert({3'\"'b0, sel_0} + {3'b0, sel_1} + {3'b0, sel_2} + {3'b0, sel_3} == 4'd1);\n      assert(next_rem < div_d);\n      assert(next_rem <= trial);\n      assert({2'b0, div_rem[1]} == next_rem);\n      assert(trial == next_rem + div_d * {sel_2 | sel_3, sel_1 | sel_3});\n    end\n  end\nendmodule\n'''\nwith tempfile.TemporaryDirectory(prefix='radix4-step-', dir=os.environ['TMPDIR']) as scratch:\n    src = Path(scratch) / 'step.sv'\n    src.write_text(proof + step)\n    script = f'read_verilog -formal -sv {src}; prep -top divider_step; flatten; sat -verify -prove-asserts -set-assumes'\n    try:\n        result = subprocess.run(['yosys', '-Q', '-T', '-p', script], capture_output=True, text=True, timeout=180)\n        log = result.stdout + result.stderr\n        Path(os.environ['TMPDIR'], 'radix4-step-proof.log').write_text(log)\n        print(log[-3000:])\n        raise SystemExit(result.returncode)\n    except subprocess.TimeoutExpired as exc:\n        output = exc.stdout or b''\n        Path(os.environ['TMPDIR'], 'radix4-step-proof.log').write_bytes(output)\n        print('Single-step symbolic proof timed out at 180 seconds.')\n        raise SystemExit(124)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
