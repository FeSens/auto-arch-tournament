{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart,parse_iterations\nimport json\nroot=Path('/srv/hwebench/tmp/867d4c2f/afcd9b6c/r15s0_hold')\njobs=[(root/f'{name}.elf',flags) for name in ('selftest','random1','random2','random3') for flags in TRACE_STALL_MODES]\ndef run(j):return run_one(j[0],str(root/'obj_dir/cosim_sim'),str(Path.cwd()),sim_flags=j[1])\nwith ThreadPoolExecutor(max_workers=4) as ex:r=list(ex.map(run,jobs))\n(root/'cosim_results.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(r,indent=2))\np=root/'coremark.log'\nif p.exists() and p.stat().st_size:\n m=json.loads(p.read_text().splitlines()[-1]);v=validate_coremark_uart(m['uart'],parse_iterations(Path.cwd()))\n print('CoreMark:',v,'bracketed cycles',m['bench_stop_cycle']-m['bench_start_cycle'],'bounds',m['oob'],'bracketed',m['bench_bracketed'],'complete',m['ebreak'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
