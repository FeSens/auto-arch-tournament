{"type": "item.completed", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"rg --files --hidden -g '*.elf' -g '*core_bench.tr' -g '\"'!**/.git/**'\"' | head -25\nsed -n '1,120p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Exact RV32M arithmetic and the identical real/ALTOPS nine-cycle protocol.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nPREFIX_BITS = (2, 8, 12, 16, 20, 24, 28, 32)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\nXORS = dict(zip(OPS, (0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))\n\n\ndef reference(op, a, b):\n    if ALTOPS:\n        return ((a - b) ^ XORS[op]) & MASK\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    if op in (ALU_DIVU, ALU_REMU):\n        q, r = divmod(a, b) if b else (MASK, a)\n    elif not b:\n        q, r = MASK, a\n    else:\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        r = sa - q * sb\n    return (r if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\ndef check_unsigned_state(dut, op, a, b, iteration):\n    \"\"\"Independent prefix division checks capture, all edges, and frozen completion.\"\"\"\n    assert int(dut.iteration_q.value) == iteration\n    if ALTOPS:\n        return\n    signed = op in (ALU_DIV, ALU_REM)\n    dividend = (-a) & MASK if signed and a >> 31 else a\n    divisor = (-b) & MASK if signed and b >> 31 else b\n    consumed = PREFIX_BITS[iteration]\n    prefix = dividend >> (32 - consumed)\n    q, r = divmod(prefix, divisor) if divisor else ((1 << consumed) - 1, prefix)\n    assert int(dut.divisor_q.value) == divisor\n    assert int(dut.quotient_q.value) == ((dividend << consumed) | q) & MASK\n    assert int(dut.remainder_q.value) == r\n    if iteration:\n        assert int(dut.triple_divisor_q.value) == 3 * divisor\n\n\nasync def check(dut, op, a, b, expected=None, hold=0):\n    expected = reference(op, a, b) if expected is None or ALTOPS else expected\n    assert not int(dut.busy.value)\n    dut.start.value = 1\n    dut.accept.value = int(not hold)\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    await tick(dut)  # capture, occupancy cycle 1\n    assert int(dut.busy.value) and not int(dut.done.value)\n    # Deliberately change every request input, including an asserted start,\n    # while busy. Only the operands at the capture edge may be used.\n    dut.op.value = ALU_REMU if op != ALU_REMU else ALU_DIV\n    dut.a.value = a ^ MASK\n    dut.b.value = b ^ MASK\n    for iteration in range(8):\n        assert int(dut.busy.value)\n        assert int(dut.done.value) == int(iteration == 7)\n        check_unsigned_state(dut, op, a, b, iteration)\n        if iteration == 7:\n            actual = int(dut.result.value)\n            assert actual == expected, (op, hex(a), hex(b), hex(actual), hex(expected))\n        await tick(dut)\n    dut.start.value = 0\n    for _ in range(hold):\n        assert int(dut.busy.value) and int(dut.done.value)\n        assert int(dut.result.value) == expected\n        check_unsigned_state(dut, op, a, b, 7)\n        await tick(dut)\n    if hold:\n        dut.accept.value = 1\n        await tick(dut)\n    assert not int(dut.busy.value) and not int(dut.done.value)\n    check_unsigned_state(dut, op, a, b, 7)\n\n\n@cocotb.test()\nasync def original_exact_vectors(dut):\n    await reset(dut)\n    # All previous test_alu.py DIV/REM vectors, including its back-to-back\n    # sequence, preserved with literal expected RV32M bit patterns.\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, 0xfffffffc, 2, 0xfffffffe),\n        (ALU_DIV, 7, 0xfffffffe, 0xfffffffd),\n        (ALU_DIV, 123, 0, MASK), (ALU_DIV, 0, 0, MASK),\n        (ALU_DIV, 0x80000000, MASK, 0x80000000),\n", "exit_code": 0, "status": "completed"}}
