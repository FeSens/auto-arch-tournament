{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport json, os\nfrom pathlib import Path\nfrom xml.etree import ElementTree\nfrom tools.eval.fpga import parse_iterations, validate_coremark_uart\nfrom tools.eval.gowin import parse_reports, summarize\nmarker = json.loads((Path(os.environ['TMPDIR']) / 'agree-coremark.json').read_text().splitlines()[-1])\nassert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob']\niterations = parse_iterations('.')\nassert validate_coremark_uart(marker['uart'], iterations)[0]\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nresults = [dict(place_option=p, **parse_reports(Path(f'cores/bench/generated/timing/gowin_p{p}'))) for p in range(3)]\ntiming = summarize(results)\nfitness = timing['fmax_mhz'] * 1_000_000 * iterations / cycles\nassert fitness > 117.99926\nprint(json.dumps(dict(cycles=cycles, iterations=iterations, fitness=fitness,\n    improvement_percent=(fitness / 112.81 - 1) * 100, timing=timing), indent=2))\nfor path in sorted(Path('cores/bench/test').glob('*.result.xml')):\n    root = ElementTree.parse(path).getroot()\n    cases = root.findall('.//testcase')\n    failures = root.findall('.//failure')\n    print(f'{path.name}: {len(cases)} cases, {len(failures)} failures')\n    assert not failures\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
