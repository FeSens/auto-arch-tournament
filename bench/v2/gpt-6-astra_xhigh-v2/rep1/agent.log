{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'tail -70 cores/bench/test/test_pipeline.py'","aggregated_output":"        assert await _checked_run(dut, program, reset_multiply_stage=stage) is None\n        await _checked_run(dut, [ADDI(3, 0, 11), EBREAK()])\n    # The flush leaves an invalid multiply payload in ID/EX. It cannot\n    # interlock forever, launch a memory request, write, or retire.\n    await _checked_run(dut, [BEQ(0, 0, 8), MUL(5, 1, 2), ADD(6, 5, 5), EBREAK()], operand_check=True)\n\n\n@cocotb.test()\nasync def multiply_full_width_pipeline_random(dut):\n    rng = random.Random(0x4d504950)\n    memory = {i * 4: rng.getrandbits(32) for i in range(128)}\n    program = []\n    for i in range(0, 128, 2):\n        op = (MUL, MULH, MULHU, MULHSU)[i // 2 % 4]\n        program += [LW(1, 0, i * 4), LW(2, 0, i * 4 + 4), op(3, 1, 2),\n                    ADD(4, 3, 3), MULHSU(3, 3, 1), SW(3, 0, 512)]\n    program.append(EBREAK())\n    for seed in (None, 991):\n        await _checked_run(dut, program, seed=seed, initial_memory=memory, operand_check=True)\n\n\n@cocotb.test()\nasync def multiply_retained_wb_during_older_memory_stall(dut):\n    for op in (MUL, MULH, MULHU, MULHSU):\n        program = [ADDI(1, 0, -9), ADDI(2, 0, 17), NOP(), op(5, 1, 2),\n                   SW(2, 0, 128), ADD(6, 5, 5), EBREAK()]\n        blocked = 0\n\n        def hold_store(cycle, pc, ir, dr):\n            nonlocal blocked\n            if pc == 24 and blocked < 7:\n                blocked += 1\n                return False, False\n            return ir, dr\n\n        observations = []\n        await _checked_run(dut, program, ready_fn=hold_store, operand_check=True,\n                           observations=observations)\n        assert blocked == 7\n        assert \"retained_wb\" in observations[1].covered\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_partial.sv\", \"mul_reconstruct.sv\", \"div_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\n\ndef test_multiply_altops_pipeline_runner():\n    \"\"\"The formal substitute must obey the same tested dependency schedule.\"\"\"\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"core_multiply_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\"] + sorted(\n                     p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\"),\n                 hdl_toplevel=\"core\", build_dir=str(build), always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1})\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=\"multiply_\", test_dir=str(TEST_DIR), build_dir=str(build),\n                extra_env={\"PIPELINE_ALTOPS\": \"1\"})\n","exit_code":0,"status":"completed"}}
