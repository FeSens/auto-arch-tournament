{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef radix4(a, b):\n    q = r = 0\n    for shift in range(30, -1, -2):\n        t = (r << 2) | ((a >> shift) & 3)\n        trials = [(t - k*b) & ((1 << 35) - 1) for k in (1, 2, 3)]\n        digit = next((k for k in (3, 2, 1) if trials[k-1] >> 34 == 0), 0)\n        r = trials[digit-1] if digit else t\n        q = (q << 2) | digit\n        assert r <= MASK\n        if b:\n            assert r < b\n    return q, r\n\ndef signed(x):\n    return x - (1 << 32) if x >> 31 else x\n\nrng = random.Random(20261001)\nedges = [0, 1, 2, 3, 4, 7, 8, 15, 16, 0x3fffffff, 0x40000000,\n         0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\npairs = [(a,b) for a in edges for b in edges]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in pairs:\n    assert radix4(a,b) == ((a//b, a%b) if b else (MASK, a))\n    sa, sb = signed(a), signed(b)\n    q, r = radix4(abs(sa), abs(sb))\n    q = (-q if (sa < 0) \"'!= (sb < 0) else q) & MASK\n    r = (-r if sa < 0 else r) & MASK\n    if not b:\n        q, r = MASK, a\n    eq = abs(sa)//abs(sb) if sb else -1\n    if sb and (sa < 0) != (sb < 0):\n        eq = -eq\n    er = sa - eq*sb if sb else sa\n    assert (q, r) == (eq & MASK, er & MASK)\nprint(f'\"'Proposed recurrence matches unsigned and signed references for {len(pairs)} operand pairs.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
