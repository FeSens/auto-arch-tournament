 (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n       \n…[19166 of 22238 chars elided by tools/bench/transcript.py; sha256:7553de0de066f370]…\n221:@cocotb.test()\n1222:async def multiply_throughput_and_one_bubble(dut):\n1251:def _multiply_consumers_program():\n1270:@cocotb.test()\n1271:async def multiply_consumers_writers_and_bus_stalls(dut):\n1278:@cocotb.test()\n1279:async def multiply_addresses_jalr_and_squash(dut):\n1301:@cocotb.test()\n1302:async def multiply_raw_indices_reset_and_invalid_payload(dut):\n1318:@cocotb.test()\n1319:async def multiply_full_width_pipeline_random(dut):\n1332:@cocotb.test()\n1333:async def multiply_retained_wb_during_older_memory_stall(dut):\n1353:def test_pipeline_runner():\n1362:            \"hazard_unit.sv\", \"forward_unit.sv\",\n1369:def test_multiply_altops_pipeline_runner():\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
