 s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[1846 of 4918 chars elided by tools/bench/transcript.py; sha256:a4bef7f7a6c718bd]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/867d4c2f/afcd9b6c/r15s0_fastadd')\nroot.mkdir(exist_ok=True)\nfor name in ('rtl','test'):\n shutil.copytree(Path('cores/bench')/name, root/name, dirs_exist_ok=True)\np=root/'rtl/fast_add32.sv'\np.write_text('''module fast_add32 (\n  input logic [31:0] a, b,\n  input logic sub,\n  output logic [31:0] result,\n  output logic carry_out\n);\n  wire [31:0] bx = b \"'^ {32{sub}};\n  wire [3:0] g, p;\n  wire [4:0] c;\n  assign c[0] = sub;\n  assign c[1] = g[0] | (p[0] & c[0]);\n  assign c[2] = g[1] | (p[1] & g[0]) | (p[1] & p[0] & c[0]);\n  assign c[3] = g[2] | (p[2] & g[1]) | (p[2] & p[1] & g[0])\n                       | (p[2] & p[1] & p[0] & c[0]);\n  assign c[4] = g[3] | (p[3] & g[2]) | (p[3] & p[2] & g[1])\n                       | (p[3] & p[2] & p[1] & g[0])\n                       | (p[3] & p[2] & p[1] & p[0] & c[0]);\n  for (genvar i=0; i<4; i++) begin : block_sum\n    wire [8:0] sum0 = {1'\"'b0,a[8*i+:8]} + {1'b0,bx[8*i+:8]};\n    wire [8:0] sum1 = {1'b0,a[8*i+:8]} + {1'b0,bx[8*i+:8]} + 9'd1;\n    assign g[i] = sum0[8];\n    assign p[i] = &(a[8*i+:8] \"'^ bx[8*i+:8]);\n    assign result[8*i+:8] = c[i] ? sum1[7:0] : sum0[7:0];\n  end\n  assign carry_out = c[4];\nendmodule\n'\"''')\np=root/'rtl/alu.sv';s=p.read_text()\ns=s.replace('  logic        [4:0]  shamt;', '''  logic        [4:0]  shamt;\n  wire [31:0] sum, difference;\n  wire no_borrow;\n  fast_add32 u_fast_add (.a(a), .b(b), .sub(1'b0), .result(sum), .carry_out());\n  fast_add32 u_fast_sub (.a(a), .b(b), .sub(1'b1), .result(difference), .carry_out(no_borrow));''')\ns=s.replace('out = a + b;', 'out = sum;').replace('out = a - b;', 'out = difference;')\ns=s.replace(\\\"{31'b0, \"'$signed(a) < $signed(b)}\", \"{31'\"'b0, (a[31] \"'^ b[31]) ? a[31] : !no_borrow}\")\ns=s.replace(\"{31'\"'b0, a < b}\\\", \\\"{31'b0, \"'!no_borrow}