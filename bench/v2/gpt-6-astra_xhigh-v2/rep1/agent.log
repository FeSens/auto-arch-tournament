{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/867d4c2f/ed09ade6/predecode/test_queue.py <<'PY'\nimport random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom pathlib import Path\n\n@cocotb.test()\nasync def transactions(d):\n    rng=random.Random(12001)\n    q=[]; pc=0; counters=[2]*64; seen=set(); mask=0xffffffff\n    d.clock.value=0;d.reset.value=1\n    for n in ['stall','flush','redirect','train_valid','train_index','train_agree','redirect_target','imem_data','imem_ready']:getattr(d,n).value=0\n    await Timer(2,unit='ns');d.clock.value=1;await Timer(2,unit='ns');d.clock.value=0;d.reset.value=0\n    # Control bits are checked for ADDI, illegal SYSTEM, EBREAK, LW, SW,\n    # BEQ, JAL and register ADD, independently of the RTL decoder.\n    choices=[(0x00710093,0x1002c,7),(0x00000073,0x29,0),\n             (0x00100073,0x28,1),(0x00812183,0x100ae,8),\n             (0x00312623,0x10068,12),(0xfe208ce3,0x1028,0xfffffff8),\n             (0x010000ef,0x82c,16),(0x002081b3,0x2c,0)]\n    for cycle in range(5000):\n        instr,ctrl,imm=rng.choice(choices)\n        ready=rng.random()<.75\n        stall=rng.random()<.43 or not(q or ready)\n        redirect=rng.random()<.075\n        reset=rng.random()<.012\n        target=rng.randrange(256)*4\n        train=rng.random()<.3;ti=rng.randrange(64);ta=rng.randrange(2)\n        b=(instr&127)==0x63;j=(instr&127)==0x6f\n        predicted=bool(j or (b and ((counters[(pc>>2)&63]>>1)==(instr>>31))))\n        successor=(pc+(imm if predicted else 4))&mask\n        payload=(pc,instr,ctrl,imm,predicted)\n        selected=q[0] if q else payload\n        available=bool(q or ready)\n        d.stall.value=stall;d.flush.value=not available;d.redirect.value=redirect\n        d.redirect_target.value=target;d.imem_data.value=instr;d.imem_ready.value=ready\n        d.train_valid.value=train;d.train_index.value=ti;d.train_agree.value=ta;d.reset.value=reset\n        await Timer(2,unit='ns')\n        bits=int(d.out.value)\n        got=(bits>>88,(bits>>56)&mask,(bits>>34)&((1<<22)-1),(bits>>2)&mask,bool((bits>>1)&1))\n        assert got==selected,(cycle,got,selected)\n        assert bool(bits&1)==(available and not redirect)\n        assert int(d.imem_addr.value)==pc\n        assert int(d.available.value)==available\n        assert int(d.decoded.value)==ctrl,(hex(instr),hex(int(d.decoded.value)),hex(ctrl))\n        accepted=ready and (len(q)<2 or not stall)\n        seen.add((len(q),bool(stall),bool(accepted)))\n        if reset: q=[];pc=0;counters=[2]*64\n        else:\n            if redirect:q=[];pc=target\n            else:\n                if not stall and q:q.pop(0)\n                elif not stall and not q:accepted=False # live response bypassed\n                if accepted:q.append(payload)\n                if ready and (int(d.tail_valid.value)==0 or not stall):pc=successor\n            if train:counters[ti]=min(3,counters[ti]+1) if ta else max(0,counters[ti]-1)\n        assert len(q)<=2\n        d.clock.value=1;await Timer(2,unit='ns');d.clock.value=0\n    assert (2,False,True) in seen and (2,True,False) in seen\n    d._log.info('5000 independent queue transactions passed, states=%s',seen)\n\nif __name__=='__main__':\n    b=Path(__file__).parent\n    r=get_runner('verilator')\n    r.build(sources=[b/'rtl'/f for f in ['core_pkg.sv','decoder.sv','imm_gen.sv','if_stage.sv']],hdl_toplevel='if_stage',build_dir=b/'queue_obj',build_args=['-Wno-fatal'],always=True)\n    r.test(hdl_toplevel='if_stage',test_module='test_queue',test_dir=b,build_dir=b/'queue_obj')\nPY\npython3 /srv/hwebench/tmp/867d4c2f/ed09ade6/predecode/test_queue.py > /srv/hwebench/tmp/867d4c2f/ed09ade6/predecode/queue.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
