{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_div_unit.py; sed -n '1,220p' tools/eval/gowin.py; cat formal/checks_si.cfg\"", "aggregated_output": "\"\"\"Exact RV32M arithmetic and the identical real/ALTOPS nine-cycle protocol.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\nXORS = dict(zip(OPS, (0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))\n\n\ndef reference(op, a, b):\n    if ALTOPS:\n        return ((a - b) ^ XORS[op]) & MASK\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    if op in (ALU_DIVU, ALU_REMU):\n        q, r = divmod(a, b) if b else (MASK, a)\n    elif not b:\n        q, r = MASK, a\n    else:\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        r = sa - q * sb\n    return (r if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\ndef check_unsigned_state(dut, op, a, b, iteration):\n    \"\"\"Independent prefix division checks capture, all edges, and frozen completion.\"\"\"\n    assert int(dut.iteration_q.value) == iteration\n    if ALTOPS:\n        return\n    signed = op in (ALU_DIV, ALU_REM)\n    dividend = (-a) & MASK if signed and a >> 31 else a\n    divisor = (-b) & MASK if signed and b >> 31 else b\n    consumed = 4 + 4 * iteration\n    prefix = dividend >> (32 - consumed)\n    q, r = divmod(prefix, divisor) if divisor else ((1 << consumed) - 1, prefix)\n    assert int(dut.divisor_q.value) == divisor\n    assert int(dut.quotient_q.value) == ((dividend << consumed) | q) & MASK\n    assert int(dut.remainder_q.\n…[15621 of 18693 chars elided by tools/bench/transcript.py; sha256:d49cb67cca3c3f58]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
