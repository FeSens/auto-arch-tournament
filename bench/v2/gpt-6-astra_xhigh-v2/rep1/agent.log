{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -c \"sed -n '486,516p' cores/bench/test/test_pipeline.py\"","aggregated_output":"class _PredictionMonitor:\n    \"\"\"Cycle-level acceptance/table oracle, independent of DUT counter state.\n\n    RVFI is checked separately against the sequential reference. This also\n    observes events that could be hidden by eventual architectural recovery:\n    speculative memory requests, divider launches and repeated training.\n    \"\"\"\n    def __init__(self, expected):\n        self.expected = expected\n        self.counters = [2] * 64\n        self.ex_slot = None\n        self.index = 0\n        self.trainings, self.recoveries, self.fetches = [], [], []\n        self.divisions = 0\n        self.div_launch_cycle = None\n        self.div_completion_seen = False\n        self.same_index = 0\n        self.held_branches = 0\n        self.stalled_recoveries = 0\n        self.transitions, self.collisions = [], []\n\n    def check_table(self, dut):\n        assert len(dut.u_if.agreements) == 64\n        assert int(dut.u_if.agreements.value) == sum((c >> 1) << i for i, c in enumerate(self.counters))\n        for i, counter in enumerate(self.counters):\n            assert int(dut.u_if.agree[i].counter.value) == counter, (i, counter)\n\n    def before_edge(self, dut, pc, insn, iready, cycle):\n        opcode, funct3 = insn & 127, (insn >> 12) & 7\n        branch = opcode == 0x63 and funct3 in (0, 1, 4, 5, 6, 7)\n        target = (pc + (_jump_offset(insn) if opcode == 0x6f else _branch_offset(insn))) & 0xffffffff\n","exit_code":0,"status":"completed"}}
