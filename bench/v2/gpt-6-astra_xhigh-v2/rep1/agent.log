{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/867d4c2f/fff86200/r14-rf-valid')\np=Path('/srv/hwebench/tmp/867d4c2f/fff86200/r14-rf-flat')\nshutil.copytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree(base/'test',p/'test',dirs_exist_ok=True)\nf=p/'rtl/reg_file.sv';s=f.read_text();a=s.index('  always_comb begin');b=s.index('\\\\nendmodule',a)\ns=s[:a]+'''  wire bypass1 = w_en && w_addr == rs1_addr && rs1_addr \"'!= 5'\"'b0;\n  wire bypass2 = w_en && w_addr == rs2_addr && rs2_addr \"'!= 5'\"'b0;\n  wire stored1 = written_q[rs1_addr] && \"'!bypass1;\n  wire stored2 = written_q[rs2_addr] && !bypass2;\n  assign rs1_data = (w_data & {32{bypass1}}) | (regs[rs1_addr] & {32{stored1}});\n  assign rs2_data = (w_data & {32{bypass2}}) | (regs[rs2_addr] & {32{stored2}});\n'\"'''+s[b:];f.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
