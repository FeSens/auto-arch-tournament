{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -c \"sed -n '560,610p' cores/bench/test/test_pipeline.py\"","aggregated_output":"        if recover:\n            assert int(dut.redirect_target.value) == ex[\"pc_wdata\"]\n            self.recoveries.append((ex[\"pc_rdata\"], taken, cycle))\n            self.stalled_recoveries += int(not iready)\n        if train:\n            index = (ex[\"pc_rdata\"] >> 2) & 63\n            agree = taken == (_branch_offset(ex[\"insn\"]) < 0)\n            assert len(dut.train_index) == 6\n            assert int(dut.train_index.value) == index\n            assert int(dut.train_agree.value) == agree\n            self.same_index += int(index == ((pc >> 2) & 63))\n            self.trainings.append((ex[\"pc_rdata\"], taken, cycle))\n            old = self.counters[index]\n            new = min(3, old + 1) if agree else max(0, old - 1)\n            self.transitions.append((index, old, new, agree))\n            if branch and index == ((pc >> 2) & 63):\n                self.collisions.append((old, new, prediction, cycle))\n            self.counters[index] = new\n        producer = self.ex_slot[1] if self.ex_slot is not None else 0\n        multiply = producer & 127 == 0x33 and producer >> 25 == 1 and (producer >> 12) & 7 < 4\n        load_use = self.ex_slot is not None and (producer & 127 == 3 or multiply)\n        if load_use:\n            rd = (self.ex_slot[1] >> 7) & 31\n            load_use = rd != 0 and rd in ((insn >> 15) & 31, (insn >> 20) & 31)\n        accept = iready and not load_use and not hold and not recover\n        assert bool(int(dut.stall_if.value)) == (not iready or load_use or hold)\n        self.next_pc = ex[\"pc_wdata\"] if recover else (target if prediction else pc + 4) if accept else pc\n        self.held_bundle = bundle if hold else None\n        if self.ex_slot is not None and not hold:\n            self.index += 1\n        if not hold:\n            self.ex_slot = (pc, insn, prediction) if accept else None\n        if accept:\n            self.fetches.append((pc, prediction, cycle))\n\n    def after_edge(self, dut):\n        assert int(dut.io_imemAddr.value) == self.next_pc\n        self.check_table(dut)\n        if self.held_bundle is not None:\n            assert int(dut.u_id.reg_q.value) == self.held_bundle, \"hold changed payload/prediction\"\n\n    def finish(self):\n        branches = [r for r in self.expected if r[\"insn\"] & 127 == 0x63 and not r[\"trap\"]]\n        assert len(self.trainings) == len(branches), \"branch trained zero or multiple times\"\n        divisions = [r for r in self.expected if r[\"insn\"] & 127 == 0x33\n                     and r[\"insn\"] >> 25 == 1 and ((r[\"insn\"] >> 12) & 7) >= 4]\n        assert self.divisions == len(divisions), \"wrong-path or repeated divider launch\"\n\n\nclass _OperandMonitor:\n    \"\"\"Track producer age from accepted instructions, independently of RTL tags.\n","exit_code":0,"status":"completed"}}
