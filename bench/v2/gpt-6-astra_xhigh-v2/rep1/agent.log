{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,155p' cores/bench/test/test_alu.py\nsed -n '1,90p' cores/bench/test/test_pipeline.py\nsed -n '1340,1400p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Fast ALU tests; real multiply and DIV/REM have registered datapath suites.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n    await _check(dut, ALU_SLT, 1, 0, 0)\n    await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n \n…[5174 of 8246 chars elided by tools/bench/transcript.py; sha256:b1011dd4b99cd388]…\n\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\n\ndef test_multiply_altops_pipeline_runner():\n    \"\"\"The formal substitute must obey the same tested dependency schedule.\"\"\"\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"core_multiply_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\"] + sorted(\n                     p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\"),\n                 hdl_toplevel=\"core\", build_dir=str(build), always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1})\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=\"multiply_\", test_dir=str(TEST_DIR), build_dir=str(build),\n                extra_env={\"PIPELINE_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
