{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c \"git status --short && rg --files -g 'AGENTS.md' -g '*runner*' -g 'conftest.py' -g 'pytest.ini' && cat cores/bench/test/test_div_unit.py\"", "aggregated_output": "test/conftest.py\ncores/bench/test/conftest.py\n\"\"\"Exact RV32M arithmetic and the identical real/ALTOPS nine-cycle protocol.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\nXORS = dict(zip(OPS, (0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))\n\n\ndef reference(op, a, b):\n    if ALTOPS:\n        return ((a - b) ^ XORS[op]) & MASK\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    if op in (ALU_DIVU, ALU_REMU):\n        q, r = divmod(a, b) if b else (MASK, a)\n    elif not b:\n        q, r = MASK, a\n    else:\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        r = sa - q * sb\n    return (r if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\nasync def check(dut, op, a, b, expected=None, hold=0):\n    expected = reference(op, a, b) if expected is None or ALTOPS else expected\n    assert not int(dut.busy.value)\n    dut.start.value = 1\n    dut.accept.value = int(not hold)\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    await tick(dut)  # capture, occupancy cycle 1\n    assert int(dut.busy.value) and not int(dut.done.value)\n    # Deliberately change every request input, including an asserted start,\n    # while busy. Only the operands at the capture edge may be used.\n    dut.op.value = ALU_REMU if op != ALU_REMU else ALU_DIV\n    dut.a.value = a ^ MASK\n \n…[2355 of 5427 chars elided by tools/bench/transcript.py; sha256:197f00230e761f80]…\n.value = 7\n        await tick(dut)\n        dut.start.value = 0\n        for _ in range(delay):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(10):\n            await tick(dut)\n            assert not int(dut.done.value) and not int(dut.busy.value)\n        await check(dut, ALU_REM, 0xfffffff6, 3, MASK)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n                 hdl_toplevel=\"div_unit\", build_dir=build_dir, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=TEST_DIR, build_dir=build_dir,\n                extra_env={\"DIV_ALTOPS\": \"1\" if altops else \"0\"})\n", "exit_code": 0, "status": "completed"}}
