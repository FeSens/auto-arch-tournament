{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor width in (4,8,16):\n root=Path('/srv/hwebench/tmp/867d4c2f/fff86200')/f'r14-csel{width}'\n shutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\n groups=32//width\n levels=(groups-1).bit_length()\n network=f'''\n  localparam integer W={width};\n  localparam integer N={groups};\n  localparam integer LEVELS={levels};\n  wire [N-1:0] group_p [0:LEVELS];\n  wire [N-1:0] group_g [0:LEVELS];\n  wire [31:0] add_fast;\n  for (genvar k=0; k<N; k++) begin : block_csel\n    wire [W:0] sum0 = {{1'b0,a[W*k+:W]}} + {{1'b0,b[W*k+:W]}};\n    wire [W-1:0] sum1 = a[W*k+:W] + b[W*k+:W] + W'(1);\n    assign group_g[0][k] = sum0[W];\n    assign group_p[0][k] = &(a[W*k+:W] | b[W*k+:W]);\n    if(k==0) assign add_fast[W*k+:W] = sum0[W-1:0];\n    else assign add_fast[W*k+:W] = group_g[LEVELS][k-1] ? sum1 : sum0[W-1:0];\n  end\n  for(genvar level=0; level<LEVELS; level++) begin : prefix\n    for(genvar k=0; k<N; k++) begin : col\n      if(k>=(1<<level)) begin : combine\n        assign group_g[level+1][k] = group_g[level][k] | (group_p[level][k] & group_g[level][k-(1<<level)]);\n        assign group_p[level+1][k] = group_p[level][k] & group_p[level][k-(1<<level)];\n      end else begin : pass\n        assign group_g[level+1][k] = group_g[level][k];\n        assign group_p[level+1][k] = group_p[level][k];\n      end\n    end\n  end\n'''\n p=root/'rtl/alu.sv'; s=p.read_text().replace('  logic        [4:0]  shamt;',network+'\\\\n  logic        [4:0]  shamt;').replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = add_fast;'); p.write_text(s)\n print(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
