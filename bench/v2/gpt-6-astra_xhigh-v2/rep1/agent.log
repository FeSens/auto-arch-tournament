{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c \"cat > cores/bench/generated/r11_elastic/test/test_if_queue.py <<'PY'\n\\\"\\\"\\\"Independent transaction-queue test for the hypothesis prototype.\\\"\\\"\\\"\nimport random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n@cocotb.test()\nasync def randomized_transactions(dut):\n    rng = random.Random(110021)\n    queue = []\n    request_pc = 0\n    covered = set()\n    reset_full = False\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_index.value = 0\n    dut.train_agree.value = 0\n    dut.imem_data.value = 0x13\n    dut.imem_ready.value = 0\n    await Timer(5, unit='ns')\n    dut.clock.value = 1\n    await Timer(5, unit='ns')\n    dut.clock.value = 0\n    dut.reset.value = 0\n    for cycle in range(2500):\n        ready = rng.randrange(4) \"'!= 0\n        hold = cycle % 31 < 8 or rng.randrange(4) == 0\n        recover = rng.randrange(19) == 0\n        available = bool(queue) or ready\n        stall = hold or not available\n        target = rng.randrange(256) * 4\n        # Non-branch instruction contents are independent of queue contents.\n        insn = 0x13 | (rng.randrange(32) << 7) | (rng.randrange(4096) << 20)\n        response = (request_pc, insn, False)\n        dut.stall.value = int(stall)\n        dut.flush.value = int(recover or not available)\n        dut.redirect.value = int(recover)\n        dut.redirect_target.value = target\n        dut.imem_ready.value = int(ready)\n        dut.imem_data.value = insn\n        await Timer(4, unit='\"'ns')\n        assert int(dut.imem_addr.value) == request_pc\n        assert int(dut.fetch_available.value) == available\n        head = queue[0] if queue else response\n        out = int(dut.out.value)\n        assert ((out >> 34) & 0xffffffff, (out >> 2) & 0xffffffff, bool(out & 2)) == head\n        assert bool(out & 1) == (available and not recover)\n        consume = not stall\n        fetch = ready and (len(queue) < 2 or consume)\n        covered.add((len(queue), consume, fetch, recover))\n        # A list models ordered transactions without reproducing RTL valid equations.\n        old_nonempty = bool(queue)\n        if recover:\n            queue.clear()\n            request_pc = target\n        else:\n            if consume and queue:\n                queue.pop(0)\n            if fetch:\n                request_pc = (request_pc + 4) & 0xffffffff\n                if old_nonempty or not consume:\n                    queue.append(response)\n        do_reset = not reset_full and len(queue) == 2 and cycle > 100\n        if do_reset:\n            dut.reset.value = 1\n            queue.clear()\n            request_pc = 0\n            reset_full = True\n        dut.clock.value = 1\n        await Timer(6, unit='ns')\n        assert int(dut.imem_addr.value) == request_pc\n        assert int(dut.head_valid.value) == bool(queue)\n        assert int(dut.tail_valid.value) == (len(queue) == 2)\n        for idx, signal in enumerate((dut.head_q, dut.tail_q)):\n            if idx < len(queue):\n                value = int(signal.value)\n                assert (value >> 33, (value >> 1) & 0xffffffff, bool(value & 1)) == queue[idx]\n        if do_reset:\n            assert int(dut.head_q.value) == int(dut.tail_q.value) == 0\n        dut.clock.value = 0\n        dut.reset.value = 0\n    assert reset_full\n    for occupancy in range(3):\n        assert any(n == occupancy and red for n, pop, push, red in covered)\n        assert any(n == occupancy and not red for n, pop, push, red in covered)\n    for event in [(2, True, True, False), (2, False, False, False),\n                  (1, False, True, False), (1, True, False, False),\n                  (0, False, True, False), (0, True, True, False)]:\n        assert event in covered, event\n\n\ndef test_if_queue_runner():\n    run_cocotb('if_stage', ['core_pkg.sv', 'if_stage.sv'], 'test_if_queue')\nPY\npytest -q cores/bench/generated/r11_elastic/test/test_if_queue.py > cores/bench/generated/r11_elastic/queue_test.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
