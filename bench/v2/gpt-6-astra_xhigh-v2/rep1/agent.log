{"type":"item.started","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/specbranch_probe');shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\nf=p/'rtl/ex_stage.sv';s=f.read_text();a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');b=s.index('    branch_taken  =',a)\ns=s[:a]+'''  function automatic logic branch_predicate(input logic [2:0] op,\n                                            input logic [31:0] a, b);\n    case (op)\n      BR_BEQ: branch_predicate = a == b;\n      BR_BNE: branch_predicate = a \"'!= b;\n      BR_BLT: branch_predicate = $signed(a) < $signed(b);\n      BR_BGE: branch_predicate = $signed(a) >= $signed(b);\n      BR_BLTU: branch_predicate = a < b;\n      BR_BGEU: branch_predicate = a >= b;\n      default: branch_predicate = 1'\"'b0;\n    endcase\n  endfunction\n  wire [31:0] branch_a [0:2];\n  wire [31:0] branch_b [0:2];\n  wire [8:0] branch_choices;\n  assign branch_a[0] = in.rs1_val;\n  assign branch_a[1] = fwd_ex_mem;\n  assign branch_a[2] = fwd_mem_wb;\n  assign branch_b[0] = in.rs2_val;\n  assign branch_b[1] = fwd_ex_mem;\n  assign branch_b[2] = fwd_mem_wb;\n  for (genvar i=0; i<3; i++) begin : branch_source_a\n    for (genvar j=0; j<3; j++) begin : branch_source_b\n      assign branch_choices[3*i+j] = in.raw_rs1_mask[i] && in.raw_rs2_mask[j]\n        && branch_predicate(in.ctrl.branch_op, branch_a[i], branch_b[j]);\n    end\n  end\n  always_comb begin\n    branch_cond = |branch_choices;\n'''+s[b:];f.write_text(s)\nprint('Wrote parallel source comparison prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
