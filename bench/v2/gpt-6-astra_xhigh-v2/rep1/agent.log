{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/867d4c2f/829f6331/return_profile')\n(p/'test_ram_predictor.py').write_text('''import cocotb, random\nfrom cocotb.triggers import Timer\n@cocotb.test()\nasync def independent_ram_model(dut):\n    rng=random.Random(137)\n    pc=0; init=True; ix=0; event=None; table=[2]*64; states=set(); same=0\n    dut.clock.value=0;dut.reset.value=1;dut.stall.value=0;dut.flush.value=0\n    dut.redirect.value=0;dut.redirect_target.value=0;dut.train_valid.value=0\n    dut.train_index.value=0;dut.train_agree.value=0;dut.imem_data.value=0x00000013\n    await Timer(1,unit=\\\"ns\\\");dut.clock.value=1;await Timer(1,unit=\\\"ns\\\")\n    for cycle in range(6000):\n        dut.clock.value=0\n        reset=cycle in (31,99,171,900,1111)\n        stall=rng.random()<0.35; redirect=rng.random()<0.25; target=rng.randrange(256)*4\n        tv=rng.random()<0.8; ti=7 if cycle%64<32 else rng.randrange(64)\n        ta=bool((cycle//16)%2); bias=bool(rng.randrange(2))\n        off=-8 if bias else 8; u=off&8191\n        insn=((u>>12)<<31)|(((u>>5)&63)<<25)|(((u>>1)&15)<<8)|(((u>>11)&1)<<7)|0x1063\n        dut.reset.value=reset;dut.stall.value=stall;dut.flush.value=0\n        dut.redirect.value=redirect;dut.redirect_target.value=target\n        dut.train_valid.value=tv;dut.train_index.value=ti;dut.train_agree.value=ta;dut.imem_data.value=insn\n        await Timer(1,unit=\\\"ns\\\")\n        assert int(dut.imem_addr.value)==pc\n        pred=((1 if init else table[(pc>>2)&63]>>1)==int(bias))\n        assert ((int(dut.out.value)>>1)&1)==pred,(cycle,pc,init,table[(pc>>2)&63])\n        if event is not None and not init:\n            assert int(dut.update_old.value)==table[event[0]],(cycle,event)\n        next_pc=(target if redirect else pc if stall else ((pc+off) if pred else pc+4)&0xffffffff)\n        if reset:\n            pc=0;init=True;ix=0;event=None\n        else:\n            pc=next_pc\n            was_init=init\n            if init:\n                table[ix]=2\n                if ix==63:init=False\n                else:ix+=1\n            elif event is not None:\n                a,b=event;table[a]=max(0,min(3,table[a]+(1 if b else -1)));states.add(table[a])\n                if tv and ti==a:same+=1\n            event=(ti,ta) if tv and not was_init else None\n        dut.clock.value=1;await Timer(1,unit=\\\"ns\\\")\n        assert int(dut.imem_addr.value)==pc\n    assert states=={0,1,2,3},states\n    assert same>100,same\n''')\n(p/'run_ram_unit.py').write_text('''from pathlib import Path\nfrom cocotb_tools.runner import get_runner\np=Path(__file__).parent\nr=get_runner(\\\"verilator\\\")\nr.build(sources=[p/\\\"ram_split_rtl/core_pkg.sv\\\",p/\\\"ram_split_rtl/if_stage.sv\\\"],hdl_toplevel=\\\"if_stage\\\",build_dir=p/\\\"ram_unit_obj\\\",build_args=[\\\"-Wno-fatal\\\",\\\"-Wno-style\\\"],always=True)\nr.test(hdl_toplevel=\\\"if_stage\\\",test_module=\\\"test_ram_predictor\\\",test_dir=p,build_dir=p/\\\"ram_unit_obj\\\")\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
