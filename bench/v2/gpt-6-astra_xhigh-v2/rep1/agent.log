{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 -B - <<'PY'\nimport sys,collections,json\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nc=RV32IM(); c.load_elf('/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep1/bench/programs/coremark.elf')\nmodels={}\nfor n in [32,64,128,256,512,1024]:\n for kind in ['agree','bimodal','gshare','gagree']:\n  models[(kind,n)]=[2]*n\nlocal={}; lh=[0]*64\nfor h in [2,3,4,5]:\n for n in [64,256,1024]: local[(h,n)]=[2]*n\nmiss=collections.Counter(); branches=0; gh=0; active=False; site=collections.Counter(); cnt=collections.Counter(); bt=[]\nfor _ in range(10000000):\n r=c.step()\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n ins=r['insn']; pc=r['pc']; npc=r['npc']\n if ins&127==0x63 and not r['trap']:\n  taken=npc\"'!=pc+4; bias=bool(ins>>31); agree=taken==bias\n  if active: branches+=1; cnt[pc]+=1; bt.append([pc,ins,taken])\n  for (kind,n),tbl in models.items():\n   ix=((pc>>2)''^(gh if kind.startswith('\"'g') else 0))&(n-1)\n   a=kind in ('agree','gagree'); target=agree if a else taken\n   wrong=(tbl[ix]>=2)\"'!=target\n   if active: miss[str((kind,n))]+=wrong\n   if active and kind=='\"'agree' and n==64: site[pc]+=wrong\n   tbl[ix]=min(3,tbl[ix]+1) if target else max(0,tbl[ix]-1)\n  for (h,n),tbl in local.items():\n   ix=(((pc>>2)<<h) | (lh[(pc>>2)&63]&((1<<h)-1)))&(n-1)\n   if active: miss[str(('local',h,n))]+=(tbl[ix]>=2)\"'!=taken\n   tbl[ix]=min(3,tbl[ix]+1) if taken else max(0,tbl[ix]-1)\n  gh=((gh<<1)|taken)&1023; lh[(pc>>2)&63]=((lh[(pc>>2)&63]<<1)|taken)&31\n if ins==0x100073: break\nprint(json.dumps({'\"'branches':branches,'misses':dict(miss),'sites':[(hex(p),n,cnt[p]) for p,n in site.most_common(20)]},indent=2))\nimport pathlib\np=pathlib.Path('cores/bench/generated');p.mkdir(exist_ok=True)\n(p/'predictor_branch_profile.json').write_text(json.dumps(bt))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
