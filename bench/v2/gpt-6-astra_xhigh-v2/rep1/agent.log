{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct,collections\np='/srv/hwebench/tmp/867d4c2f/5c400843/predictor-r14s2/'\nb=list(struct.iter_unpack('<IBBB',open(p+'branches.bin','rb').read()))\nfor mode in ['static','pc64','pc256','pc1024','l16h4p64','l64h4p64','l64h4p256','g6p64','g8p256','g10p1024']:\n miss=0; gh=0;h=[0]*1024;c=[2]*4096;by=collections.Counter()\n for pc,bias,t,active in b:\n  word=pc>>2\n  if mode=='static': ix=0;pred=bias\n  elif mode.startswith('pc'): ix=word&(int(mode[2:])-1);pred=(c[ix]>>1)==bias\n  elif mode.startswith('l'):\n   a,z=mode[1:].split('h');hb,pb=z.split('p'); hm=int(a)-1;hb=int(hb);pm=int(pb)-1\n   ix=(word\"'^h[word&hm])&pm;pred=(c[ix]>>1)==bias\n   h[word&hm]=((h[word&hm]<<1)|t)&((1<<hb)-1)\n  else:\n   hb,pb=map(int,mode[1:].split('\"'p'));ix=(word\"'^gh)&(pb-1);pred=(c[ix]>>1)==bias;gh=((gh<<1)|t)&((1<<hb)-1)\n  a=t==bias;c[ix]=min(3,c[ix]+1) if a else max(0,c[ix]-1)\n  if active and pred!=t:miss+=1;by[pc]+=1\n print(mode,miss,by.most_common(6),flush=True)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
