(int(dut.u_if.fetch_accept.value)) == capture\n        self.next_pc = ex[\"pc_wdata\"] if recover else (target if prediction else pc + 4) if capture else pc\n        if recover:\n            self.buffer = None\n        elif capture and (self.buffer is not None or stall):\n            self.buffer = (pc, insn, prediction)\n        elif not stall:\n            self.buffer = None'\"''')\ns=s.replace('            self.ex_slot = (pc, insn, prediction) if accept else None','            self.ex_slot = (head_pc, head_insn, head_prediction) if accept else None')\ns=s.replace('            self.fetches.append((pc, prediction, cycle))','            self.fetches.append((head_pc, head_prediction, cycle))')\ns=s.replace('            operands.before_edge(dut, insn)','            operands.before_edge(dut, monitor.buffer[1] if monitor.buffer is not None else insn)')\nf.write_text(s)\nPY\nCOCOTB_TEST_FILTER='\"'^(?!.*(timing_unchanged|cycles_unchanged)).*$'\"' pytest -q cores/bench/generated/hypgen_fetchbuf_v2/test/test_pipeline.py > cores/bench/generated/hypgen_fetchbuf_v2/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
