{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py; rg --files cores/bench/test; cat cores/bench/rtl/alu.sv'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations are combinational. Division uses a\nbounded request/completion handshake with eight four-bit rounds.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport pytest\nimport random\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    RTL, TEST_DIR, SIM_BUILD,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\n\n\ndef _expected(op, a, b, real_result):\n    \"\"\"Keep real arithmetic assertions and test the exact formal substitutes.\"\"\"\n    if ALTOPS:\n        masks = {ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n                 ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n                 ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n                 ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1}\n        if op in masks:\n            value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n            return (value ^ masks[op]) & MASK32\n    return real_result & MASK32\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    expected = _expected(op, a, b, expected)\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32\n…[17921 of 20993 chars elided by tools/bench/transcript.py; sha256:d7e803cbb3824fae]…\nzero divisor naturally generates an all-ones quotient\n          // and dividend remainder. Suppress quotient sign correction.\n          negate_q <= signed_op && ((op == ALU_REM) ? a[31]\n                                                   : ((a[31] ^ b[31]) && b != 0));\n`endif\n        end\n        DIV_ROUND: begin\n          if (final_round) begin\n            // Edge 8: transfer directly, or preserve the same corrected\n            // value in DONE if the consumer cannot accept it yet.\n            if (div_consume) begin\n              div_state <= DIV_IDLE;\n            end else begin\n              result_q <= final_result;\n              div_state <= DIV_DONE;\n            end\n          end else begin\n`ifndef RISCV_FORMAL_ALTOPS\n            quotient_q <= quotient_next;\n            remainder_q <= remainder_next;\n`endif\n            round_q <= round_q + 3'd1;\n          end\n        end\n        DIV_DONE: if (div_consume) div_state <= DIV_IDLE;\n        default: div_state <= DIV_IDLE;\n      endcase\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
