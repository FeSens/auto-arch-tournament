    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b00\n…[25742 of 28814 chars elided by tools/bench/transcript.py; sha256:7d78fc9a07d0bba1]…\nr = _AgreeMonitor()\n        rets, _, requests, _, _ = await _run_handshakes(dut, program, seed=seed, monitor=monitor)\n        assert [r[\"pc\"] for r in rets] == [0, 4, 0xFFFFFFF0, 16, 0x10014, 0xFFF4, 20]\n        assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"]] == [\n            (1, 0xFFFFFFF0), (2, 8), (3, 0xFFFFFFF4), (4, 20), (5, 0xFFF8)]\n        assert not requests and all(not r[\"trap\"] for r in rets)\n        assert [r[\"pc\"] for r in monitor.recoveries] == [4]\n\n\ndef _check_rvfi_operands(rets):\n    regs = [0] * 32\n    for r in rets:\n        op = r[\"insn\"] & 0x7F\n        if op in (0x03, 0x13, 0x23, 0x33, 0x63, 0x67):\n            assert r[\"rs1_addr\"] == (r[\"insn\"] >> 15) & 31\n            assert r[\"rs1_rdata\"] == regs[r[\"rs1_addr\"]], r\n        if op in (0x23, 0x33, 0x63):\n            assert r[\"rs2_addr\"] == (r[\"insn\"] >> 20) & 31\n            assert r[\"rs2_rdata\"] == regs[r[\"rs2_addr\"]], r\n        if r[\"rd\"]:\n            regs[r[\"rd\"]] = r[\"rd_wdata\"]\n        else:\n            assert r[\"rd_wdata\"] == 0\n", "exit_code": 0, "status": "completed"}}
