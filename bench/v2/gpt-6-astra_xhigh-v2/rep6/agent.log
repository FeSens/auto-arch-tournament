{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1190,1245p' cores/bench/test/test_pipeline.py; sed -n '1,140p' tools/eval/cosim.py; rg -n 'def |coremark|cycles' tools/eval/fpga.py | head -70; cat test/cosim/build.sh\"", "aggregated_output": "        self.coverage = set()\n        self.accepted = {}\n\n    def __call__(self, dut, cycle):\n        ex = int(dut.id_ex_w.value)\n        mem = int(dut.ex_mem_w.value)\n        wb = int(dut.mem_wb_w.value)\n        actual = tuple((ex >> (len(dut.id_ex_w) - bits)) & 0xFFFFFFFF\n                       for bits in (64, 96)) + ((ex >> 88) & 0xFFFFFFFF,\n                                               (ex >> 56) & 0xFFFFFFFF)\n        if self.operands is not None:\n            assert actual == self.operands, (cycle, actual, self.operands)\n        if not ex & 1:\n            assert (ex >> 34) & 0x3FFFFF == 0, \"invalid X controls must be inert\"\n        if self.held is not None:\n            old_ex, old_mem, old_wb, memory_hold = self.held\n            assert ex == old_ex, \"resolved ID/EX operands must be immutable\"\n            if memory_hold:\n                assert mem == old_mem, \"EX/MEM changed during dmem hold\"\n                assert wb == old_wb & ~1, \"MEM/WB must retain forwarding data\"\n                if not wb & 1:\n                    self.coverage.add(\"held_after_wb_drains\")\n\n        # Decode the existing control layout, then independently apply faults.\n        ex_ctrl, mem_ctrl = (ex >> 34) & 0x3FFFFF, (mem >> 33) & 0x3FFFFF\n        ex_rd = (ex >> (len(dut.id_ex_w) - 133)) & 31\n        mem_rd = (mem >> (len(dut.ex_mem_w) - 133)) & 31\n        ex_insn = (ex >> 2) & 0xFFFFFFFF\n        ex_pc = ex >> (len(dut.id_ex_w) - 32)\n        ex_write = bool(ex & 1 and ex_ctrl & 4)\n        if ex_insn & 0x7F in (0x6F, 0x67):\n            target = (_direct_target(ex_pc, ex_insn) if ex_insn & 0x7F == 0x6F\n                      else (int(dut.u_ex.rs1.value) + _sext(ex_insn >> 20, 12))\n                      & 0xFFFFFFFE)\n            if target & 3:\n                ex_write = False\n                self.coverage.add(\"jump_fault\")\n        address = (mem >> (len(dut.ex_mem_w) - 96)) & 0xFFFFFFFF\n        mem_fault = bool(mem_ctrl & 0xC0 and address % (1 << ((mem_ctrl >> 4) & 3)))\n        mem_write = bool(mem & 1 and mem_ctrl & 4 and not mem_fault)\n\n…[12188 of 15260 chars elided by tools/bench/transcript.py; sha256:0b9d3600b2fb542d]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
