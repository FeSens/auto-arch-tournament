k, 2: 7, 10: target_pc, 9: target_pc - 4,\n                        3: first & mask, 4: second & mask, 5: second & mask,\n                        6: 98, 7: 14, 8: 0}\n            for seed in (None, 0xF17A1, 0xBACC):\n                rets, memory, requests, _, fetch = await _run_handshakes(\n                    dut, program, {256: 98}, seed=seed)\n…[1707 of 4779 chars elided by tools/bench/transcript.py; sha256:dd2332d0f3d76f54]…\nt_pc + 16][\"cycle\"] - by_pc[target_pc + 12][\"cycle\"] == 10\n                    assert len(fetch[target_pc + 4]) == 9\n\n\ndef test_pipeline_runner():\n    # core.sv includes core_pkg.sv; give Verilator an explicit search path\n    # when the runner compiles from its separate build directory.\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"core\"\n    runner.build(\n        hdl_toplevel=\"core\",\n        sources=[str(RTL / name) for name in [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]],\n        includes=[str(RTL)], build_dir=str(build_dir), always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n        test_dir=str(TEST_DIR), build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
