{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' tools/eval/gowin.py\nrg --files -uuu cores/bench/generated bench | head -60\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[10043 of 13115 chars elided by tools/bench/transcript.py; sha256:85e1678cb13a70b9]…\nimple/core_portme.mak\nbench/programs/coremark/simple/core_portme.c\nbench/programs/coremark/simple/core_portme.h\nbench/programs/coremark/docs/html/search/GeneralI.html\nbench/programs/coremark/docs/html/search/GeneralG.html\nbench/programs/coremark/docs/html/search/FunctionsC.html\nbench/programs/coremark/docs/html/search/ConfigurationT.html\nbench/programs/coremark/docs/html/search/GeneralO.html\nbench/programs/coremark/docs/html/search/GeneralC.html\nbench/programs/coremark/docs/html/search/GeneralB.html\nbench/programs/coremark/docs/html/search/GeneralW.html\nbench/programs/coremark/docs/html/search/ConfigurationsS.html\nbench/programs/coremark/docs/html/search/BuildTargetsP.html\nbench/programs/coremark/docs/html/search/GeneralV.html\nbench/programs/coremark/docs/html/search/ConfigurationM.html\nbench/programs/coremark/docs/html/search/ConfigurationH.html\nbench/programs/coremark/docs/html/search/GeneralH.html\nbench/programs/coremark/docs/html/search/GeneralP.html\nbench/programs/coremark/docs/html/search/GeneralU.html\n", "exit_code": 0, "status": "completed"}}
