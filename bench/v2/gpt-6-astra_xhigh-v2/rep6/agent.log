n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    expected = _expected(op, a, b, expected)\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0\n…[6298 of 9370 chars elided by tools/bench/transcript.py; sha256:510eedf84b89dbeb]…\n = -3 (trunc to 0)\n    await _check_div(dut, ALU_DIV, 0x81003F7F, 16, 0xF81003F8)   # deep-formal trace\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 56.239\n  lut4: 3118\n  ff: 701\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261003-002-r6s1\n  updated: '2026-10-03T18:43:52.999425Z'\n", "exit_code": 0, "status": "completed"}}
