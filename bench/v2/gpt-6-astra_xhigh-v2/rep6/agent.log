{"type": "item.completed", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"sed -n '790,975p' cores/bench/test/test_pipeline.py; sed -n '230,370p' cores/bench/test/test_pipeline.py; tail -12 cores/bench/generated/r15s2_final_tests.log\"", "aggregated_output": "        assert [u[\"pc\"] for u in monitor.updates] == branch_pcs\n        assert [u[\"after\"] for u in monitor.updates] == [3] * 6 + [2, 1, 0, 0, 0, 0] + [1, 2, 3, 3, 3, 3]\n        assert {u[\"taken\"] for u in monitor.updates[:6]} == {False, True}\n        assert monitor.updates[0][\"before\"] == 2\n\n\n@cocotb.test()\nasync def agree_loop_exit_and_bubble_removal(dut):\n    \"\"\"Cold backward bias and warmed forward-taken bias both remove bubbles.\"\"\"\n    programs = [\n        [ADDI(1, 0, 20), ADDI(1, 1, -1), BNE(1, 0, -4), EBREAK()],\n        [ADDI(1, 0, 20), BNE(1, 0, 12), EBREAK(), 0xFFFFFFFF,\n         ADDI(1, 1, -1), JAL(0, -16)],\n    ]\n    for program in programs:\n        for seed in (None, 0xABCD):\n            monitor = _AgreeMonitor()\n            rets, _, requests, _, _ = await _run_handshakes(dut, program, seed=seed, monitor=monitor)\n            expected = ([0] + [pc for _ in range(20) for pc in (4, 8)] + [12]\n                        if len(program) == 4 else\n                        [0] + [pc for _ in range(20) for pc in (4, 16, 20)] + [4, 8])\n            assert [r[\"pc\"] for r in rets] == expected\n            assert all(not r[\"trap\"] for r in rets) and not requests\n            branches = [r for r in rets if r[\"insn\"] & 0x7F == 0x63]\n            assert len(monitor.updates) == len(branches)\n            assert [r[\"rs1_rdata\"] for r in branches] == (\n                list(range(19, -1, -1)) if len(program) == 4 else list(range(20, -1, -1)))\n            assert all(r[\"rs2_rdata\"] == 0 for r in branches)\n            assert len(monitor.recoveries) == (1 if len(program) == 4 else 2)\n            if seed is None:\n                # Once warm, every instruction retires in consecutive clocks.\n                for older, younger in zip(rets[8:-2], rets[9:-1]):\n                    assert younger[\"cycle\"] == older[\"cycle\"] + 1, (older, younger)\n                assert rets[-1][\"cycle\"] == rets[-2][\"cycle\"] + 2\n\n\n@cocotb.test()\nasync def prediction_direct_indirect_and_alignment(dut):\n    \"\"\"Links, consecutive transfers, PC+4 targets, reserved\n…[10530 of 13602 chars elided by tools/bench/transcript.py; sha256:4a4801a5342b7f41]…\n 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nasync def _run_handshakes(dut, program, dmem_init=None, seed=None,\n                          reset_at=None, restart=None, bus_control=None,\n                          monitor=None):\n    \"\"\"Sample requests at their accepting edge; check stalled bus stability.\n\n    Every memory request sees at least three wait cycles in stalled mode,\n    plus independent seeded imem/dmem stalls. Reset can replace the program\n    while division is outstanding, clearing the retirement scoreboard.\n    \"\"\"\n    rng = random.Random(seed)\n    dmem = dict(dmem_init or {})\n    rets, requests, fetch_cycles = [], [], {}\n    pending = None\n    wait_cycles = 0\n    stalls = 0\n    reset_done = False\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = 1\n......", "exit_code": 0, "status": "completed"}}
