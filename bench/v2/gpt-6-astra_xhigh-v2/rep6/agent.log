{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"sed -n '250,410p' cores/bench/test/test_alu.py\"","aggregated_output":"@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Every operation, including special cases, takes the same seven edges.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\ndef _signed(v):\n    v &= MASK32\n    return v - (1 << 32) if v & (1 << 31) else v\n\n\ndef _division_expected(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a, b = _signed(a), _signed(b)\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK32\n\n\n@cocotb.test()\nasync def arithmetic_vectors(dut):\n    await _setup(dut)\n    rng = random.Random(0xD181DE)\n    corners = [0, 1, 2, 3, 7, 16, 0x7FFFFFFF, 0x80000000, 0x80000001,\n               0xFFFFFFFD, 0xFFFFFFFE, 0xFFFFFFFF]\n    pairs = [(a, b) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128)]\n    pairs += [(sign_a * 42, sign_b * 7) for sign_a in (-1, 1) for sign_b in (-1, 1)]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in pairs:\n            await _check_div(dut, op, a, b, _division_expected(op, a, b))\n    # Keep all four multiplier paths combinational and cover high halves.\n    for a, b in pairs:\n        await _check(dut, ALU_MUL, a, b, (a & MASK32) * (b & MASK32))\n        await _check(dut, ALU_MULH, a, b, (_signed(a) * _signed(b)) >> 32)\n        await _check(dut, ALU_MULHU, a, b, ((a & MASK32) * (b & MASK32)) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (_signed(a) * (b & MASK32)) >> 32)\n\n\n@cocotb.test()\nasync def held_completion_and_reset(dut):\n    await _setup(dut)\n    # Reset during capture, each arithmetic round, and held completion.\n    for elapsed in range(6):\n        dut.op.value = ALU_DIV\n        dut.a.value = (-99) & MASK32\n        dut.b.value = 7\n        dut.div_request.value = 1\n        await _tick(dut)\n        dut.div_request.value = 0\n        for _ in range(elapsed):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(8):\n            await _tick(dut)\n            assert not int(dut.div_busy.value) and not int(dut.div_valid.value)\n        await _check_div(dut, ALU_DIVU, 91, 7, 13)\n    dut.op.value = ALU_REM\n    dut.a.value = (-99) & MASK32\n    dut.b.value = 7\n    dut.div_request.value = 1\n    await _tick(dut)\n    for _ in range(5):\n        await _tick(dut)\n    for i in range(9):\n        # Ordinary combinational operations remain available while DONE.\n        await _check(dut, ALU_ADD, i, 5, i + 5)\n        await _tick(dut)\n        assert int(dut.div_valid.value) and int(dut.div_busy.value)\n        assert int(dut.div_result.value) == MASK32\n    dut.div_request.value = 0\n    dut.div_consume.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    await _check_div(dut, ALU_DIV, 100, -7, -14)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n","exit_code":0,"status":"completed"}}
