{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"sed -n '70,142p' cores/bench/test/test_alu.py\"","aggregated_output":"        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    \"\"\"Accept at edge 0, expose after edge 7, transfer at edge 8 or later.\"\"\"\n    expected = _expected(op, a, b, expected)\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    dut.div_consume.value = 1  # early consume must not terminate a round\n    await _tick(dut)  # edge 0: accept\n    assert int(dut.div_busy.value) and not int(dut.div_valid.value)\n    if not ALTOPS:\n        dividend = abs(_signed(a)) if op in (ALU_DIV, ALU_REM) else a & MASK32\n        divisor = abs(_signed(b)) if op in (ALU_DIV, ALU_REM) else b & MASK32\n        assert int(dut.divisor_q.value) == divisor\n        assert int(dut.divisor3_q.value) == 3 * divisor\n        assert int(dut.quotient_q.value) == dividend\n        assert int(dut.remainder_q.value) == 0\n    # A competing request and changed inputs cannot replace the accepted one.\n    dut.op.value = ALU_REMU\n    dut.a.value = 0xA5A5A5A5\n    dut.b.value = 19\n    for edge in range(1, 8):  # seven registered intermediate rounds\n        dut.a.value = (0xA5A5A5A5 << edge) & MASK32\n        dut.b.value = (0xFFFFFFFF >> edge)\n        dut.op.value = ALU_DIV if edge & 1 else ALU_REMU\n        await _tick(dut)\n        assert int(dut.div_busy.value)\n        assert int(dut.div_valid.value) == (edge == 7)\n        if not ALTOPS:\n            # Independent integer division of the consumed dividend prefix\n            # checks every registered round, including zero-divisor behavior.\n            bits = 4 * edge\n            prefix = dividend >> (32 - bits)\n            q, r = divmod(prefix, divisor) if divisor else ((1 << bits) - 1, prefix)\n            assert int(dut.quotient_q.value) == ((dividend << bits) & MASK32) | q\n            assert int(dut.remainder_q.value) == r\n            assert int(dut.divisor_q.value) == divisor\n            assert int(dut.divisor3_q.value) == 3 * divisor\n    # The eighth round and correction are combinational BEFORE edge 8.\n    assert int(dut.div_valid.value)\n    assert int(dut.div_result.value) == (expected & MASK32), (\n        f\"op={op} a={a & MASK32:#x} b={b & MASK32:#x} \"\n        f\"expected={expected & MASK32:#x} got={int(dut.div_result.value):#x}\"\n    )\n    dut.div_consume.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.div_valid.value)  # availability is independent of consume\n    for i in range(hold_cycles):\n        # First blocked edge is edge 8: it saves the corrected result.\n        # Ordinary operations and competing requests cannot disturb DONE.\n        await _check(dut, ALU_ADD, i, 5, i + 5)\n        await _tick(dut)\n        assert int(dut.div_busy.value) and int(dut.div_valid.value)\n        assert int(dut.div_result.value) == expected\n    dut.div_consume.value = 1\n    await _tick(dut)  # edge 8 without stalls: transfer exactly once\n    # Request is still asserted at the consuming edge and must be ignored.\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    assert not int(dut.div_busy.value) and not int(dut.div_valid.value)\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n","exit_code":0,"status":"completed"}}
