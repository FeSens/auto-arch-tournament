{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench'); backup=root/'generated/r8s2_probe_backup'\nref=root/'generated/r8s2_reference_rtl';ref.mkdir(exist_ok=True)\nfor p in (root/'rtl').glob('*.sv'):\n src=backup/p.name if (backup/p.name).exists() else p\n shutil.copyfile(src,ref/p.name)\np=root/'rtl/if_stage.sv';s=backup.joinpath(p.name).read_text()\ns=s.replace('  logic [15:0] agree_msb;', '''  logic [15:0] agree_msb;\n  logic predict_agree_q;\n  logic [3:0] sequential_index;\n  assign sequential_index = pc[5:2] + 4'd1;\n  // Look up candidate next-PC rows in parallel; select the single-bit\n  // result using the same priorities and enable as the PC register.\n  always_ff @(posedge clock) begin\n    if (reset) predict_agree_q <= 1'b1;\n    else if (redirect) predict_agree_q <= agree_msb[redirect_target[5:2]];\n    else if (\"'!stall) predict_agree_q <= predicted_taken\n                                     ? agree_msb[direct_target[5:2]]\n                                     : agree_msb[sequential_index];\n  end'\"''')\ns=s.replace('imem_data[31] == agree_msb[pc[5:2]]','imem_data[31] == predict_agree_q')\np.write_text(s)\np=root/'test/test_pipeline.py';s=p.read_text()\ns=s.replace('        lookup_counters = self.counters.copy()\\\\n        assert value(dut.u_if.predict_agree_q) == self.snapshot\\\\n','',1) if False else s\n# Remove only the accidental helper edit; keep the scoreboard copy/check.\nstart=s.index('def _check_memory_accesses')\ns=s[:start]+s[start:].replace('        lookup_counters = self.counters.copy()\\\\n        assert value(dut.u_if.predict_agree_q) == self.snapshot\\\\n','')\np.write_text(s)\nPY\npython -m tools.eval.gowin bench --all-options > cores/bench/generated/r8s2_parallel_timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
