{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, subprocess, sys, time\nfrom pathlib import Path\nsys.path.insert(0, str(Path('test/cosim').resolve()))\nfrom reference import RV32IM\nfrom run_cosim import compare\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nsim = str(Path('cores/bench/obj_dir/cosim_sim').resolve())\nelf = 'bench/programs/coremark.elf'\nstart = time.monotonic()\ncpu = RV32IM()\ncpu.load_elf(elf)\ncount = 0\ncompleted = False\nwith subprocess.Popen([sim, elf, '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE, text=True) as proc:\n    for line in proc.stdout:\n        actual = json.loads(line)\n        expected = cpu.step()\n        assert expected is not None, count\n        result = compare([expected], [actual])\n        assert result['passed'], (count, result)\n        count += 1\n        if expected['insn'] == 0x00100073:\n            completed = True\n    assert proc.wait() == 0\nassert completed and not cpu.oob_access\nprint(json.dumps({'full_coremark_rvfi_passed': True, 'retirements': count, 'seconds': time.monotonic() - start}), flush=True)\nbench = subprocess.run([sim, elf, '50000000', '--bench', '--istall', '--dstall'], capture_output=True, text=True, check=True)\nmarker = json.loads(bench.stdout.splitlines()[-1])\nassert marker['ebreak'] and not marker['maxcycles_hit'] and not marker['oob']\nassert marker['bench_bracketed'] and marker['bench_stop_cycle'] > marker['bench_start_cycle']\nvalid, reason = validate_coremark_uart(marker['uart'], parse_iterations('.'))\nassert valid, reason\nmarker['bracketed_cycles'] = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert marker['bracketed_cycles'] == 4203513, marker\nprint(json.dumps(marker), flush=True)\nPY\"","aggregated_output":"{\"full_coremark_rvfi_passed\": true, \"retirements\": 2937037, \"seconds\": 15.913579061976634}\n{\"ebreak\": true, \"maxcycles_hit\": fals