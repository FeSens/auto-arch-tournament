{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nwt=Path.cwd();src=wt/'cores/bench/rtl'\nfor name in ['r6s0_raw_banked_lutram','r6s0_raw_onehot_lutram']:\n rtl=wt/'cores/bench/generated'/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in src.glob('*.sv'):shutil.copyfile(p,rtl/p.name)\n if name=='r6s0_raw_banked_lutram':\n  f=rtl/'reg_file.sv';s=f.read_text()\n  s=s.replace('  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] regs [0:31];','''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] regs_lo [0:15];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] regs_hi [0:15];''')\n  s=s.replace(\\\"      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\\\",\\\"      for (int i = 0; i < 16; i++) begin\\\\n        regs_lo[i] <= 32'b0;\\\\n        regs_hi[i] <= 32'b0;\\\\n      end\\\")\n  s=s.replace('      regs[w_addr] <= w_data;','      if (w_addr[4]) regs_hi[w_addr[3:0]] <= w_data;\\\\n      else regs_lo[w_addr[3:0]] <= w_data;')\n  for a in ['rs1','rs2']:s=s.replace(f'regs[{a}_addr]',f'({a}_addr[4] ? regs_hi[{a}_addr[3:0]] : regs_lo[{a}_addr[3:0]])')\n  f.write_text(s)\n else:\n  f=rtl/'core.sv';f.write_text(f.read_text().replace('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','logic [2:0] fwd_rs1_sel, fwd_rs2_sel;'))\n  f=rtl/'forward_unit.sv';s=f.read_text().replace('output logic [1:0] fwd_rs1','output logic [2:0] fwd_rs1').replace('output logic [1:0] fwd_rs2','output logic [2:0] fwd_rs2');a=s.index('  // Yosys')\n  s=s[:a]+'''  logic ex1, ex2, wb1, wb2;\n  assign ex1 = ex_mem_w_en && ex_mem_rd \"'!= 0 && ex_mem_rd == id_ex_rs1;\n  assign ex2 = ex_mem_w_en && ex_mem_rd != 0 && ex_mem_rd == id_ex_rs2;\n  assign wb1 = mem_wb_w_en && mem_wb_rd != 0 && mem_wb_rd == id_ex_rs1;\n  assign wb2 = mem_wb_w_en && mem_wb_rd != 0 && mem_wb_rd == id_ex_rs2;\n  assign fwd_rs1 = {!ex1 && wb1, ex1, !ex1 && !wb1};\n  assign fwd_rs2 = {!ex2 && wb2, ex