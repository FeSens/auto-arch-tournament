{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c \"sed -n '875,920p' cores/bench/test/test_alu.py\"","aggregated_output":"    await _tick(dut)\n    new_expected = _expected(ALU_REMU, 33, 5, 3)\n    assert int(dut.m_valid.value) and int(dut.div_result.value) == new_expected\n    dut.div_consume.value = 0\n    await _tick(dut)\n    assert int(dut.w_valid.value) and int(dut.w_result.value) == new_expected\n\n\n@pytest.mark.parametrize(\"altops\", [False, True], ids=[\"real\", \"altops\"])\ndef test_alu_runner(altops):\n    \"\"\"Run identical schedule/backpressure/reset checks with either datapath.\"\"\"\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"alu_altops\" if altops else \"alu\")\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"alu.sv\", \"m_finish.sv\", \"alu_test_top.sv\")],\n        includes=[str(RTL)],\n        hdl_toplevel=\"alu_test_top\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=\"alu_test_top\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"TEST_ALTOPS\": str(int(altops))},\n    )\n","exit_code":0,"status":"completed"}}
