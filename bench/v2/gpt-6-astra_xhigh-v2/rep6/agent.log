{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1; WIDE=(1<<64)-1\ns32=lambda n:n-(1<<32) if n>>31 else n\nrng=random.Random(0x20261003)\ncorners=[0,1,2,3,0x7fff,0x8000,0xffff,0x10000,0x7fffffff,0x80000000,0x80000001,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in corners for b in corners]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(25000)]\ndef csa(a,b,c):\n return (a\"'^b''^c)&WIDE,(((a&b)|(a&c)|(b&c))<<1)&WIDE\nfor a,b in pairs:\n for op in ('\"'MUL','MULH','MULHSU','MULHU'):\n  sa=op in ('MULH','MULHSU'); sb=op=='MULH'\n  al=a&65535; bl=b&65535\n  ah=(a>>16)-(65536 if sa and a>>31 else 0)\n  bh=(b>>16)-(65536 if sb and b>>31 else 0)\n  partial=[al*bl,al*bh,ah*bl,ah*bh]\n  assert all(-(1<<33)<=p<(1<<33) for p in partial)\n  rows=[partial[0]&WIDE,(partial[1]<<16)&WIDE,(partial[2]<<16)&WIDE,(partial[3]<<32)&WIDE]\n  x,y=csa(*rows[:3]); x,y=csa(x,y,rows[3]); full=(x+y)&WIDE\n  expected=((s32(a) if sa else a)*(s32(b) if sb else b))&WIDE\n  assert full==expected\nfor a,b in pairs:\n for op in ('DIV','DIVU','REM','REMU'):\n  signed=op in ('DIV','REM'); rem=op in ('REM','REMU')\n  A=abs(s32(a)) if signed else a; D=abs(s32(b)) if signed else b\n  negate=signed and ((s32(a)<0) if rem else ((bool(a>>31)\"'^bool(b>>31)) and b!=0))\n  q=A; r=0\n  for digit in range(16):\n   trial=(r<<2)|(q>>30)\n   k=max(k for k in range(4) if k*D<=trial)\n   r=trial-k*D; q=((q<<2)|k)&MASK\n   assert 0<=r<=MASK\n   if digit==14:\n    prefix=A>>2; refq,refr=divmod(prefix,D) if D else ((1<<30)-1,prefix)\n    assert (q,r)==(((A<<30)&MASK)|refq,refr)\n  value=r if rem else q\n  value=(-value if negate else value)&MASK\n  if b==0: expected=a if rem else MASK\n  elif signed:\n   qq=abs(s32(a))//abs(s32(b)); qq=-qq if (s32(a)<0) != (s32(b)<0) else qq\n   expected=(s32(a)-qq*s32(b) if rem else qq)&MASK\n  else: expected=a%b if rem else a//b\n  assert value==expected\nprint('\"'PASS:',len(pairs)*4,'signed-limb multiply/CSA cases;',len(pairs)*4,'split radix-4 DIV/REM cases, including 30-bit-prefix checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
