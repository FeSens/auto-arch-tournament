{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, subprocess, sys\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\nfrom run_cosim import compare\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\ncpu = RV32IM()\ncpu.load_elf('bench/programs/coremark.elf')\nproc = subprocess.Popen(['cores/bench/obj_dir/cosim_sim', 'bench/programs/coremark.elf', '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE, text=True)\ncount = 0\nmarker = None\nfor line in proc.stdout:\n    sim = json.loads(line)\n    if 'insn' not in sim:\n        marker = sim\n        continue\n    ref = cpu.step()\n    assert ref is not None, (count, sim)\n    result = compare([ref], [sim])\n    assert result['passed'], (count, result)\n    count += 1\n    if count % 500000 == 0:\n        print('Compared retirements:', count, flush=True)\nassert proc.wait() == 0\nassert marker and marker['ebreak'] and not marker['oob']\nassert marker['bench_bracketed']\nvalid, reason = validate_coremark_uart(marker['uart'], parse_iterations('.'))\nassert valid, reason\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert cycles > 0\nprint(json.dumps({'passed': True, 'retired': count, 'cycles': cycles, 'marker': marker, 'fitness_at_68_530_MHz': 68.530e6 * 10 / cycles}), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
