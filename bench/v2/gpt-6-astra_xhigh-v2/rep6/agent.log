{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM=(1<<32)-1\n\ndef seed(n,d):\n    q=r=0\n    for bit in range(3,-1,-1):\n        t=(r<<1)|((n>>bit)&1)\n        diff=(t-d)&31\n        take=not bool(diff&16)\n        q=(q<<1)|take\n        r=diff if take else t\n    return q,r\n\nfor n in range(16):\n    for d in range(16):\n        assert seed(n,d)==(divmod(n,d) if d else (15,n))\n\nrng=random.Random(9001)\nedge=[0,1,2,3,7,15,16,17,31,255,65535,0x3fffffff,0x40000000,0x7fffffff,0x80000000,0x80000001,0xfffffffe,M]\npairs=[(a,b) for a in edge for b in edge]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]\n\ndef signed(x): return x if x<1<<31 else x-(1<<32)\n\nfor op in ('DIV','DIVU','REM','REMU'):\n    for a,b in pairs:\n        s=op in ('DIV','REM')\n        A=abs(signed(a)) if s else a\n        D=abs(signed(b)) if s else b\n        n=A>>28\n        q0,r0=seed(n,D) if D<16 else (0,n)\n        q=((A<<4)&M)|q0\n        r=r0\n        for k in range(1,8):\n            for _ in range(2):\n                trial=(r<<2)|(q>>30)\n                digit=max(i for i in range(4) if i*D<=trial)\n                r=trial-digit*D\n                q=((q<<2)&M)|digit\n            bits=4+4*k\n            prefix=A>>(32-bits)\n            qp,rp=divmod(prefix,D) if D else ((1<<bits)-1,prefix)\n            assert (q,r)==((((A<<bits)&M)|qp),rp)\n        rem=op.startswith('REM')\n        negate=s and ((signed(a)<0) if rem else ((signed(a)<0)\"'!=(signed(b)<0) and b!=0))\n        val=r if rem else q\n        result=(-val if negate else val)&M\n        if b==0: exp=a if rem else M\n        elif s:\n            quot=abs(signed(a))//abs(signed(b))\n            if (signed(a)<0)!=(signed(b)<0): quot=-quot\n            exp=(signed(a)-quot*signed(b) if rem else quot)&M\n        else: exp=(a%b if rem else a//b)&M\n        assert result==exp,(op,a,b,result,exp)\nprint('\"'Verified all 256 nibble seed cases and',len(pairs)*4,'full-width RV32M cases with every recurrence boundary checked.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
