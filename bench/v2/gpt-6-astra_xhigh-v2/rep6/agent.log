{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK=(1<<32)-1\nrandom.seed(0x342023)\n\ndef radix4(a,b):\n    q=a; r=0\n    multiples=[0,b,2*b,3*b]\n    assert multiples[3] < (1<<34)\n    for rd in range(8):\n        for digit in range(2):\n            trial=(r<<2)|(q>>30)\n            diffs=[(trial-m)&((1<<35)-1) for m in multiples[1:]]\n            chosen=next((k for k in (3,2,1) if not (diffs[k-1]>>34)),0)\n            remainder=diffs[chosen-1] if chosen else trial\n            assert 0 <= remainder <= MASK\n            assert b==0 or remainder<b\n            r=remainder\n            q=((q<<2)|chosen)&MASK\n    return q,r\n\nvalues=[0,1,2,3,4,7,8,15,16,17,31,32,63,64,0x15555555,0x3fffffff,0x40000000,0x7fffffff,0x80000000,0x80000001,0xaaaaaaaa,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in values for b in values]\nfor b in values:\n    for k in range(1,5):\n        pairs.extend((a,b) for a in (k*b-1,k*b,k*b+1) if 0<=a<=MASK)\npairs.extend((random.getrandbits(32),random.getrandbits(32)) for _ in range(20000))\ncount=0\nfor a,b in pairs:\n    for signed in (False,True):\n        ai=a-(1<<32) if signed and a>>31 else a\n        bi=b-(1<<32) if signed and b>>31 else b\n        q,r=radix4(abs(ai),abs(bi))\n        q=(-q if signed and (ai<0)\"'!=(bi<0) and b!=0 else q)&MASK\n        r=(-r if signed and ai<0 else r)&MASK\n        eq=MASK if bi==0 else (-1 if (ai<0)!=(bi<0) else 1)*(abs(ai)//abs(bi))\n        er=ai if bi==0 else ai-bi*eq\n        assert (q,r)==(eq&MASK,er&MASK),(hex(a),hex(b),signed,q,r,eq,er)\n        count+=2\nprint('\"'Proposed arithmetic model matches integer reference for',count,'DIV/DIVU/REM/REMU results; full-width and remainder bounds passed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
