{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfrom collections import Counter\np=Path('cores/bench/generated/local-checks/netlist/impl/pnr/core_bench.vo')\nt=p.read_text()\ndef nets(expr):\n    out=[]\n    for m in re.finditer(r'(\\\\\\\\[\"'^'\"\\\\s,{}]+|[A-Za-z_]\\\\w*)\\\\s*(?:\\\\[(\\\\d+)(?::(\\\\d+))?\\\\])?',expr):\n        name,hi,lo=m.groups()\n        out.extend([name] if hi is None else [name+'['+str(i)+']' for i in range(int(lo or hi),int(hi)+1)])\n    return out\ncells=[]; drivers={}\nfor m in re.finditer(r'\"'^('\"\\\\w+)\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s+\\\\((.*?)\\\\);',t,re.M|re.S):\n    kind,name,body=m.groups()\n    ports=dict(re.findall(r'\\\\.(\\\\w+)\\\\((.*?)\\\\)',body,re.S))\n    cells.append((kind,name,ports))\n    outputs={'F'} if kind.startswith('LUT') else {'O'} if kind.startswith('MUX2') else {'SUM','COUT'} if kind=='ALU' else set()\n    if outputs:\n        inputs=[n for port,expr in ports.items() if port not in outputs for n in nets(expr)]\n        for port in outputs:\n            for net in nets(ports.get(port,'')):\n                drivers[net]=(name,inputs)\ndef cone(roots):\n    seen=set(); leaves=set(); todo=list(roots)\n    while todo:\n        n=todo.pop()\n        if n in seen: continue\n        seen.add(n)\n        if n in drivers: todo.extend(drivers[n][1])\n        else: leaves.add(n)\n    return seen,leaves\nreport=[]\nfor kind,name,ports in cells:\n    if kind\"'!='\"'MULT36X36': continue\n    report.append(name)\n    for port in ('A','B'):\n        seen,leaves=cone(nets(ports[port]))\n        forbidden=[n for n in seen if 'ctrl.alu_src' in n or 'ctrl.is_auipc' in n or n.startswith('\\\\\\\\cpu/u_ex/alu_a[') or n.startswith('\\\\\\\\cpu/u_ex/alu_b[') or n.startswith('\\\\\\\\cpu/id_ex_w.imm[') or n.startswith('\\\\\\\\cpu/id_ex_w.pc[')]\n        assert not forbidden,(name,port,forbidden)\n        report.append(f'