{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_stage.py'", "aggregated_output": "\"\"\"Acceptance-edge tests for the raw-instruction agree predictor.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, BNE, JAL, JALR, NOP, _b, _direct_target\n\n\n@cocotb.test()\nasync def predictor_acceptance_and_local_updates(dut):\n    rng = random.Random(0xA61EE)\n    pc, counters = 0, [2] * 16\n    dut.clock.value = 0\n\n    async def edge(insn=NOP(), stall=0, flush=0, recovery=None,\n                   update=None, reset=0):\n        nonlocal pc, counters\n        dut.reset.value = reset\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut.redirect.value = int(recovery is not None)\n        dut.redirect_target.value = recovery or 0\n        dut.imem_data.value = insn\n        dut.branch_update_valid.value = int(update is not None)\n        dut.branch_update_index.value = update[0] if update else 0\n        dut.branch_update_agree.value = update[1] if update else 0\n        await Timer(5, \"ns\")\n        if not reset:\n            assert int(dut.imem_addr.value) == pc\n            for index, count in enumerate(counters):\n                assert int(dut.g_agree[index].counter.value) == count\n            branch = insn & 0x7F == 0x63 and (insn >> 12) & 7 not in (2, 3)\n            target = _direct_target(pc, insn)\n            pred = bool(target & 3 == 0 and (insn & 0x7F == 0x6F or\n                        (branch and (insn >> 31) == (counters[(pc >> 2) & 15] >> 1))))\n            selected = pred and not flush and recovery is None\n            out = int(dut.out.value)\n            assert (out >> 1) & 1 == selected\n            assert out & 1 == (not flush and recovery is None)\n            if recovery is not None:\n                pc = recovery\n            elif not stall:\n                pc = target if pred else (pc + 4) & 0xFFFFFFFF\n            # Model the update after prediction: no same-edge bypass.\n            if update:\n                index, agree = update\n                counters[index] = min(3, counters[index] + 1) if agree else max(0, counters[index] - 1)\n        else:\n            pc, counters = 0, [2] * 16\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n        assert int(dut.imem_addr.value) == pc\n\n    await edge(reset=1)\n    # While fetch waits, an older EX branch reverses the selected cell's\n    # direction. Acceptance must use its new value, including after flush.\n    await edge(BEQ(0, 0, -4), stall=1, flush=1, update=(0, 0))\n    await edge(BEQ(0, 0, -4), stall=1)\n    await edge(BEQ(0, 0, -4))\n    assert pc == 4 and counters[0] == 1\n    # At an accepting edge, prediction sees the OLD cell, even when a\n    # simultaneous update crosses the MSB threshold.\n    await edge(recovery=0)\n    await edge(BEQ(0, 0, 64), update=(0, 1))\n    assert pc == 64 and counters[0] == 2\n    # Recovery wins over every fetch hold and over a direct-JAL prediction.\n    await edge(JAL(1, 128), stall=1, flush=1, recovery=0xFFFF0000)\n    # Cover all indices, both saturation endpoints, and reset cancellation.\n    for index in range(16):\n        for agree in (0, 0, 0, 0, 1, 1, 1, 1):\n            await edge(stall=1, update=(index, agree))\n    for cycle in range(400):\n        insn = rng.choice((BEQ(0, 0, -64), BNE(0, 0, 64),\n                           JAL(1, 0x7FFFC), JAL(1, -0x80000), JAL(1, 2),\n                           BEQ(0, 0, -2), _b(-64, 0, 0, 2, 0x63),\n                           _b(-64, 0, 0, 3, 0x63), JALR(1, 0, 0), NOP()))\n        await edge(insn, stall=rng.randrange(2), flush=rng.randrange(2),\n                   recovery=(rng.getrandbits(30) << 2) if cycle % 19 == 0 else None,\n                   update=(rng.randrange(16), rng.randrange(2)), reset=cycle % 97 == 0)\n\n\ndef test_if_stage_runner():\n    run_cocotb(\"if_stage\", [\"core_pkg.sv\", \"if_stage.sv\"], \"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
