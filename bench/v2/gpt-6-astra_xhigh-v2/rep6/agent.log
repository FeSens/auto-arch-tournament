{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nb=Path('/srv/hwebench/tmp/34139506/4bf936dd/predictor-r7s2-lh0u4bdx')\nfor name in ('rtl/if_stage.sv','rtl/id_stage.sv','test/test_if_stage.py','test/test_pipeline.py'):\n (Path('cores/bench')/name).write_bytes((b/name).read_bytes())\np=Path('cores/bench/rtl/ex_stage.sv');(b/'rtl/ex_stage.sv').write_bytes(p.read_bytes())\ns=p.read_text().replace('  assign redirect_target = resolved_pc_next;','''  // On a direction mismatch the actual outcome is the inverse of the\n  // accepted prediction. Prepare recovery without waiting for comparison.\n  assign redirect_target = in.predicted_taken ? in.pc + 32'd4\n                          : (in.ctrl.is_jump ? jump_target : branch_target);''');p.write_text(s)\nPY\npython -m tools.eval.gowin bench --all-options > cores/bench/generated/predictor-recoverytarget-timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
