d else \"a\"\n        operand_b = \"$signed(b)\" if signed else \"b\"\n        operator = \"%\" if remainder else \"/\"\n        exceptional = \"a\" if remainder else \"32'hffffffff\"\n        overflow = \"32'b0\" if remainder else \"32'h80000000\"\n        overflow_condition = (\n            \"a == 32'h80000000 && b == 32'hffffffff\" if signed else \"1'b0\"\n        )\n        (directory / \"miter.sv\").write_text(f\"\"\"\nmodule gold(input [31:0] a, b, output [31:0] ou\n…[1268 of 4340 chars elided by tools/bench/transcript.py; sha256:fafa1e94670c240d]…\nerflow). Quotient\n        # operations do not retain the unused last-step remainder.\n        cuts = []\n        if signed:\n            for ref, dut in ((\"A_buf_u\", \"dividend_magnitude\"),\n                             (\"B_buf_u\", \"divisor_magnitude\")):\n                cuts.append(f\"equiv_add {native}{ref}_gold dut.{dut}_gate\")\n        for k in range(1, 33 if remainder else 32):\n            hi, lo = k * 32 - 1, k * 32 - k\n            cuts.append(\n                f\"equiv_add {chain}_gold[{hi}:{lo}] dut.div_step[{k}].remainder_gate\"\n            )\n        if not remainder:\n            cuts.append(f\"equiv_add {native}Y_u_gold dut.div_quotient_gate\")\n        result = _yosys(\"\\n\".join([\n            \"read_rtlil mapped.il\",\n            \"equiv_make gold gate equivalence\",\n            \"hierarchy -top equivalence\",\n            \"cd equivalence\",\n            *cuts,\n            \"equiv_simple -short\",\n            \"equiv_status -assert\",\n        ]), directory, \"prove\")\n        assert \"Equivalence successfully proven!\" in result\n", "exit_code": 0, "status": "completed"}}
