   # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b00\n…[26462 of 29534 chars elided by tools/bench/transcript.py; sha256:56e454eae7b33a3f]…\nert rets[-1][\"cycle\"] == rets[-2][\"cycle\"] + 2\n\n\n@cocotb.test()\nasync def prediction_direct_indirect_and_alignment(dut):\n    \"\"\"Links, consecutive transfers, PC+4 targets, reserved and faulting ops.\"\"\"\n    program = [\n        JAL(1, 8), SW(0, 0, 256), JAL(2, 4), BEQ(0, 0, 4),\n        ADDI(3, 0, 33), JALR(4, 3, 0), DIV(20, 0, 0), 0xFFFFFFFF,\n        JAL(5, 2), BEQ(0, 0, 2), BNE(0, 0, -2),\n        _b(-4, 0, 0, 2, 0x63), _b(-4, 0, 0, 3, 0x63),\n        ADDI(6, 0, 63), JALR(7, 6, 0), JAL(8, -2),\n        BEQ(0, 0, -2), EBREAK(),\n    ]\n    for seed in (None, 0xA116, 0xBAD):\n        monitor = _AgreeMonitor()\n        rets, memory, requests, _, _ = await _run_handshakes(dut, program, seed=seed, monitor=monitor)\n        assert [r[\"pc\"] for r in rets] == [4 * i for i in range(len(program)) if i not in (1, 6, 7)]\n        assert {r[\"pc\"] for r in rets if r[\"trap\"]} == {32, 36, 44, 48, 56, 60, 64}\n        assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"]] == [\n            (1, 4), (2, 12), (3, 33), (4, 24), (6, 63)]\n", "exit_code": 0, "status": "completed"}}
