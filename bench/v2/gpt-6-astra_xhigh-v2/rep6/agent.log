{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM32=(1<<32)-1\nM64=(1<<64)-1\nM34=(1<<34)-1\n\ndef signed(x,width):\n    return x-(1<<width) if x & (1<<(width-1)) else x\n\ndef csa(a,b,c):\n    return (a\"'^b''^c)&M64, (((a&b)|(a&c)|(b&c))<<1)&M64\n\ndef multiply(a,b,op):\n    sa=op in ('\"'MULH','MULHSU')\n    sb=op=='MULH'\n    al=a&0xffff\n    bl=b&0xffff\n    ah=signed(((a>>31)&int(sa))<<16 | (a>>16),17)\n    bh=signed(((b>>31)&int(sb))<<16 | (b>>16),17)\n    pp=[al*bl,al*bh,ah*bl,ah*bh]\n    assert all(-(1<<33)<=p<(1<<33) for p in pp)\n    p00,p01,p10,p11=[signed(p&M34,34) for p in pp]\n    terms=[p00&M64,(p01<<16)&M64,(p10<<16)&M64,(p11<<32)&M64]\n    s,c=csa(*terms[:3])\n    s,c=csa(s,c,terms[3])\n    product=(s+c)&M64\n    a_ref=signed(a,32) if sa else a\n    b_ref=signed(b,32) if sb else b\n    assert product==(a_ref*b_ref)&M64,(op,a,b,product,a_ref*b_ref)\n    return product&M32 if op=='MUL' else product>>32\n\ncorners=[0,1,2,0x7fff,0x8000,0xffff,0x10000,0x10001,0x7fffffff,0x80000000,0x80000001,0xffff0000,0xffff0001,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in corners for b in corners]\nfor bit in range(32):\n    for delta in (-1,0,1):\n        a=((1<<bit)+delta)&M32\n        for b in corners:\n            pairs.extend([(a,b),(b,a)])\nrng=random.Random(0x4A17)\npairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(50000))\ncount=0\nfor op in ('MUL','MULH','MULHU','MULHSU'):\n    for a,b in pairs:\n        multiply(a,b,op)\n        count+=1\nprint(f'PASS: {count} multiply cases; all 64 reconstructed bits match exact signed/unsigned arithmetic, including 34-bit partial-product truncation and both carry-save levels.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM32=(1<<32)-1\nM64=(1<<64)-1\nM34=(1<<34)-1\n\ndef signed(x,width):\n    return x-(1<<width) if x & (1<<(width-1)) else x\n\ndef csa(a,b,c):\n    return (a\"'^b''^c)&M64, (((a&b)|(a&c)|(b&c))<<1)&M64\n\ndef multiply(a,b,op):\n    sa=op in ('\"'MULH','MULHSU')\n    sb=op=='MULH'\n    al=a&0xffff\n    bl=b&0xffff\n    ah=signed(((a>>31)&int(sa))<<16 | (a>>16),17)\n    bh=signed(((b>>31)&int(sb))<<16 | (b>>16),17)\n    pp=[al*bl,al*bh,ah*bl,ah*bh]\n    assert all(-(1<<33)<=p<(1<<33) for p in pp)\n    p00,p01,p10,p11=[signed(p&M34,34) for p in pp]\n    terms=[p00&M64,(p01<<16)&M64,(p10<<16)&M64,(p11<<32)&M64]\n    s,c=csa(*terms[:3])\n    s,c=csa(s,c,terms[3])\n    product=(s+c)&M64\n    a_ref=signed(a,32) if sa else a\n    b_ref=signed(b,32) if sb else b\n    assert product==(a_ref*b_ref)&M64,(op,a,b,product,a_ref*b_ref)\n    return product&M32 if op=='MUL' else product>>32\n\ncorners=[0,1,2,0x7fff,0x8000,0xffff,0x10000,0x10001,0x7fffffff,0x80000000,0x80000001,0xffff0000,0xffff0001,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in corners for b in corners]\nfor bit in range(32):\n    for delta in (-1,0,1):\n        a=((1<<bit)+delta)&M32\n        for b in corners:\n            pairs.extend([(a,b),(b,a)])\nrng=random.Random(0x4A17)\npairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(50000))\ncount=0\nfor op in ('MUL','MULH','MULHU','MULHSU'):\n    for a,b in pairs:\n        multiply(a,b,op)\n        count+=1\nprint(f'PASS: {count} multiply cases; all 64 reconstructed bits match exact signed/unsigned arithmetic, including 34-bit partial-product truncation and both carry-save levels.')\nPY\"","aggregated_output":"PASS: 212420 multiply cases; all 64 reconstructed bits match exact signed/unsigned arithmetic, including 34-bit partial-product truncation and both carry-save levels.\n","exit_code":0,"status":"completed"}}
