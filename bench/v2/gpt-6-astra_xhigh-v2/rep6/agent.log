{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\n\ndef divmod_network(a, b, width):\n    q = r = 0\n    for k in range(1, width + 1):\n        t = (r << 1) | ((a >> (width-k)) & 1)\n        d = (t - (b & ((1 << k)-1))) & ((1 << (k+1))-1)\n        take = not (b >> k) and not ((d >> k) & 1)\n        q = (q << 1) | int(take)\n        r = (d & ((1 << k)-1)) if take else t\n    return q, r\n\ncount = 0\nfor width in range(1, 9):\n    for a in range(1 << width):\n        for b in range(1 << width):\n            want = divmod(a,b) if b else ((1 << width)-1,a)\n            assert divmod_network(a,b,width) == want\n            count += 1\n\nmask = (1 << 32)-1\nrng = random.Random(0x20261003)\nvalues = {0,1,2,mask,mask-1,0x80000000,0x7fffffff}\nfor k in range(32):\n    values.update(((1 << k)-1, 1 << k, ((1 << k)+1) & mask))\npairs = [(a,b) for a in values for b in values]\npairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000))\nfor a,b in pairs:\n    for signed in (False,True):\n        sa = a-(1 << 32) if signed and (a >> 31) else a\n        sb = b-(1 << 32) if signed and (b >> 31) else b\n        q,r = divmod_network(abs(sa),abs(sb),32)\n        q = (-q if (sa < 0) \"'!= (sb < 0) else q) & mask\n        r = (-r if sa < 0 else r) & mask\n        if b == 0:\n            q,r = mask,a\n            wantq,wantr = mask,a\n        else:\n            wantq = abs(sa)//abs(sb)\n            if (sa < 0) != (sb < 0): wantq = -wantq\n            wantr = sa-wantq*sb\n            wantq &= mask\n            wantr &= mask\n        assert (q,r) == (wantq,wantr), (hex(a),hex(b),signed,(q,r),(wantq,wantr))\n        count += 1\nprint(f'\"'Proposed recurrence and signed wrappers match integer references for {count} cases; this checks the algorithm, not an RTL implementation or timing.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
