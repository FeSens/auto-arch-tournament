ells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n\nThe Yosys + nextpnr helpers below (run\n…[19391 of 22463 chars elided by tools/bench/transcript.py; sha256:76ed8e4dae06e0c0]…\nerate multiple if a bench program re-times.\n161:                bench_stop_cycle = cycle; bench_stop_set = true;\n172:                // OOB write (neither dmem nor UART). Flag so testbench reports it.\n214:            if (bench_mode) {\n215:                strncpy(bench_last, buf, sizeof(bench_last)-1);\n252:    if (bench_mode) {\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n256:        if (bench_last[0]) puts(bench_last);\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n269:               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n275:               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY' > \\\"\"'$TMPDIR/divider-coremark-trace.log\" 2>&1\nimport json, subprocess, sys, time\nfrom pathlib import Path\nsys.path.insert(0, str(Path('\"'test/cosim').resolve()))\nfrom reference import RV32IM\nfrom run_cosim import compare\nfrom tools.eval.fpga import run_coremark_ipc\nsim = str(Path('cores/bench/obj_dir/cosim_sim').resolve())\nelf = str(Path('bench/programs/coremark.elf').resolve())\ncpu = RV32IM()\ncpu.load_elf(elf)\nstart = time.monotonic()\nproc = subprocess.Popen([sim, elf, '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\nretired = 0\nfinished = False\ntry:\n    for line in proc.stdout:\n        actual = json.loads(line)\n        expected = cpu.step()\n        assert expected is not None, ('reference stopped', retired)\n        result = compare([expected], [actual])\n        assert result['passed'], (retired, result)\n        retired += 1\n        if retired % 250000 == 0:\n            print('Compared', retired, 'retirements in', round(time.monotonic()-start, 1), 's', flush=True)\n        if expected['insn'] == 0x00100073:\n            finished = True\n    rc = proc.wait()\n    assert rc == 0, (rc, proc.stderr.read())\n    assert finished, 'no terminal EBREAK'\nfinally:\n    if proc.poll() is None:\n        proc.kill()\n        proc.wait()\nprint(json.dumps({'full_retirement_cosim': 'passed', 'retired': retired, 'seconds': time.monotonic()-start}))\nmetrics = run_coremark_ipc('.', sim)\nprint(json.dumps(metrics, indent=2))\nassert metrics['completed'], metrics\nassert metrics['cycles'] == 4239051, metrics\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
