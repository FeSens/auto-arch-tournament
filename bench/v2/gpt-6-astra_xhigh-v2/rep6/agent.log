{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '305,470p' cores/bench/test/test_alu.py; cat cores/bench/test/_helpers.py; cat cores/bench/test/conftest.py; sed -n '1,80p' formal/run_all.sh\"", "aggregated_output": "def _signed(v):\n    v &= MASK32\n    return v - (1 << 32) if v & (1 << 31) else v\n\n\ndef _division_expected(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a, b = _signed(a), _signed(b)\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK32\n\n\n@cocotb.test()\nasync def arithmetic_vectors(dut):\n    await _setup(dut)\n    rng = random.Random(0xD181DE)\n    corners = [0, 1, 2, 3, 7, 16, 0x7FFFFFFF, 0x80000000, 0x80000001,\n               0xFFFFFFFD, 0xFFFFFFFE, 0xFFFFFFFF]\n    pairs = [(a, b) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128)]\n    pairs += [(sign_a * 42, sign_b * 7) for sign_a in (-1, 1) for sign_b in (-1, 1)]\n    # Quotient-bit groups cross powers of sixteen at every round boundary.\n    for shift in range(4, 32, 4):\n        boundary = 1 << shift\n        pairs += [(boundary + delta, b) for delta in (-1, 0, 1)\n                  for b in (1, 15, 16, 17, boundary - 1, boundary, boundary + 1,\n                            0x80000000, 0x80000001, 0xFFFFFFFF)]\n        pairs += [(MASK32, boundary + delta) for delta in (-1, 0, 1)]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in pairs:\n            await _check_div(dut, op, a, b, _division_expected(op, a, b))\n    # Keep all four multiplier paths combinational and cover high halves.\n    for a, b in pairs:\n        await _check(dut, ALU_MUL, a, b, (a & MASK32) * (b & MASK32))\n        await _check(dut, ALU_MULH, a, b, (_signed(a) * _signed(b)) >> 32)\n        await _check(dut, ALU_MULHU, a, b, ((a & MASK32) * (b & MASK32)) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (_signed(a) * (b & MASK32)) >> 32)\n\n\n@cocotb.test()\nasync def held_completion_and_reset(dut):\n    await _setup(dut)\n    # Reset from each round (including final availability), DONE and held \n…[7000 of 10072 chars elided by tools/bench/transcript.py; sha256:f39adb3f540ddf4a]…\nE_DIR=\n    for _ in 1 2 3 4 5 6 7 8; do\n        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n        if mkdir \"$try\" 2>/dev/null; then CORE_DIR=\"$try\"; break; fi\n    done\n    if [ -z \"$CORE_DIR\" ]; then\n        echo \"ERROR: could not create a work dir under $RISCV_FORMAL/cores\" >&2\n        exit 1\n    fi\nfi\nWORK_ID=\"${CORE_DIR##*-}\"\nLOG=\"$SCRIPT_DIR/last_run-$WORK_ID.log\"\n\n# Hold a lock on the work dir for this run's lifetime. The reaper below\n# only removes dirs whose lock nobody holds; flock works across users and\n# PID namespaces, unlike the old `kill -0 <pid>` test (from inside a\n# sandbox every outside PID looks dead). Without flock(1), nothing is reaped.\nHAVE_FLOCK=\nif command -v flock >/dev/null 2>&1; then\n    exec 9>\"$CORE_DIR/.owner.lock\"\n    flock 9\n    HAVE_FLOCK=1\nfi\n\n# Auto-detect single-issue cores from core.yaml when WRAPPER + CHECKS_CFG\n# are both unset and $1 (checks-cfg-path) wasn't given either. Explicit\n# env vars or $1 still win. Uses python3 to parse YAML robustly — bash\n", "exit_code": 0, "status": "completed"}}
