{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def recovery_kills_side_effects_without_target_load_hazard(dut):\n    \\\"\\\"\\\"Speculative EX controls cannot stall or affect the repaired target.\\\"\\\"\\\"\n    wrong_paths = (LW(4, 0, 272), SW(1, 0, 272), DIV(8, 4, 2),\n                   BNE(1, 2, 16), JALR(9, 4, 0), 0xFFFFFFFF)\n    for wrong_path in wrong_paths:\n        for seed in (None, 0xC1EA):\n            monitor = _AgreeMonitor()\n            program = [ADDI(1, 0, 7), ADDI(2, 0, 3), ADDI(4, 0, 100),\n                       BNE(1, 2, 8), wrong_path, DIV(3, 4, 2),\n                       SW(3, 0, 256), EBREAK()]\n            rets, memory, requests, _, _ = await _run_handshakes(\n                dut, program, seed=seed, monitor=monitor)\n            assert [r['pc'] for r in rets] == [0,4,8,12,20,24,28]\n            assert all(not r['trap'] for r in rets)\n            _check_rvfi_operands(rets)\n            assert memory == {256:33}\n            assert [(a,rd,wr) for a,rd,wr,_ in requests] == [(256,0,15)]\n            assert [u['pc'] for u in monitor.updates] == [12]\n            assert [r['pc'] for r in monitor.recoveries] == [12]\n            assert monitor.div_requests == [20]\n            if seed is None:\n                by_pc = {r['pc']:r for r in rets}\n                assert by_pc[20]['cycle']-by_pc[12]['cycle'] == 10\nPY\npython - <<'PY'\nimport json\nfrom pathlib import Path\nfor s in ['timing_valid_only.log','timing_control_bubbles.log']:\n p=Path('cores/bench/generated/r6s2_probe')/s\n try:print(s,json.loads(p.read_text())['summary'])\n except ValueError:print(s,'running')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
