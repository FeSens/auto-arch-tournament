pc;\n  assign btb_update_target = in.ctrl.is_jump ? jump_target : branch_target;\n  assign btb_update_kind = {in.ctrl.is_jump, in.instr[31]};\n  assign btb_update_valid = in.valid && ex_advance && !in.ctrl.is_illegal\n                        && !misalign_fault && (in.ctrl.is_branch || in.ctrl.is_jump)\n                        && btb_update_target[1:0] == 2'\"'b00;''');p.write_text(s)\np=base/'rtl/if_stage.sv';s=p.read_text().replace('  input  logic              branch_update_valid,', '''  input logic btb_update_valid,\n  input logic [31:0] btb_update_pc, btb_update_target,\n  input logic [1:0] btb_update_kind,\n  input  logic              branch_update_valid,''')\ns=s.replace('  logic legal_branch, direct_jump, predicted_taken;\\\\n  logic [31:0] direct_imm, direct_target;', '''  logic predicted_taken;\n  logic [31:0] btb_valid;\n  logic [24:0] btb_tag [0:31];\n  logic [29:0] btb_target [0:31];\n  logic [1:0] btb_kind [0:31];\n  logic btb_hit;\n  logic [4:0] lookup_index;\n  logic [31:0] predicted_target;\n  assign lookup_index = pc[6:2];\n  assign btb_hit = pc[1:0] == 2'b00 && btb_valid[lookup_index]\n                && btb_tag[lookup_index] == pc[31:7];\n  assign predicted_target = {btb_target[lookup_index], 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset) btb_valid <= '0;\n    else if (btb_update_valid) btb_valid[btb_update_pc[6:2]] <= 1'b1;\n    if (\"'!reset && btb_update_valid) begin\n      btb_tag[btb_update_pc[6:2]] <= btb_update_pc[31:7];\n      btb_target[btb_update_pc[6:2]] <= btb_update_target[31:2];\n      btb_kind[btb_update_pc[6:2]] <= btb_update_kind;\n    end\n  end'\"''')\nstart=s.index('  // Predecode the raw bus');end=s.index('  // EX only recovers',start)\ns=s[:start]+'''  always_comb begin\n    predicted_taken = btb_hit && (btb_kind[lookup_index][1] ||\n                         btb_kind[lookup_index][0] == agree_msb[pc[5:2]]);\n    next_pc = predicted_taken ? predicted_target : pc + 32'd4;\n  end\n\n'''+s[end:]\ns=s.replace('    out.