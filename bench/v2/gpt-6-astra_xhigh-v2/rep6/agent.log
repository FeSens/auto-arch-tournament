{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, pathlib, subprocess, time\np = pathlib.Path(os.environ['TMPDIR']) / 'shared_mul_equiv'\np.mkdir(exist_ok=True)\nrtl = pathlib.Path('cores/bench/rtl').resolve()\nrefs = {\n  11: \\\"{32'b0, a} * {32'b0, b}\\\",\n  12: \\\"\"'$signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b})\",\n  13: \"{32'\"'b0, a} * {32'b0, b}\\\",\n  14: \\\"\"'$signed({{32{a[31]}}, a}) * $signed({32'\"'b0, b})\\\",\n}\nfor op, ref in refs.items():\n    src = p / f'equiv_{op}.sv'\n    src.write_text(f'''module mul_equiv(input [31:0] a, b, output ok);\nwire [31:0] out;\nalu dut(.clock(1'b0), .reset(1'b0), .div_request(1'b0), .div_consume(1'b0),\n        .div_busy(), .div_valid(), .div_result(), .op(5'd{op}), .a(a), .b(b), .out(out));\nwire [63:0] reference_product = {ref};\nassign ok = out == reference_product[{\\\"31:0\\\" if op == 11 else \\\"63:32\\\"}];\nendmodule\n''')\n    script = f'read_verilog -sv {rtl}/core_pkg.sv {rtl}/alu.sv {src}; hierarchy -top mul_equiv; proc; flatten; opt; wreduce; opt; techmap; opt; sat -prove ok 1 -verify -timeout 60 -show-inputs'\n    start = time.monotonic()\n    with (p / f'equiv_{op}.log').open('w') as log:\n        result = subprocess.run(['yosys', '-p', script], stdout=log, stderr=subprocess.STDOUT, timeout=90)\n    print(op, result.returncode, round(time.monotonic()-start, 2), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
