{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '351,630p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; sed -n '1,160p' tools/eval/gowin.py; sed -n '1,180p' tools/eval/cosim.py\"", "aggregated_output": "async def _run_handshakes(dut, program, dmem_init=None, seed=None,\n                          reset_at=None, restart=None):\n    \"\"\"Sample requests at their accepting edge; check stalled bus stability.\n\n    Every memory request sees at least three wait cycles in stalled mode,\n    plus independent seeded imem/dmem stalls. Reset can replace the program\n    while division is outstanding, clearing the retirement scoreboard.\n    \"\"\"\n    rng = random.Random(seed)\n    dmem = dict(dmem_init or {})\n    rets, requests, fetch_cycles = [], [], {}\n    pending = None\n    wait_cycles = 0\n    stalls = 0\n    reset_done = False\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_dmemRData.value = 0\n\n    async def tick():\n        dut.clock.value = 0\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n\n    for _ in range(3):\n        await tick()\n    dut.reset.value = 0\n    for cycle in range(1500):\n        if cycle == reset_at:\n            assert int(dut.io_imemAddr.value) == 12, \"divide must hold fetch\"\n            assert all(r[\"pc\"] < 8 for r in rets), \"divide retired before reset\"\n            dut.reset.value = 1\n            await tick()\n            dut.reset.value = 0\n            program = restart\n            rets, requests, fetch_cycles = [], [], {}\n            pending = None\n            wait_cycles = 0\n            reset_done = True\n        ia = int(dut.io_imemAddr.value)\n        fetch_cycles.setdefault(ia, []).append(cycle)\n        dut.io_imemData.value = program[ia // 4] if ia // 4 < len(program) else EBREAK()\n        dut.io_imemReady.value = int(seed is None or rng.random() >= 0.22)\n        da = int(dut.io_dmemAddr.value)\n        ren = int(dut.io_dmemREn.value)\n        wen = int(dut.io_dmemWEn.value)\n        wd = int(dut.io_dmemWData.value)\n        request = (da, ren, wen, wd)\n        if pending is not None:\n            assert request == pending, f\"stalled request c\n…[25285 of 28357 chars elided by tools/bench/transcript.py; sha256:9c6fbd8948cfd345]…\nail': 'no ELFs found'}\n\n    # 1. Full-trace cosim of small ELFs (parallel).\n    with ThreadPoolExecutor() as pool:\n        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\n                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n", "exit_code": 0, "status": "completed"}}
