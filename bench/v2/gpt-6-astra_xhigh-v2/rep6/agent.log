merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    ?= $(or $(AGENT_PROVIDER),codex)\nBASE     ?=\nCOREMARK ?=\nLUT      ?=\nWORKTREE ?= 1\n\n# Compose optional CLI flags for the orchestrator. Empty vars produce\n# empty strings so the orchestrator falls back to its defaults.\nORCH_FLAGS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[5129 of 8201 chars elided by tools/bench/transcript.py; sha256:f9f87071f8de800d]…\nCH_TARGET_FLAG)\nendif\n\nreport:\n\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\n\nclean:\n\trm -rf test/cosim/sim_build sim_build out\n\trm -rf experiments/worktrees\n\trm -f bench/programs/*.elf\n\trm -f test/*.result.xml\n\tfind test -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\n\tfind tools -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 47.574\n  lut4: 3181\n  ff: 675\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261003-003-r4s2\n  updated: '2026-10-03T17:40:23.636455Z'\n", "exit_code": 0, "status": "completed"}}
