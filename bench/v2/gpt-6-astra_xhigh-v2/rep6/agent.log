{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport yaml,json,jsonschema\np=Path('cores/bench/experiments/hypotheses/hyp-20261003-002-r6s1.yaml')\nd=yaml.safe_load(p.read_text())\nold='''cocotb runner passed all 27 cases. Full formal and stalled CoreMark\nvalidation are being checked separately; these timing results are\nprototype evidence, not tournament acceptance. The temporary RTL will\nbe restored before delivering this hypothesis for normal implementation.\n'''\nnew='''cocotb runner passed all 27 cases, and all 53 unchanged normal formal\nchecks passed. The unchanged cosim evaluator passed selftest retirement\ncomparison with and without stalls and the canonical stalled CoreMark\nCRC/UART validation. CoreMark measured exactly 4,203,513 bracketed\ncycles for ten iterations, identical to the champion. Combining this\ncycle count with the measured median gives 133.79 iterations/second,\nabout 9.96 percent above 121.67. These are proposal-stage measurements,\nnot tournament acceptance. Temporary RTL was restored after measuring;\nimplement the proposal normally and rerun the unchanged gates.\n'''\nassert old in d['hypothesis']\nd['hypothesis']=d['hypothesis'].replace(old,new)\nclass D(yaml.SafeDumper):\n pass\ndef rep(dumper,value):\n return dumper.represent_scalar('tag:yaml.org,2002:str',value,style='|' if '\\\\n' in value else None)\nD.add_representer(str,rep)\np.write_text(yaml.dump(d,Dumper=D,sort_keys=False,width=78))\njsonschema.validate(yaml.safe_load(p.read_text()),json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Schema valid; fitness',56.239e6*10/4203513,'gain percent',(56.239e6*10/4203513/121.67-1)*100)\nbase=Path('cores/bench/rtl'); stash=Path('cores/bench/generated/r6s1')\nfor name in ('core.sv','id_stage.sv','core_pkg.sv','mem_stage.sv'):\n (base/name).write_text((stash/(name+'.original')).read_text())\n(base/'ex_stage.sv').write_te