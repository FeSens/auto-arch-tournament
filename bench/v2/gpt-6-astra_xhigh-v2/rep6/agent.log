[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[11240 of 14312 chars elided by tools/bench/transcript.py; sha256:f4b78b8048c5de99]…\nch_stop_cycle\")}'}\n271:    ipc = iterations / elapsed_cycles\n273:            'iterations': iterations, 'bracketed_cycles': True}\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n301:    reported_iterations = _uart_int(uart, r'Iterations\\s*:\\s*(\\d+)')\n302:    if reported_iterations != iterations:\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n341:        'ipc_coremark': float,           — iter/cycle\n343:        'cycles': int, 'iterations': int,\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n388:        'iterations':    cm['iterations'],\n", "exit_code": 0, "status": "completed"}}
