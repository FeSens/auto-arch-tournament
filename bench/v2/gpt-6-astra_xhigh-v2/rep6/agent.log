{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations are combinational. Division uses a\nbounded request/completion handshake with eight rounds of two radix-4 digits.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport pytest\nimport random\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    RTL, TEST_DIR, SIM_BUILD,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\n\n\ndef _expected(op, a, b, real_result):\n    \"\"\"Keep real arithmetic assertions and test the exact formal substitutes.\"\"\"\n    if ALTOPS:\n        masks = {ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n                 ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n                 ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n                 ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1}\n        if op in masks:\n            value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n            return (value ^ masks[op]) & MASK32\n    return real_result & MASK32\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    expected = _expected(op, a, b, expected)\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expe\n…[4451 of 7523 chars elided by tools/bench/transcript.py; sha256:c34c1c5e826170b6]…\ndut, ALU_SRL, 0x80000000, 1, 0x40000000)\n    await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n\n\n@cocotb.test()\nasync def mulh(dut):\n    await _setup(dut)\n    # INT_MIN * 2 = -2^32; high half = -1\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n", "exit_code": 0, "status": "completed"}}
