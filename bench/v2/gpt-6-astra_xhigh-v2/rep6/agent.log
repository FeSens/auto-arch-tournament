{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations are combinational. Division uses a\nbounded request/completion handshake with four eight-bit rounds.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Check exact seven-edge schedule, operand capture and sticky completion.\"\"\"\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    await _tick(dut)  # edge 0: accept\n    assert int(dut.div_busy.value) and not int(dut.div_valid.value)\n    # A competing request and changed inputs cannot replace the accepted one.\n    dut.op.value = ALU_REMU\n    dut.a.value = 0xA5A5A5A5\n    dut.b.value = 19\n    for _ in range(4):  # edges 1..4: arithmetic only\n        await _tick(dut)\n        assert int(dut.div_busy.value) and not int(dut.div_valid.value)\n    awa\n…[7717 of 10789 chars elided by tools/bench/transcript.py; sha256:89d771b6efd14599]…\nor _ in range(8):\n            await _tick(dut)\n            assert not int(dut.div_busy.value) and not int(dut.div_valid.value)\n        await _check_div(dut, ALU_DIVU, 91, 7, 13)\n    dut.op.value = ALU_REM\n    dut.a.value = (-99) & MASK32\n    dut.b.value = 7\n    dut.div_request.value = 1\n    await _tick(dut)\n    for _ in range(5):\n        await _tick(dut)\n    for i in range(9):\n        # Ordinary combinational operations remain available while DONE.\n        await _check(dut, ALU_ADD, i, 5, i + 5)\n        await _tick(dut)\n        assert int(dut.div_valid.value) and int(dut.div_busy.value)\n        assert int(dut.div_result.value) == MASK32\n    dut.div_request.value = 0\n    dut.div_consume.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    await _check_div(dut, ALU_DIV, 100, -7, -14)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
