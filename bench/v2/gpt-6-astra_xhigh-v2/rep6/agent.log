cs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[13474 of 16546 chars elided by tools/bench/transcript.py; sha256:c997f25a28d0a593]…\nnt(dut.div_valid.value)\n        assert int(dut.div_token.value) == token\n    dut.div_consume.value = 1\n    await _tick(dut)  # edge 8 without stalls: transfer exactly once\n    # Request is still asserted at the consuming edge and must be ignored.\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    assert not int(dut.div_busy.value) and not int(dut.div_valid.value)\n    assert int(dut.m_valid.value)\n    assert int(dut.div_result.value) == expected, (\n        f\"op={op} a={a & MASK32:#x} b={b & MASK32:#x} \"\n        f\"expected={expected:#x} got={int(dut.div_result.value):#x}\")\n    # Younger live arithmetic inputs cannot affect the registered token.\n    dut.op.value = ALU_ADD\n    dut.a.value = 123\n    dut.b.value = 456\n    await _tick(dut)\n    assert int(dut.w_valid.value) and int(dut.w_result.value) == expected\n    assert not int(dut.m_valid.value)\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n", "exit_code": 0, "status": "completed"}}
