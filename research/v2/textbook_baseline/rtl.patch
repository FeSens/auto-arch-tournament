+    .reset  (reset),
+    .req    (div_req),
+    .ack    (div_req && div_done && !stall),
+    .op     (in.ctrl.alu_op),
+    .a      (rs1),
+    .b      (rs2),
+    .done   (div_done),
+    .result (div_result)
