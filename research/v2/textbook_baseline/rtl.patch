@@ -59,6 +65,60 @@
     .out (alu_result)
   );
 
+  // ── Iterative divider ─────────────────────────────────────────────────
+  // The operands are latched when the divide starts: while it waits in EX
+  // the instructions ahead of it drain, so the forwarding paths that fed
+  // it on its first cycle are gone by the time it completes. The latched
+  // values also feed EX/MEM's rs1_val/rs2_val (RVFI rs1/rs2_rdata).
+  logic        div_req;
+  logic        div_done;
+  logic [31:0] div_result;
+  logic [31:0] div_rs1_q;
+  logic [31:0] div_rs2_q;
+  logic [31:0] ex_result;
+  logic [31:0] ex_rs1;
+  logic [31:0] ex_rs2;
+
+  always_comb begin
+    div_req = in.valid && !in.ctrl.is_illegal
+              && (in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU
