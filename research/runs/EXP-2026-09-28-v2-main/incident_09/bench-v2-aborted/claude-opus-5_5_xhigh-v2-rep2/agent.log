            kill,             // registered mispredict (EX/MEM)\n  input  logic [31:0]       redirect_pc,      // EX/MEM.pc_next\n  // BHT update (from EX/MEM)\n  input  logic              bht_upd_en,\n  input  logic [7:0]        bht_upd_idx,\n  input  logic [1:0]        bht_upd_ctr,\n  input  logic              bht_upd_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [29:0] pc_q;\n  logic [31:0] pc;\n  assign pc = {pc_q, 2'b00};\n\n  logic        pred_taken;\n  logic [31:0] pred_target;\n  logic [1:0]  pred_ctr;\n\n  branch_predictor u_bp (\n    .clock       (clock),\n    .pc          (pc),\n    .instr       (imem_data),\n    .upd_en      (bht_upd_en),\n    .upd_idx     (bht_upd_idx),\n    .upd_ctr     (bht_upd_ctr),\n    .upd_taken   (bht_upd_taken),\n    .pred_taken  (pred_taken),\n    .pred_target (pred_target),\n    .pred_ctr    (pred_ctr)\n  );\n\n  logic [31:0] next_pc;\n  always_comb begin\n    next_pc = pred_taken ? pred_target : pc + 32'd4;\n  end\n\n  // kill overrides every stall. pred_taken is used ungated here: the\n  // only case where the fetched word is invalid without kill is an\n  // imem stall, and that also holds the PC via `stall`.\n  always_ff @(posedge clock) begin\n    if      (reset)  pc_q <= 30'b0;\n    else if (kill)   pc_q <= redirect_pc[31:2];\n    else if (!stall) pc_q <= next_pc[31:2];\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc         = pc;\n    out.instr      = imem_data;\n    out.valid      = !flush;\n    out.pred_taken = pred_taken && !flush;\n    out.pred_ctr   = pred_ctr;\n  end\n\nendmodule\n", "structuredPatch": [{"oldStart": 1, "oldLines": 57, "newStart": 1, "newLines": 85, "lines": [" // rtl/if_stage.sv", " //", "-// Instruction fetch stage. Holds the PC register; the IF/ID payload", "-// (pc + instr + valid) is *combinational* — there is no separate IF/ID", "-// flop in this microarchitecture, the next-stage's ID/EX register", "-// captures everything one cycle later.", "+// Instruction fetch stage. Holds the PC register and the fetch-stage", "+// branch predictor; the IF/ID payload (pc + instr + valid + prediction)", "+// is *combinational* — there is no separate IF/ID flop in this", "+// microarchitecture, the ID/EX register captures everything one cycle", "+// later.", " //", "-// On flush or redirect, the instruction emitted to ID is forced to NOP", "-// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from", "-// observing a real rs1/rs2 from a wrong-path instruction and inserting", "-// a spurious load-use stall the cycle after a taken branch.", "+// The fetched word is passed through RAW (no NOP mux): validity is", "+// carried only in out.valid, and ID/EX captures a bubble for !valid.", "+// out.pred_taken is forced to 0 whenever out.valid = 0.", " //", "+// Mispredicts are resolved in EX and acted on one cycle later from the", "+// EX/MEM register (`kill`, `redirect_pc` = EX/MEM.pc_next), so the PC", "+// mux sees only flop-sourced redirect state.", "+//", "+// PC is always 4-byte aligned (reset 0, pc+4, predicted targets with", "+// imm[1]=0, EX/MEM.pc_next falls back to pc+4 on misalign), so only", "+// pc[31:2] is stored.", "+//", " // Latency:        PC-reg update is synchronous; output is combinational.", "-// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via", "-//                 EX-stage redirect).", "+// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB).", " module if_stage (", "   input  logic              clock,", "   input  logic              reset,", "-  input  logic              stall,            // hold PC (load-use)", "-  input  logic              flush,            // emit NOP into ID this cycle", "-  input  logic              redirect,         // EX has resolved a branch/jump", "-  input  logic [31:0]       redirect_target,", "+  input  logic              stall,            // hold PC", "+  input  logic              flush,            // fetched word invalid this cycle", "+  input  logic              kill,             // registered mispredict (EX/MEM)", "+  input  logic [31:0]       redirect_pc,      // EX/MEM.pc_next", "+  // BHT update (from EX/MEM)", "+  input  logic              bht_upd_en,", "+  input  logic [7:0]        bht_upd_idx,", "+  input  logic [1:0]        bht_upd_ctr,", "+  input  logic              bht_upd_taken,", "   output logic [31:0]       imem_addr,", "   input  logic [31:0]       imem_data,", "   output if_id_t  out", " );", " ", "-  localparam logic [31:0] RESET_PC = 32'h0000_0000;", "-", "+  logic [29:0] pc_q;", "   logic [31:0] pc;", "-  logic [31:0] next_pc;", "+  assign pc = {pc_q, 2'b00};", " ", "+  logic        pred_taken;", "+  logic [31:0] pred_target;", "+  logic [1:0]  pred_ctr;", "+", "+  branch_predictor u_bp (", "+    .clock       (clock),", "+    .pc          (pc),", "+    .instr       (imem_data),", "+    .upd_en      (bht_upd_en),", "+    .upd_idx     (bht_upd_idx),", "+    .upd_ctr     (bht_upd_ctr),", "+    .upd_taken   (bht_upd_taken),", "+    .pred_taken  (pred_taken),", "+    .pred_target (pred_target),", "+    .pred_ctr    (pred_ctr)", "+  );", "+", "+  logic [31:0] next_pc;", "   always_comb begin", "-    next_pc = redirect ? redirect_target : pc + 32'd4;", "+    next_pc = pred_taken ? pred_target : pc + 32'd4;", "   end", " ", "-  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire", "-  // redirect on the same cycle as imem_stall or dmem_stall — without", "-  // this priority the redirect target would be silently dropped, the", "-  // PC would hold its old (wrong-path) value, and execution would", "-  // resume on the wrong path once the bus unstalls. Verified by the", "-  // VexRiscv-binary CoreMark sweep with --istall enabled.", "+  // kill overrides every stall. pred_taken is used ungated here: the", "+  // only case where the fetched word is invalid without kill is an", "+  // imem stall, and that also holds the PC via `stall`.", "   always_ff @(posedge clock) begin", "-    if      (reset)    pc <= RESET_PC;", "-    else if (redirect) pc <= redirect_target;", "-    else if (!stall)   pc <= next_pc;", "+    if      (reset)  pc_q <= 30'b0;", "+    else if (kill)   pc_q <= redirect_pc[31:2];", "+    else if (!stall) pc_q <= next_pc[31:2];", "   end", " ", "   assign imem_addr = pc;", " ", "   always_comb begin", "-    out.pc    = pc;", "-    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;", "-    out.valid = !(flush || redirect);", "+    out.pc         = pc;", "+    out.instr      = imem_data;", "+    out.valid      = !flush;", "+    out.pred_taken = pred_taken && !flush;", "+    out.pred_ctr   = pred_ctr;", "   end", " ", " endmodule"]}], "originalFile": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\n", "userModified": false}}
