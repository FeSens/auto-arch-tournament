───────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else if (mdu_stall) begin\n      // M-op still executing: bubble into EX/MEM (valid=0, no reg/mem\n      // write) so older instructions drain through MEM/WB.\n      reg_q <= '0;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target). The MEM/WB register's read-data\n      // mux only kicks in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4)\n                            : in.ctrl.is_mdu  ? mdu_result\n                                              : alu_result;\n      reg_q.write_data    <= rs2_ret;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= rs1_ret;\n      reg_q.rs2_val       <= rs2_ret;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "structuredPatch": [{"oldStart": 147, "oldLines": 25, "newStart": 147, "newLines": 58, "lines": ["     end", "   end", " ", "-  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;", "+  // ID/EX may hold a squashed (valid=0) slot with garbage ctrl, so the", "+  // redirect is qualified by valid here (a single registered AND).", "+  assign redirect        = in.valid && (branch_taken || in.ctrl.is_jump)", "+                           && !misalign_fault;", "   assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;", " ", "+  // ── Dedicated data-memory address adder ───────────────────────────────", "+  // rs1 + imm only (no ALU op mux / shifter in front of the dmem BSRAM", "+  // address register). Equals alu_result for every LOAD/STORE.", "+  logic [31:0] mem_addr;", "+  assign mem_addr = rs1 + in.imm;", "+", "   // ── EX/MEM register ───────────────────────────────────────────────────", "-  ex_mem_t reg_q;", "+  // Squash by valid bit: an invalid ID/EX slot, or an M-op still", "+  // executing in the MDU (bubble so older instructions drain through", "+  // MEM/WB), is captured with valid=0 and every side-effect ctrl bit", "+  // cleared. Data fields have no reset; they are only ever consumed", "+  // under a valid-qualified ctrl bit.", "+  logic  ex_valid;", "+  ctrl_t ctrl_next;", " ", "+  always_comb begin", "+    ex_valid             = in.valid && !mdu_stall;", "+    ctrl_next            = ctrl_with_trap;", "+    ctrl_next.reg_write  = ctrl_with_trap.reg_write  && ex_valid;", "+    ctrl_next.mem_read   = ctrl_with_trap.mem_read   && ex_valid;", "+    ctrl_next.mem_write  = ctrl_with_trap.mem_write  && ex_valid;", "+    ctrl_next.is_illegal = ctrl_with_trap.is_illegal && ex_valid;", "+    ctrl_next.is_mdu     = ctrl_with_trap.is_mdu     && ex_valid;", "+  end", "+", "+  ctrl_t ctrl_q;", "+  logic  valid_q;", "+", "+  // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE", "+  // stays in MEM stage waiting on the bus.", "   always_ff @(posedge clock) begin", "     if (reset) begin", "-      reg_q <= '0;", "-    end else if (stall) begin", "-      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE", "-      // stays in MEM stage waiting on the bus.", "-      reg_q <= reg_q;", "-    end else if (mdu_stall) begin", "-      // M-op still executing: bubble into EX/MEM (valid=0, no reg/mem", "-      // write) so older instructions drain through MEM/WB.", "-      reg_q <= '0;", "-    end else begin", "+      ctrl_q  <= '0;", "+      valid_q <= 1'b0;", "+    end else if (!stall) begin", "+      ctrl_q  <= ctrl_next;", "+      valid_q <= ex_valid;", "+    end", "+  end", "+", "+  ex_mem_t reg_q;", "+", "+  always_ff @(posedge clock) begin", "+    if (!stall) begin", "       reg_q.pc            <= in.pc;", "+      reg_q.mem_addr      <= mem_addr;", "       // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's", "       // sum (which is the jump target). The MEM/WB register's read-data", "       // m