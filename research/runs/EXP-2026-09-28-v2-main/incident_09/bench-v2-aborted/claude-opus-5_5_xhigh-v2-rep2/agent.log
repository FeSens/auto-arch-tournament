em_ready && ex_mem_mem_op;\n\n    // PC reg holds on any stall reason.\n    stall_if      = load_use_hazard || imem_stall || dmem_stall || mdu_stall;\n    // IF/ID combinational payload invalid whenever we don't have a valid\n    // instruction this cycle (wrong path being killed, or imem didn't\n    // deliver). Both sources are input/flop-driven.\n    flush_if      = kill || imem_stall;\n    // ID/EX register:\n    //   - dmem_stall  -> hold        (preserve in-flight pipeline state)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - kill        -> bubble      (kill wrong-path; the mispredicted\n    //                                 branch/jump sits in EX/MEM and has\n    //                                 no memory op, so kill and\n    //                                 dmem_stall never coincide)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    //   - mdu_stall   -> hold        (M-op waits in ID/EX; an M-op is\n    //                                 never a load or a branch/jump, so\n    //                                 load_use can't coincide; mdu_stall\n    //                                 is gated by kill in ex_stage)\n    stall_id      = dmem_stall || load_use_hazard || mdu_stall;\n    flush_id      = (load_use_hazard && !dmem_stall) || kill;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "structuredPatch": [{"oldStart": 8, "oldLines": 8, "newS