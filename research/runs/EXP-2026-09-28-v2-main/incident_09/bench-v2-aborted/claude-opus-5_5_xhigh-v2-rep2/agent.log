    dut.upd_en.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def jal_always_predicted(dut):\n    await _setup(dut)\n    for pc, off in [(0x100, 8), (0x100, -0x100), (0x2000, 0x7FFFC),\n                    (0x80000, -0x80000)]:\n        taken, tgt, _ = await _probe(dut, pc, JAL(1, off))\n        assert taken == 1, f\"JAL pc={pc:#x} off={off}\"\n        assert tgt == (pc + off) & 0xFFFFFFFF, f\"target {tgt:#x}\"\n\n\n@cocotb.test()\nasync def branch_follows_counter(dut):\n    await _setup(dut)\n    pc = 0x40\n    idx = (pc >> 2) & 0xFF\n    # Initial weakly-taken.\n    taken, tgt, ctr = await _probe(dut, pc, BEQ(1, 2, -16))\n    assert (taken, tgt, ctr) == (1, pc - 16, 2)\n    # Not-taken update: 2 -> 1, predicted not taken.\n    await _write(dut, idx, 2, 0)\n    taken, _, ctr = await _probe(dut, pc, BEQ(1, 2, -16))\n    assert (taken, ctr) == (0, 1)\n    # Saturate at 0.\n    await _write(dut, idx, 0, 0)\n    _, _, ctr = await _probe(dut, pc, BEQ(1, 2, 64))\n    assert ctr == 0\n    # Saturate at 3.\n    await _write(dut, idx, 3, 1)\n    taken, tgt, ctr = await _probe(dut, pc, BEQ(1, 2, 64))\n    assert (taken, tgt, ctr) == (1, pc + 64, 3)\n    # Increment 1 -> 2.\n    await _write(dut, idx, 1, 1)\n    _, _, ctr = await _probe(dut, pc, BEQ(1, 2, 64))\n    assert ctr == 2\n    # Different index unaffected.\n    _, _, ctr = await _probe(dut, pc + 4, BEQ(1, 2, 64))\n    assert ctr == 2\n\n\n@cocotb.test()\nasync def no_prediction_cases(dut):\n    await _setup(dut)\n    # imm[1] = 1 -> misaligned target, never predicted.\n    taken, _, _ = await _probe(dut, 0x100, JAL(0, 6))\n    assert taken == 0\n    taken, _, _ = await _probe(dut, 0x100, BEQ(0, 0, -2))\n    assert taken == 0\n    # Target leaves the current 1 MiB region -> not predicted.\n    taken, _, _ = await _probe(dut, 0x10, JAL(0, -0x20))\n    assert taken == 0\n    taken, _, _ = await _probe(dut, 0xFFFF0, JAL(0, 0x20))\n    assert taken == 0\n    # JALR and non-control ops never predicted.\n 