{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfYBNJ8sTBCyQi1U4MYwJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CWovwLkhHizHdoYRKjho67","name":"Write","input":{"file_path":"/srv/hwebench/clones/claude-opus-5_5_xhigh-v2-rep2/cores/bench/worktrees/hyp-20260929-003-r1s2/cores/bench/rtl/branch_predictor.sv","content":"// rtl/branch_predictor.sv\n//\n// Fetch-stage branch predictor. Predecodes the raw fetched word so the\n// PC mux can steer the very next fetch without a bubble:\n//   - JAL             : always predicted taken, target = pc + J-imm.\n//   - BRANCH          : predicted taken iff BHT[pc[9:2]][1] is set,\n//                       target = pc + B-imm.\n//   - anything else   : never predicted (JALR still redirects from EX).\n// A prediction is suppressed when imm[1] = 1: the target would be\n// misaligned, and EX then traps without redirecting (pc_next = pc+4),\n// which matches the not-taken fetch path.\n//\n// BHT: 256 x 2-bit saturating counters indexed by pc[9:2], reset to\n// weakly-taken (2'b10). Updated from EX with the resolved branch\n// condition. Contents only affect performance, never architectural\n// state: EX compares every resolved direction against the carried\n// prediction and redirects on any mismatch.\n//\n// Latency:        prediction combinational; BHT update synchronous.\n// RVFI fields:    none (performance only).\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  // fetch-side lookup\n  input  logic [31:0] pc,\n  input  logic [31:0] instr,\n  output logic        pred_taken,\n  output logic [31:0] pred_target,\n  // EX-side update\n  input  logic        upd_en,\n  input  logic [7:0]  upd_idx,\n  input  logic        upd_taken\n);\n\n  localparam int          BHT_ENTRIES = 256;\n  localparam logic [1:0]  WEAK_TAKEN  = 2'b10;\n\n  logic [1:0] bht [0:BHT_ENTRIES-1];\n\n  // ── Predecode ──────────────────────────────────────────────────────────\n  logic        is_br;\n  logic        is_jal;\n  logic [31:0] imm;\n\n  always_comb begin\n    is_br  = (instr[6:0] == 7'b1100011);\n    is_jal = (instr[6:0] == 7'b1101111);\n    imm    = is_jal\n           ? {{11{instr[31]}}, instr[31], instr[19:12],\n              instr[20], instr[30:21], 1'b0}\n           : {{19{instr[31]}}, instr[31], instr[7],\n              instr[30:25], instr[11:8], 1'b0};\n\n    pred_target = pc + imm;\n    pred_taken  = !imm[1] && (is_jal || (is_br && bht[pc[9:2]][1]));\n  end\n\n  // ── BHT update ─────────────────────────────────────────────────────────\n  logic [1:0] upd_cur;\n  logic [1:0] upd_new;\n\n  always_comb begin\n    upd_cur = bht[upd_idx];\n    if (upd_taken)\n      upd_new = (upd_cur == 2'b11) ? 2'b11 : upd_cur + 2'b01;\n    else\n      upd_new = (upd_cur == 2'b00) ? 2'b00 : upd_cur - 2'b01;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < BHT_ENTRIES; i++) bht[i] <= WEAK_TAKEN;\n    end else if (upd_en) begin\n      bht[upd_idx] <= upd_new;\n    end\n  end\n\nendmodule\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3079,"cache_read_input_tokens":57176,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3079},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d9bb7652-2e74-41e3-a4f7-66b9970660e8","uuid":"1e9308c1-e54b-4c59-9a92-9fecc8cc48b5","timestamp":"2026-09-29T18:09:58.076Z","request_id":"req_011CfYBNHhaKCJNMJ82GYZB7"}
