  id_ex_t reg_q;\n\n  // The IF/ID word is raw imem data even when invalid (imem stall / kill),\n  // so an invalid fetch is captured as a full bubble: its decoded ctrl\n  // (mem_write, reg_write, ...) must never reach EX/MEM.\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (!stall && !in.valid) begin\n      reg_q <= '0;\n    end else if (!stall) begin\n      reg_q.pred_taken <= in.pred_taken;\n      reg_q.pred_ctr   <= in.pred_ctr;\n      reg_q.pc       <= in.pc;\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.ctrl     <= ctrl_decoded;\n      reg_q.instr    <= in.instr;\n      reg_q.valid    <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "structuredPatch": [{"oldStart": 112, "oldLines": 7, "newStart": 112, "newLines": 7, "lines": ["       reg_q.rs2_addr <= in.instr[24:20];", "       reg_q.ctrl     <= ctrl_decoded;", "       reg_q.instr    <= in.instr;", "-      reg_q.valid    <= in.valid;", "+      reg_q.valid    <= 1'b1;", "     end", "   end", " "]}], "userModified": false, "replaceAll": false, "contentNotInModelContext": true}}
