iff a < 0 -> r = a.\n//   INT_MIN / -1   : |a| = 0x80000000, |b| = 1 -> q = 0x80000000, r = 0;\n//                    a[31]^b[31] = 0 so no negation.\n//\n// Under RISCV_FORMAL_ALTOPS the result is the riscv-formal substitute\n// (a - b) ^ const from the latched operands, IDLE --req--> FIX --> DONE,\n// so the start/stall/latch/complete handshake is still covered inside\n// the BMC depth.\n//\n// Latency:        36 cycles from req to EX/MEM capture (3 under ALTOPS).\n// RVFI fields:    rd_wdata of divides (via EX/MEM alu_result); a_q/b_q\n//                 feed rs1_rdata/rs2_rdata of divides.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        req,\n  input  logic        ack,\n  input  logic        is_signed,   // DIV / REM\n  input  logic        want_rem,    // REM / REMU\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        done,\n  output logic [31:0] result,\n  output logic [31:0] a_q,\n  output logic [31:0] b_q\n);\n\n  localparam logic [2:0] S_IDLE = 3'd0;\n  localparam logic [2:0] S_ABS  = 3'd1;\n  localparam logic [2:0] S_RUN  = 3'd2;\n  localparam logic [2:0] S_FIX  = 3'd3;\n  localparam logic [2:0] S_DONE = 3'd4;\n\n  logic [2:0]  state;\n  logic        done_q;\n  logic        signed_q;\n  logic        rem_q;\n  logic [31:0] result_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state  <= S_IDLE;\n      done_q <= 1'b0;\n    end else begin\n      case (state)\n        S_IDLE: if (req) begin\n          a_q      <= a;\n          b_q      <= b;\n          signed_q <= is_signed;\n          rem_q    <= want_rem;\n          state    <= S_FIX;\n        end\n        S_FIX: begin\n          case ({signed_q, rem_q})\n            2'b10:   result_q <= (a_q - b_q) ^ 32'h7f8529ec;  // DIV\n            2'b00:   result_q <= (a_q - b_q) ^ 32'h10e8fd70;  // DIVU\n            2'b11:   result_q <= (a_q - b_q) ^ 32'h8da68fa5;  // REM\n            default: result_q <= (a_q - b_q) ^ 32'h3138d0e1;  // REMU\n          endcase\n          done_q <= 1'b1;\n          state  <= S_DONE;\n        end\n        S_DONE: if (ack) begin\n          done_q <= 1'b0;\n          state  <= S_IDLE;\n        end\n        default: state <= S_IDLE;\n      endcase\n    end\n  end\n`else\n  logic [31:0] rem;    // partial remainder\n  logic [31:0] quo;    // dividend bits shift out, quotient bits shift in\n  logic [31:0] dvs;    // divisor magnitude\n  logic [4:0]  cnt;\n  logic        neg_q;  // negate quotient\n  logic        neg_r;  // negate remainder\n  logic [33:0] trial;  // {0, rem, next dividend bit} - divisor; [33] = borrow\n  logic [31:0] sel;\n  logic        neg;\n\n  always_comb begin\n    trial = {1'b0, rem, quo[31]} - {2'b0, dvs};\n    sel   = rem_q ? rem   : quo;\n    neg   = rem_q ? neg_r : neg_q;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state  <= S_IDLE;\n      done_q <= 1'b0;\n    end else begin\n      case (state)\n        S_IDLE: if (req) begin\n          a_q      <= a;\n          b_q      <= b;\n          signed_q <= is_signed;\n          rem_q    <= want_rem;\n          state    <= S_ABS;\n        end\n        S_ABS: begin\n          quo   <= (signed_q && a_q[31]) ? (32'd0 - a_q) : a_q;\n          dvs   <= (signed_q && b_q[31]) ? (32'd0 - b_q) : b_q;\n          rem   <= 32'd0;\n          cnt   <= 5'd0;\n          neg_q <= signed_q && (a_q[31] ^ b_q[31]) && (b_q != 32'd0);\n          neg_r <= signed_q && a_q[31];\n          state <= S_RUN;\n        end\n        S_RUN: begin\n          if (!trial[33]) begin\n            rem <= trial[31:0];\n            quo <= {quo[30:0], 1'b1};\n          end else begin\n            rem <= {rem[30:0], quo[31]};\n            quo <= {quo[30:0], 1'b0};\n          end\n          cnt <= cnt + 5'd1;\n          if (cnt == 5'd31) state <= S_FIX;\n        end\n        S_FIX: begin\n          result_q <= neg ? (32'd0 - sel) : sel;\n          done_q   <= 1'b1;\n          state    <= S_DONE;\n        end\n        S_DONE: if (ack) begin\n          done_q <= 1'b0;\n          state  <= S_IDLE;\n        end\n        default: state <= S_IDLE;\n      endcase\n    end\n  end\n`endif\n\n  assign done   = done_q;\n  assign result = result_q;\n\nendmodule\n", "structuredPatch": [{"oldStart": 95, "oldLines": 7, "newStart": 95, "newLines": 11, "lines": ["   logic [4:0]  cnt;", "   logic        neg_q;  // negate quotient", "   logic        neg_r;  // negate remainder", "-  logic [33:0] trial;  // {0, rem, next dividend bit} - divisor; [33] = borrow", "+  // {0, rem, next dividend bit} - divisor; [33] = borrow. On no-borrow", "+  // the difference is < divisor, so bit 32 is always 0 and unused.", "+  /* verilator lint_off UNUSEDSIGNAL */", "+  logic [33:0] trial;", "+  /* verilator lint_on UNUSEDSIGNAL */", "   logic [31:0] sel;", "   logic        neg;", " "]}], "userModified": false, "replaceAll": false}}
