"      reg_q <= reg_q;\n    end else begin\"\"\",\"\"\"      reg_q <= reg_q;\n    end else if (mdu_stall) begin\n      // M-op still executing: bubble into EX/MEM (valid=0, no reg/mem\n      // write) so older instructions drain through MEM/WB.\n      reg_q <= '0;\n    end else begin\"\"\")\ns=s.replace(\"\"\"      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\"\"\",\"\"\"      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4)\n                            : in.ctrl.is_mdu  ? mdu_result\n                                              : alu_result;\n      reg_q.write_data    <= rs2_ret;\"\"\")\ns=s.replace(\"\"\"      reg_q.rs1_val       <= rs1;\n      reg_q.rs2_val       <= rs2;\"\"\",\"\"\"      reg_q.rs1_val       <= rs1_ret;\n      reg_q.rs2_val       <= rs2_ret;\"\"\")\nopen(p,'w').write(s)\n\np='rtl/hazard_unit.sv'\ns=open(p).read()\ns=s.replace(\"\"\"  input  logic       ex_mem_mem_op,\n\"\"\",\"\"\"  input  logic       ex_mem_mem_op,\n  // M-op in ID/EX still executing in the multi-cycle MDU (registered\n  // state only). Holds PC + ID/EX; ex_stage inserts the EX/MEM bubble.\n  input  logic       mdu_stall,\n\"\"\")\ns=s.replace(\"\"\"    stall_if      = load_use_hazard || imem_stall || dmem_stall;\"\"\",\"\"\"    stall_if      = load_use_hazard || imem_stall || dmem_stall || mdu_stall;\"\"\")\ns=s.replace(\"\"\"    stall_id      = dmem_stall || load_use_hazard;\"\"\",\"\"\"    //   - mdu_stall   -> hold        (M-op waits in ID/EX; an M-op is\n    //                                 never a load or a branch/jump, so\n    //                                 load_use/redirect can't coincide)\n    stall_id      = dmem_stall || load_use_hazard || mdu_stall;\"\"\")\nopen(p,'w').write(s)\n\np='rtl/core.sv'\ns=open(p).read()\ns=s.replace(\"\"\"  logic       stall_ex_mem, hold_mem_wb;\"\"\",\"\"\"  logic       stall_ex_mem, hold_mem_wb;\n  logic       mdu_stall;\"\"\")\ns=s.replace(\"\"\"    .redirect_ta