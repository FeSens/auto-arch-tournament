{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'git diff -- cores/bench/rtl/core_pkg.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/mem_stage.sv'","aggregated_output":"diff --git a/cores/bench/rtl/core_pkg.sv b/cores/bench/rtl/core_pkg.sv\nindex d96c54c..b760be7 100644\n--- a/cores/bench/rtl/core_pkg.sv\n+++ b/cores/bench/rtl/core_pkg.sv\n@@ -96,6 +96,7 @@\n   typedef struct packed {\n     logic [31:0] pc;\n     logic [31:0] alu_result;\n+    logic [31:0] mem_addr;       // dedicated LOAD/STORE effective address\n     logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication\n     logic [4:0]  rd;\n     logic [4:0]  rs1_addr;\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex 40da086..a853dc9 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_stage.sv\n@@ -164,6 +164,9 @@ module ex_stage (\n       // sum (which is the jump target). The MEM/WB register's read-data\n       // mux only kicks in for LOADs, so we route PC+4 here.\n       reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n+      // LOAD/STORE addresses need only addition. Keep this path separate\n+      // from the ALU result mux so a multiply cannot time the dmem port.\n+      reg_q.mem_addr      <= rs1 + in.imm;\n       reg_q.write_data    <= is_div ? div_rs2_q : rs2;\n       reg_q.rd            <= in.rd;\n       reg_q.rs1_addr      <= in.rs1_addr;\ndiff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex eb40d73..0b42049 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -74,15 +74,15 @@ module mem_stage (\n \n     // Byte-lane mask shifted to addr[1:0] * 1.\n     case (in.ctrl.mem_width)\n-      2'd0:    byte_mask = (4'b0001 << in.alu_result[1:0]);\n-      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\n+      2'd0:    byte_mask = (4'b0001 << in.mem_addr[1:0]);\n+      2'd1:    byte_mask = (4'b0011 << in.mem_addr[1:0]);\n       default: byte_mask = 4'b1111;\n     endcase\n \n     mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;\n     mem_misalign = mem_op && (\n-                     (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n-                     (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\n+                     (in.ctrl.mem_width == 2'd2 && in.mem_addr[1:0] != 2'b00) ||\n+                     (in.ctrl.mem_width == 2'd1 && in.mem_addr[0]   != 1'b0)\n                      // 2'd0 (byte) is never misaligned.\n                    );\n \n@@ -93,13 +93,13 @@ module mem_stage (\n     end\n \n     // Combinational dmem outputs — gated off on misalign.\n-    dmem_addr  = in.alu_result;\n+    dmem_addr  = in.mem_addr;\n     dmem_wdata = wdata_rep;\n     dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n     dmem_ren   = in.ctrl.mem_read  && !mem_misalign;\n \n     // Load extraction: shift right then sign/zero-extend the low N bits.\n-    shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\n+    shifted   = dmem_rdata >> (in.mem_addr[1:0] * 8);\n     byte_val  = shifted[7:0];\n     hword_val = shifted[15:0];\n     case (in.ctrl.mem_width)\n@@ -114,7 +114,7 @@ module mem_stage (\n \n     // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n     aligned_addr = (mem_op && !mem_misalign)\n-                 ? {in.alu_result[31:2], 2'b00}\n+                 ? {in.mem_addr[31:2], 2'b00}\n                  : 32'b0;\n   end\n \n","exit_code":0,"status":"completed"}}
