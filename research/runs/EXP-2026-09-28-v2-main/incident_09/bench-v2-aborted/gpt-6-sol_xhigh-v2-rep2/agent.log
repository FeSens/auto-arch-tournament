{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'rg -n \"RTL_DIR|CORE_NAME|wrapper|checks.cfg|checks_si|cfg\" formal/run_all.sh'","aggregated_output":"2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n5:# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n10:# Usage: bash formal/run_all.sh [checks-cfg-path]\n11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n12:#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n15:#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n16:#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n18:# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n19:# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n21:# right wrapper without needing to know the env-var plumbing.\n24:if [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n25:  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n26:  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n35:# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n41:# basename (genchecks.py:39), so @core@ = \"$CORE_NAME-<suffix>\".\n48:    CORE_DIR=\"$RISCV_FORMAL/cores/$CORE_NAME-$FORMAL_WORK_ID\"\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n79:# are both unset and $1 (checks-cfg-path) wasn't given either. Explicit\n83:CORE_YAML=\"$PROJECT_ROOT/cores/$CORE_NAME/core.yaml\"\n97:        WRAPPER=\"$SCRIPT_DIR/wrapper_si.sv\"\n98:        CHECKS_CFG=\"$SCRIPT_DIR/checks_si.cfg\"\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n103:CHECKS_CFG=\"${CHECKS_CFG:-${1:-$SCRIPT_DIR/checks.cfg}}\"\n104:WRAPPER=\"${WRAPPER:-$SCRIPT_DIR/wrapper.sv}\"\n106:    echo \"ERROR: checks.cfg not found at $CHECKS_CFG\"\n110:    echo \"ERROR: wrapper not found at $WRAPPER\"\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n150:# Stage rtl + wrapper + the chosen checks config under the framework's\n151:# expected layout. genchecks.py looks for \"checks.cfg\" by name, so the\n160:cp \"$PROJECT_ROOT/$RTL_DIR\"/*.sv \"$CORE_DIR/\"\n161:cp \"$WRAPPER\"                   \"$CORE_DIR/wrapper.sv\"\n163:# Stage checks.cfg with [verilog-files] auto-derived from actual rtl/\n164:# contents instead of the cfg's hardcoded list. The shipped checks.cfg\n169:# and rebuild from the glob, with core_pkg.sv first and wrapper.sv last.\n170:STAGED_CFG=\"$CORE_DIR/checks.cfg\"\n179:        [ \"$name\" = \"wrapper.sv\" ] && continue\n182:    echo \"@basedir@/cores/@core@/wrapper.sv\"\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n187:# yields @core@=\"$CORE_NAME-<suffix>\". The [verilog-files] lines we just\n","exit_code":0,"status":"completed"}}
