{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"sed -n '1,140p' cores/bench/rtl/divider.sv\"","aggregated_output":"// Shared RV32M divider. One radix-4 restoring digit is produced per cycle.\n// A completed result remains available until EX accepts it.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        consume,\n  input  logic        signed_mode,\n  input  logic        remainder_mode,\n  input  logic [31:0] dividend,\n  input  logic [31:0] divisor,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n  logic [31:0] numerator_q;\n  logic [31:0] denominator_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] quotient_q; // upper two bits shift out as radix-4 digits arrive\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] remainder_q;\n  logic [4:0]  steps_q;\n  logic        quotient_negative_q;\n  logic        remainder_negative_q;\n  logic        remainder_mode_q;\n  logic        divide_zero_q;\n  logic        overflow_q;\n  logic [31:0] original_dividend_q;\n\n  logic [33:0] trial;\n  logic [33:0] d1, d2, d3;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [33:0] next_remainder; // high bits are zero after nonzero division\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [1:0]  digit;\n  logic [31:0] next_quotient;\n  logic [31:0] unsigned_result;\n  logic [31:0] signed_result;\n\n  always_comb begin\n    trial = {remainder_q, numerator_q[31:30]};\n    d1 = {2'b00, denominator_q};\n    d2 = d1 << 1;\n    d3 = d2 + d1;\n    if (trial >= d3) begin\n      digit = 2'd3;\n      next_remainder = trial - d3;\n    end else if (trial >= d2) begin\n      digit = 2'd2;\n      next_remainder = trial - d2;\n    end else if (trial >= d1) begin\n      digit = 2'd1;\n      next_remainder = trial - d1;\n    end else begin\n      digit = 2'd0;\n      next_remainder = trial;\n    end\n    next_quotient = {quotient_q[29:0], digit};\n    unsigned_result = remainder_mode_q ? next_remainder[31:0] : next_quotient;\n    signed_result = (remainder_mode_q ? remainder_negative_q : quotient_negative_q)\n                  ? -unsigned_result : unsigned_result;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      busy <= 1'b0;\n      done <= 1'b0;\n      result <= 32'b0;\n      numerator_q <= 32'b0;\n      denominator_q <= 32'b0;\n      quotient_q <= 32'b0;\n      remainder_q <= 32'b0;\n      steps_q <= 5'b0;\n      quotient_negative_q <= 1'b0;\n      remainder_negative_q <= 1'b0;\n      remainder_mode_q <= 1'b0;\n      divide_zero_q <= 1'b0;\n      overflow_q <= 1'b0;\n      original_dividend_q <= 32'b0;\n    end else if (start) begin\n      busy <= 1'b1;\n      done <= 1'b0;\n      numerator_q <= (signed_mode && dividend[31]) ? -dividend : dividend;\n      denominator_q <= (signed_mode && divisor[31]) ? -divisor : divisor;\n      quotient_q <= 32'b0;\n      remainder_q <= 32'b0;\n      steps_q <= 5'd16;\n      quotient_negative_q <= signed_mode && (dividend[31] ^ divisor[31]);\n      remainder_negative_q <= signed_mode && dividend[31];\n      remainder_mode_q <= remainder_mode;\n      divide_zero_q <= divisor == 32'b0;\n      overflow_q <= signed_mode && dividend == 32'h80000000\n                    && divisor == 32'hffffffff;\n      original_dividend_q <= dividend;\n    end else if (busy) begin\n      numerator_q <= {numerator_q[29:0], 2'b0};\n      quotient_q <= next_quotient;\n      remainder_q <= next_remainder[31:0];\n      steps_q <= steps_q - 5'd1;\n      if (steps_q == 5'd1) begin\n        busy <= 1'b0;\n        done <= 1'b1;\n        if (divide_zero_q)\n          result <= remainder_mode_q ? original_dividend_q : 32'hffffffff;\n        else if (overflow_q)\n          result <= remainder_mode_q ? 32'b0 : 32'h80000000;\n        else\n          result <= signed_result;\n      end\n    end else if (consume) begin\n      done <= 1'b0;\n    end\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
