id only;\n                                         // data fields stay (for fwd)\n@@ -55,10 +55,9 @@ module hazard_unit (\n \n     // PC reg holds on any stall reason.\n     stall_if      = load_use_hazard || imem_stall || dmem_stall || divide_wait;\n-    // IF/ID combinational payload: NOP whenever we wouldn't have a valid\n-    // instruction this c\n…[2273 of 5345 chars elided by tools/bench/transcript.py; sha256:6f84af22ea772ceb]…\n5,9 @@\n // flop in this microarchitecture, the next-stage's ID/EX register\n // captures everything one cycle later.\n //\n-// On flush or redirect, the instruction emitted to ID is forced to NOP\n-// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n-// observing a real rs1/rs2 from a wrong-path instruction and inserting\n-// a spurious load-use stall the cycle after a taken branch.\n+// On an imem stall, the instruction emitted to ID is forced to NOP\n+// (`0x00000013` = ADDI x0,x0,0). A redirect kills the wrong-path\n+// instruction in ID/EX while updating this stage's PC.\n //\n // Latency:        PC-reg update is synchronous; output is combinational.\n // RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n@@ -50,8 +49,8 @@ module if_stage (\n \n   always_comb begin\n     out.pc    = pc;\n-    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n-    out.valid = !(flush || redirect);\n+    out.instr = flush ? 32'h0000_0013 : imem_data;\n+    out.valid = !flush;\n   end\n \n endmodule\n", "exit_code": 0, "status": "completed"}}
